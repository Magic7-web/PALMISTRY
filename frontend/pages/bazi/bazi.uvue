<template>
	<view class="bazi-container">
		<view class="bg-decoration">
			<view class="bg-bagua"></view>
		</view>

		<view class="bazi-content-wrapper">
			<view class="bazi-header">
				<view class="header-main">
					<text class="header-title">{{ titleText }}</text>
					<image class="header-stamp" src="/static/favicon.png" mode="aspectFit"></image>
				</view>
				<view class="header-deco"></view>
				<text class="header-subtitle">{{ subtitleText }}</text>
			</view>

			<view class="placeholder-card">
				<view class="placeholder-icon-wrap">
					<image class="placeholder-icon" src="/static/命格.png" mode="aspectFit"></image>
				</view>
				<text class="placeholder-title">{{ locale === 'en' ? 'BaZi Chart' : '八字排盘' }}</text>
				<text class="placeholder-desc">{{ locale === 'en' ? 'Coming soon. We are building a full BaZi chart experience for you.' : '功能开发中，敬请期待。我们将为您带来完整的八字排盘体验。' }}</text>
			</view>
		</view>

	</view>
</template>

<script lang="uts">
	import { getAppLocale, type AppLocale } from '@/utils/locale';

	export default {
		name: 'BaziPage',
		data() {
			return {
				locale: getAppLocale() as AppLocale
			};
		},
		computed: {
			titleText(): string {
				return this.locale === 'en' ? 'BaZi Chart - Lin Reading' : '八字排盘 - 林公测算';
			},
			subtitleText(): string {
				return this.locale === 'en'
					? 'Decode destiny through the Four Pillars of Destiny'
					: '以传统四柱八字，推演命格乾坤';
			}
		},
		onShow() {
			const saved = getAppLocale();
			if (this.locale !== saved) {
				this.locale = saved;
			}
			uni.setNavigationBarTitle({ title: this.titleText });
		}
	};
</script>

