<template>
	<view class="face-container">
		<view class="bg-decoration">
			<view class="bg-bagua"></view>
		</view>

		<view class="face-content-wrapper">
			<!-- 拍照入口 -->
			<template v-if="reportData == null && !isAnalyzing && capturedImage == null">
				<view class="face-header">
					<view class="header-main">
						<text class="header-title">{{ ui.headerTitle }}</text>
						<image class="header-stamp" src="/static/favicon.png" mode="aspectFit"></image>
					</view>
					<view class="header-deco"></view>
					<text class="header-subtitle">{{ ui.headerSubtitle }}</text>
				</view>

				<view class="face-content capture-mode">
					<view class="guide-area">
						<text class="guide-heading">{{ ui.guideText }}</text>
						<view class="guide-box">
							<view class="face-outline">
								<view class="face-outline-inner"></view>
								<view class="face-outline-cross-h"></view>
								<view class="face-outline-cross-v"></view>
							</view>
						</view>
						<view class="guide-tips">
							<text class="guide-tip-item">{{ ui.guideTip1 }}</text>
							<text class="guide-tip-item">{{ ui.guideTip2 }}</text>
							<text class="guide-tip-item">{{ ui.guideTip3 }}</text>
						</view>
					</view>
				</view>

				<view class="face-footer">
					<button class="face-btn btn-primary" @click="handleTakePhoto">
						<text class="btn-text">{{ ui.footerPhoto }}</text>
					</button>
					<button class="face-btn btn-secondary" @click="handleChooseFromAlbum">
						<text class="btn-text">{{ ui.footerAlbum }}</text>
					</button>
				</view>
			</template>

			<!-- 照片预览 -->
			<template v-else-if="reportData == null && !isAnalyzing && capturedImage != null">
				<view class="face-header">
					<view class="header-main">
						<text class="header-title">{{ ui.headerTitle }}</text>
						<image class="header-stamp" src="/static/favicon.png" mode="aspectFit"></image>
					</view>
					<view class="header-deco"></view>
					<text class="header-subtitle">{{ ui.previewTitle }}</text>
				</view>

				<view class="face-content preview-mode">
					<view class="preview-area">
						<text class="preview-hint">{{ ui.previewHint }}</text>
						<text class="preview-adjust-hint">{{ ui.previewAdjustHint }}</text>
						<view class="preview-frame-wrap">
							<view
								class="preview-container"
								@touchstart.prevent="handleTouchStart"
								@touchmove.prevent="handleTouchMove"
								@touchend.prevent="handleTouchEnd"
								@mousedown="handleMouseDown"
								@mousemove="handleMouseMove"
								@mouseup="handleMouseUp"
								@mouseleave="handleMouseUp"
							>
								<view
									class="image-wrapper"
									:style="{
										transform: `translate(${imageOffsetX}rpx, ${imageOffsetY}rpx) scale(${imageScale})`,
										transition: isMoving || isScaling ? 'none' : 'transform 0.1s ease-out'
									}"
								>
									<image class="preview-image" :src="capturedImage" mode="aspectFit"></image>
								</view>
								<view class="preview-vignette"></view>
								<view class="preview-face-overlay">
									<view class="preview-face-border"></view>
									<view class="preview-corner preview-corner-tl"></view>
									<view class="preview-corner preview-corner-tr"></view>
									<view class="preview-corner preview-corner-bl"></view>
									<view class="preview-corner preview-corner-br"></view>
								</view>
								<view class="scale-controls" @touchstart.stop @mousedown.stop>
									<button class="scale-btn" @click.stop="zoomIn">
										<text class="scale-icon">+</text>
									</button>
									<button class="scale-btn" @click.stop="zoomOut">
										<text class="scale-icon">−</text>
									</button>
									<button class="scale-btn reset-btn" @click.stop="resetTransform">
										<text class="scale-icon">↺</text>
									</button>
								</view>
							</view>
						</view>
						<view class="preview-tips">
							<text class="guide-tip-item">{{ ui.guideTip1 }}</text>
							<text class="guide-tip-item">{{ ui.guideTip2 }}</text>
							<text class="guide-tip-item">{{ ui.guideTip3 }}</text>
						</view>
					</view>
				</view>

				<view class="face-footer">
					<button class="face-btn btn-primary" @click="handleConfirm">
						<text class="btn-text">{{ ui.previewConfirm }}</text>
					</button>
					<button class="face-btn btn-secondary" @click="handleCancel">
						<text class="btn-text">{{ ui.previewRetake }}</text>
					</button>
				</view>
			</template>

			<!-- 分析中 -->
			<template v-else-if="reportData == null && isAnalyzing">
				<view class="face-header analyzing-header">
					<view class="header-main">
						<text class="header-title">{{ ui.headerTitle }}</text>
						<image class="header-stamp" src="/static/favicon.png" mode="aspectFit"></image>
					</view>
					<view class="header-deco"></view>
				</view>

				<view class="face-content analyzing-mode">
					<view class="analyzing-area">
						<view class="scan-frame-wrap">
							<view class="scan-animation-container portrait">
								<image
									v-if="capturedImage != null"
									class="scan-preview-image"
									:src="capturedImage"
									mode="aspectFit"
								></image>
								<view class="preview-vignette"></view>
								<view class="scan-glow"></view>
								<view class="scan-line"></view>
								<view class="preview-face-overlay">
									<view class="preview-face-border scan-pulse"></view>
								</view>
							</view>
						</view>

						<view class="analyze-status-card">
							<text class="analyze-status-title">{{ ui.analyzingMain }}</text>
							<view class="analyze-progress-head">
								<text class="analyze-progress-value">{{ analyzeProgress }}%</text>
								<view class="analyze-progress-track">
									<view class="analyze-progress-fill" :style="{ width: analyzeProgress + '%' }"></view>
								</view>
							</view>
							<view class="analyze-steps">
								<view
									class="analyze-step"
									v-for="(step, index) in analyzeStepItems"
									:key="step.key"
									:class="{ active: analyzeStep > index, current: analyzeStep === index }"
								>
									<view class="analyze-step-dot"></view>
									<text class="analyze-step-label">{{ step.label }}</text>
								</view>
							</view>
							<text class="analyzing-status">{{ analyzingStatus }}</text>
							<text class="analyzing-patience-hint">{{ ui.analyzingPatienceHint }}</text>
						</view>

						<view class="scan-dimension-panel">
							<view class="scan-dimension-header">
								<text class="scan-dimension-title">{{ ui.analyzeDimensionTitle }}</text>
								<text class="scan-dimension-current">{{ dynamicScanText }}</text>
							</view>
							<view class="scan-dimension-grid">
								<view
									class="scan-dimension-item"
									v-for="(item, index) in scanTermList"
									:key="index"
									:class="item.status"
								>
									<view class="scan-dimension-mark">
										<text v-if="item.status === 'done'" class="mark-done">✓</text>
										<view v-else-if="item.status === 'active'" class="mark-spinner"></view>
										<text v-else class="mark-pending">·</text>
									</view>
									<text class="scan-dimension-label">{{ item.term }}</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</template>

			<!-- 报告 -->
			<view class="face-content report-mode" v-else-if="reportData != null">
				<view class="result-area">
					<scroll-view class="result-scroll" scroll-y="true">
						<view class="result-card">
							<view class="result-header">
								<view class="result-header-top-row">
									<view class="result-header-text-block">
										<text class="result-title">{{ ui.resultTitle }}</text>
										<text class="result-time">{{ reportData.analyzeTime }}</text>
									</view>
									<view class="result-lang-inline">
										<button class="result-lang-btn" :class="{ active: locale === 'zh' }" @click="setLocale('zh')">中文</button>
										<button class="result-lang-btn" :class="{ active: locale === 'en' }" @click="setLocale('en')">EN</button>
									</view>
								</view>
							</view>

							<view class="face-visual-section">
								<image class="face-photo" :src="reportData.imagePath" mode="aspectFit"></image>
							</view>

							<view v-if="reportData.fullData">
								<!-- 模块一：基础档案 -->
								<view class="summary-section">
									<view class="section-header">
										<text class="section-title">{{ ui.chapterArchive }}</text>
									</view>
									<view class="archive-card">
										<view class="archive-row">
											<text class="archive-label">{{ ui.labelConfidence }}</text>
											<text class="archive-value">{{ reportData.fullData.archive.confidence }}%</text>
										</view>
										<view class="archive-row">
											<text class="archive-label">{{ ui.labelFaceElement }}</text>
											<text class="archive-value">{{ pickTxt(reportData.fullData.archive.faceElement, reportData.fullData.archive.faceElementEn) }}</text>
										</view>
										<view class="archive-row">
											<text class="archive-label">{{ ui.labelSpiritScore }}</text>
											<text class="archive-value">{{ reportData.fullData.archive.spiritScore }} {{ ui.scoreUnit }}</text>
										</view>
										<view class="archive-block">
											<text class="archive-label">{{ ui.labelComplexion }}</text>
											<text class="archive-text">{{ pickTxt(reportData.fullData.archive.complexionOverview, reportData.fullData.archive.complexionOverviewEn) }}</text>
										</view>
										<view class="archive-block muted">
											<text class="archive-text small">{{ pickTxt(reportData.fullData.archive.classics, reportData.fullData.archive.classicsEn) }}</text>
											<text class="archive-text small">{{ pickTxt(reportData.fullData.archive.disclaimer, reportData.fullData.archive.disclaimerEn) }}</text>
										</view>
									</view>
								</view>

								<!-- 模块二：三停流年 -->
								<view class="features-section">
									<view class="section-header">
										<text class="section-title">{{ ui.chapterThreeSections }}</text>
									</view>
									<view class="three-section-card" v-for="item in threeSectionItems" :key="item.key">
										<view class="three-section-head">
											<text class="three-section-name">{{ pickTxt(item.section.name, item.section.nameEn) }}</text>
											<text class="three-section-age">{{ pickTxt(item.section.ageRange, item.section.ageRangeEn) }}</text>
											<text class="three-section-score">{{ item.section.score }}{{ ui.scoreUnit }}</text>
										</view>
										<text class="three-section-summary">{{ pickTxt(item.section.summary, item.section.summaryEn) }}</text>
										<text class="three-section-details">{{ pickTxt(item.section.details, item.section.detailsEn) }}</text>
									</view>
									<view class="balance-card">
										<text class="balance-label">{{ ui.labelBalance }}：{{ reportData.fullData.threeSections.balanceScore }}{{ ui.scoreUnit }}</text>
										<text class="balance-text">{{ pickTxt(reportData.fullData.threeSections.imbalanceNote, reportData.fullData.threeSections.imbalanceNoteEn) }}</text>
									</view>
								</view>

								<!-- 模块三：五官深度 -->
								<view class="dimensions-section">
									<view class="section-header">
										<text class="section-title">{{ ui.chapterFiveOfficials }}</text>
									</view>
									<view class="official-card" v-for="(official, index) in reportData.fullData.fiveOfficials" :key="index">
										<text class="official-name">{{ pickTxt(official.name, official.nameEn) }}</text>
										<view class="official-row">
											<text class="official-label">{{ ui.labelAppearance }}</text>
											<text class="official-text">{{ pickTxt(official.appearance, official.appearanceEn) }}</text>
										</view>
										<view class="official-row">
											<text class="official-label">{{ ui.labelCharacter }}</text>
											<text class="official-text">{{ pickTxt(official.character, official.characterEn) }}</text>
										</view>
										<view class="official-row">
											<text class="official-label">{{ ui.labelInfluence }}</text>
											<text class="official-text">{{ pickTxt(official.influence, official.influenceEn) }}</text>
										</view>
									</view>
								</view>

								<!-- 模块四：十二宫重点 -->
								<view class="features-section">
									<view class="section-header">
										<text class="section-title">{{ ui.chapterKeyPalaces }}</text>
									</view>
									<view class="palace-card" v-for="(palace, index) in reportData.fullData.keyPalaces" :key="index">
										<view class="palace-head">
											<text class="palace-name">{{ pickTxt(palace.name, palace.nameEn) }}</text>
											<text class="palace-fortune">{{ pickTxt(palace.fortuneLevel, palace.fortuneLevelEn) }}</text>
										</view>
										<view class="palace-row">
											<text class="palace-label">{{ ui.labelLocation }}</text>
											<text class="palace-text">{{ pickTxt(palace.location, palace.locationEn) }}</text>
										</view>
										<view class="palace-row">
											<text class="palace-label">{{ ui.labelFeature }}</text>
											<text class="palace-text">{{ pickTxt(palace.feature, palace.featureEn) }}</text>
										</view>
										<view class="palace-row">
											<text class="palace-label">{{ ui.labelTrend }}</text>
											<text class="palace-text">{{ pickTxt(palace.trend, palace.trendEn) }}</text>
										</view>
										<view class="palace-row">
											<text class="palace-label">{{ ui.labelAdvice }}</text>
											<text class="palace-text">{{ pickTxt(palace.advice, palace.adviceEn) }}</text>
										</view>
									</view>
								</view>

								<!-- 模块五：核心运势 -->
								<view class="summary-section">
									<view class="section-header">
										<text class="section-title">{{ ui.chapterCoreFortunes }}</text>
									</view>
									<view class="fortune-card" v-for="item in coreFortuneItems" :key="item.key">
										<view class="fortune-head">
											<text class="fortune-label">{{ pickTxt(item.fortune.label, item.fortune.labelEn) }}</text>
											<text class="fortune-stars">{{ formatStars(item.fortune.stars) }}</text>
										</view>
										<text class="fortune-trend">{{ pickTxt(item.fortune.trend, item.fortune.trendEn) }}</text>
										<text class="fortune-summary">{{ pickTxt(item.fortune.summary, item.fortune.summaryEn) }}</text>
									</view>
								</view>

								<!-- 模块六：趋吉指南 -->
								<view class="suggestions-section">
									<view class="section-header">
										<text class="section-title">{{ ui.chapterImprovement }}</text>
									</view>
									<view class="suggestions-card">
										<view class="suggestion-group">
											<view class="suggestion-header">
												<text class="suggestion-dot career-dot"></text>
												<text class="suggestion-type">{{ ui.labelAppearanceTips }}</text>
											</view>
											<text class="suggestion-text">{{ pickTxt(reportData.fullData.improvement.appearanceTips, reportData.fullData.improvement.appearanceTipsEn) }}</text>
										</view>
										<view class="suggestion-group">
											<view class="suggestion-header">
												<text class="suggestion-dot life-dot"></text>
												<text class="suggestion-type">{{ ui.labelBehaviorTips }}</text>
											</view>
											<text class="suggestion-text">{{ pickTxt(reportData.fullData.improvement.behaviorTips, reportData.fullData.improvement.behaviorTipsEn) }}</text>
										</view>
										<view class="suggestion-group">
											<view class="suggestion-header">
												<text class="suggestion-dot career-dot"></text>
												<text class="suggestion-type">{{ ui.labelLifePlanning }}</text>
											</view>
											<text class="suggestion-text">{{ pickTxt(reportData.fullData.improvement.lifePlanning, reportData.fullData.improvement.lifePlanningEn) }}</text>
										</view>
										<view class="overall-card closing-card">
											<text class="overall-title">{{ ui.labelClosingNote }}</text>
											<text class="overall-text">{{ pickTxt(reportData.fullData.improvement.closingNote, reportData.fullData.improvement.closingNoteEn) }}</text>
										</view>
									</view>
								</view>
							</view>

							<view class="result-actions">
								<button class="result-btn btn-primary" @click="handleDownloadReport">
									<text class="btn-text">{{ ui.downloadReport }}</text>
								</button>
								<button class="result-btn btn-secondary" @click="handleReset">
									<text class="btn-text">{{ ui.retakePhoto }}</text>
								</button>
							</view>
						</view>
					</scroll-view>
				</view>
			</view>
		</view>

		<view class="wechat-mask" v-if="showWechatDialog">
			<view class="wechat-dialog">
				<text class="wechat-title">{{ ui.wechatTitle }}</text>
				<image class="wechat-qrcode" src="/static/wechact.jpg" mode="widthFix"></image>
				<text class="wechat-desc">{{ ui.wechatDesc }}</text>
				<button class="wechat-close-btn" @click="showWechatDialog = false">
					<text class="btn-text">{{ ui.wechatOk }}</text>
				</button>
			</view>
		</view>

		<app-tab-bar current="face"></app-tab-bar>
	</view>
</template>

<script lang="uts">
	import AppTabBar from '@/components/app-tab-bar/app-tab-bar.uvue';
	import type { FaceReport, FaceAnalysisResult, FaceThreeSection, FaceFortuneScore } from '@/types/index';
	import { analyzeFace } from '@/utils/qwenApi';
	import { convertImageToBase64ForApi } from '@/utils/imageHelper';
	import { uploadImageToServer } from '@/utils/imageUpload';
	import { saveFaceSession, loadFaceSession, clearFaceSession } from '@/utils/faceSessionStore';
	import {
		getAppLocale,
		setAppLocale,
		getFaceUi,
		pickLocaleText,
		FACE_SCAN_TERMS_ZH,
		FACE_SCAN_TERMS_EN,
		type AppLocale
	} from '@/utils/locale';

	interface ThreeSectionDisplayItem {
		key: string;
		section: FaceThreeSection;
	}

	interface CoreFortuneDisplayItem {
		key: string;
		fortune: FaceFortuneScore;
	}

	interface AnalyzeStepItem {
		key: string;
		label: string;
	}

	interface ScanTermDisplayItem {
		term: string;
		status: 'done' | 'active' | 'pending';
	}

	interface FacePageData {
		locale: AppLocale;
		capturedImage: string | null;
		reportData: FaceReport | null;
		isAnalyzing: boolean;
		analyzeStep: number;
		scanTermIndex: number;
		scanTermPassed: boolean[];
		analyzingStatus: string;
		dynamicScanText: string;
		showWechatDialog: boolean;
		imageScale: number;
		imageOffsetX: number;
		imageOffsetY: number;
		lastTouchDistance: number;
		lastTouchX: number;
		lastTouchY: number;
		isMoving: boolean;
		isScaling: boolean;
	}

	export default {
		name: 'FacePage',
		components: {
			AppTabBar
		},
		data(): FacePageData {
			return {
				locale: getAppLocale(),
				capturedImage: null,
				reportData: null,
				isAnalyzing: false,
				analyzeStep: 0,
				scanTermIndex: 0,
				scanTermPassed: [],
				analyzingStatus: '',
				dynamicScanText: '',
				showWechatDialog: false,
				imageScale: 1.0,
				imageOffsetX: 0,
				imageOffsetY: 0,
				lastTouchDistance: 0,
				lastTouchX: 0,
				lastTouchY: 0,
				isMoving: false,
				isScaling: false
			};
		},
		computed: {
			ui(): Record<string, string> {
				return getFaceUi(this.locale);
			},
			threeSectionItems(): ThreeSectionDisplayItem[] {
				if (this.reportData == null || this.reportData.fullData == null) {
					return [];
				}
				const t = this.reportData.fullData.threeSections;
				return [
					{ key: 'upper', section: t.upper },
					{ key: 'middle', section: t.middle },
					{ key: 'lower', section: t.lower }
				];
			},
			coreFortuneItems(): CoreFortuneDisplayItem[] {
				if (this.reportData == null || this.reportData.fullData == null) {
					return [];
				}
				const f = this.reportData.fullData.coreFortunes;
				return [
					{ key: 'career', fortune: f.career },
					{ key: 'wealth', fortune: f.wealth },
					{ key: 'love', fortune: f.love }
				];
			},
			analyzeProgress(): number {
				if (this.analyzeStep === 0) {
					return 28;
				}
				if (this.analyzeStep === 1) {
					return 62;
				}
				if (this.analyzeStep === 2) {
					return 90;
				}
				return 0;
			},
			analyzeStepItems(): AnalyzeStepItem[] {
				return [
					{ key: 'extract', label: this.ui.analyzeStepExtract },
					{ key: 'fate', label: this.ui.analyzeStepFate },
					{ key: 'report', label: this.ui.analyzeStepReport }
				];
			},
			scanTermList(): ScanTermDisplayItem[] {
				const terms = this.locale === 'en' ? FACE_SCAN_TERMS_EN : FACE_SCAN_TERMS_ZH;
				const items: ScanTermDisplayItem[] = [];
				for (let i = 0; i < terms.length; i += 1) {
					let status: 'done' | 'active' | 'pending' = 'pending';
					if (i === this.scanTermIndex) {
						status = 'active';
					} else if (this.scanTermPassed[i] === true) {
						status = 'done';
					}
					items.push({ term: terms[i], status });
				}
				return items;
			}
		},
		onShow() {
			this.syncLocaleFromStorage();
			this.applyNavTitle();
			this.restoreFaceSession();
		},
		onHide() {
			this.persistFaceSession();
		},
		methods: {
			applyNavTitle(): void {
				uni.setNavigationBarTitle({ title: getFaceUi(this.locale).navTitle });
			},
			syncLocaleFromStorage(): void {
				const saved = getAppLocale();
				if (this.locale !== saved) {
					this.locale = saved;
				}
			},
			setLocale(next: AppLocale): void {
				if (this.locale === next) {
					return;
				}
				this.locale = next;
				setAppLocale(next);
				this.applyNavTitle();
			},
			pickTxt(zhText: string, enText?: string | null): string {
				return pickLocaleText(this.locale, zhText, enText);
			},
			formatStars(stars: number): string {
				const safe = Math.max(0, Math.min(5, Math.round(stars)));
				let result = '';
				for (let i = 0; i < 5; i += 1) {
					result += i < safe ? '★' : '☆';
				}
				return result;
			},
			persistFaceSession(): void {
				saveFaceSession({
					capturedImage: this.capturedImage,
					reportData: this.reportData,
					imageScale: this.imageScale,
					imageOffsetX: this.imageOffsetX,
					imageOffsetY: this.imageOffsetY
				});
			},
			restoreFaceSession(): void {
				const snapshot = loadFaceSession();
				if (snapshot == null) {
					return;
				}
				this.capturedImage = snapshot.capturedImage;
				this.reportData = snapshot.reportData;
				this.imageScale = snapshot.imageScale;
				this.imageOffsetX = snapshot.imageOffsetX;
				this.imageOffsetY = snapshot.imageOffsetY;
			},
			formatNumber(num: number): string {
				return num < 10 ? `0${num}` : `${num}`;
			},
			handleTakePhoto(): void {
				uni.chooseImage({
					count: 1,
					sizeType: ['compressed'],
					sourceType: ['camera'],
					success: (res) => {
						if (res.tempFilePaths != null && res.tempFilePaths.length > 0) {
							this.capturedImage = res.tempFilePaths[0];
							this.resetPreviewTransform();
							this.persistFaceSession();
						}
					},
					fail: () => {
						uni.showToast({ title: this.locale === 'en' ? 'Camera failed' : '拍照失败', icon: 'none' });
					}
				});
			},
			handleChooseFromAlbum(): void {
				uni.chooseImage({
					count: 1,
					sizeType: ['compressed'],
					sourceType: ['album'],
					success: (res) => {
						if (res.tempFilePaths != null && res.tempFilePaths.length > 0) {
							this.capturedImage = res.tempFilePaths[0];
							this.resetPreviewTransform();
							this.persistFaceSession();
						}
					},
					fail: () => {
						uni.showToast({ title: this.locale === 'en' ? 'Album failed' : '选择图片失败', icon: 'none' });
					}
				});
			},
			resetPreviewTransform(): void {
				this.imageScale = 1.0;
				this.imageOffsetX = 0;
				this.imageOffsetY = 0;
				this.lastTouchDistance = 0;
				this.isMoving = false;
				this.isScaling = false;
			},
			handleTouchStart(e: any): void {
				const target = e.target || e.currentTarget;
				if (target != null && target.classList != null && target.classList.contains('scale-btn')) {
					return;
				}
				e.preventDefault && e.preventDefault();
				const touches = e.touches || [];
				if (touches.length === 1) {
					this.isMoving = true;
					this.isScaling = false;
					const touch = touches[0];
					this.lastTouchX = touch.clientX || touch.x || 0;
					this.lastTouchY = touch.clientY || touch.y || 0;
				} else if (touches.length === 2) {
					this.isMoving = false;
					this.isScaling = true;
					const touch1 = touches[0];
					const touch2 = touches[1];
					const x1 = touch1.clientX || touch1.x || 0;
					const y1 = touch1.clientY || touch1.y || 0;
					const x2 = touch2.clientX || touch2.x || 0;
					const y2 = touch2.clientY || touch2.y || 0;
					this.lastTouchDistance = Math.sqrt(Math.pow(x2 - x1, 2) + Math.pow(y2 - y1, 2));
				}
			},
			handleTouchMove(e: any): void {
				e.preventDefault && e.preventDefault();
				const touches = e.touches || [];
				if (touches.length === 1 && this.isMoving) {
					const touch = touches[0];
					const currentX = touch.clientX || touch.x || 0;
					const currentY = touch.clientY || touch.y || 0;
					this.imageOffsetX += (currentX - this.lastTouchX) * 2;
					this.imageOffsetY += (currentY - this.lastTouchY) * 2;
					this.lastTouchX = currentX;
					this.lastTouchY = currentY;
				} else if (touches.length === 2) {
					this.isMoving = false;
					this.isScaling = true;
					const touch1 = touches[0];
					const touch2 = touches[1];
					const x1 = touch1.clientX || touch1.x || 0;
					const y1 = touch1.clientY || touch1.y || 0;
					const x2 = touch2.clientX || touch2.x || 0;
					const y2 = touch2.clientY || touch2.y || 0;
					const distance = Math.sqrt(Math.pow(x2 - x1, 2) + Math.pow(y2 - y1, 2));
					if (this.lastTouchDistance > 0) {
						let newScale = this.imageScale * (distance / this.lastTouchDistance);
						this.imageScale = Math.max(0.5, Math.min(3.0, newScale));
					}
					this.lastTouchDistance = distance;
				}
			},
			handleTouchEnd(e: any): void {
				e.preventDefault && e.preventDefault();
				this.isMoving = false;
				this.isScaling = false;
				this.lastTouchDistance = 0;
			},
			handleMouseDown(e: any): void {
				const target = e.target || e.currentTarget;
				if (target != null && target.classList != null && target.classList.contains('scale-btn')) {
					return;
				}
				if (e.touches != null && e.touches.length > 0) {
					return;
				}
				this.isMoving = true;
				this.isScaling = false;
				this.lastTouchX = e.clientX || e.x || 0;
				this.lastTouchY = e.clientY || e.y || 0;
			},
			handleMouseMove(e: any): void {
				if (e.touches != null && e.touches.length > 0) {
					return;
				}
				if (this.isMoving) {
					const currentX = e.clientX || e.x || 0;
					const currentY = e.clientY || e.y || 0;
					this.imageOffsetX += (currentX - this.lastTouchX) * 2;
					this.imageOffsetY += (currentY - this.lastTouchY) * 2;
					this.lastTouchX = currentX;
					this.lastTouchY = currentY;
				}
			},
			handleMouseUp(): void {
				this.isMoving = false;
				this.isScaling = false;
			},
			zoomIn(e?: any): void {
				if (e != null) {
					e.preventDefault && e.preventDefault();
					e.stopPropagation && e.stopPropagation();
				}
				this.imageScale = Math.min(3.0, this.imageScale + 0.2);
			},
			zoomOut(e?: any): void {
				if (e != null) {
					e.preventDefault && e.preventDefault();
					e.stopPropagation && e.stopPropagation();
				}
				this.imageScale = Math.max(0.5, this.imageScale - 0.2);
			},
			resetTransform(e?: any): void {
				if (e != null) {
					e.preventDefault && e.preventDefault();
					e.stopPropagation && e.stopPropagation();
				}
				this.resetPreviewTransform();
			},
			handleCancel(): void {
				this.capturedImage = null;
				this.resetPreviewTransform();
				this.persistFaceSession();
			},
			handleConfirm(): void {
				if (this.capturedImage == null) {
					uni.showToast({ title: getFaceUi(this.locale).toastNeedPhoto, icon: 'none' });
					return;
				}
				this.runAnalysis();
			},
			async prepareImageForApi(imagePath: string): Promise<string> {
				try {
					return await convertImageToBase64ForApi(imagePath);
				} catch (error) {
					console.warn('base64 转换失败，尝试上传图片:', error);
					return await uploadImageToServer(imagePath);
				}
			},
			async runAnalysis(): Promise<void> {
				if (this.capturedImage == null) {
					return;
				}

				const u = getFaceUi(this.locale);
				this.isAnalyzing = true;
				this.analyzeStep = 0;
				this.analyzingStatus = u.analyzingExtract;
				this.reportData = null;

				const scanTerms = this.locale === 'en' ? FACE_SCAN_TERMS_EN : FACE_SCAN_TERMS_ZH;
				const passedFlags: boolean[] = [];
				for (let i = 0; i < scanTerms.length; i += 1) {
					passedFlags.push(false);
				}
				passedFlags[0] = true;
				this.scanTermIndex = 0;
				this.scanTermPassed = passedFlags;
				this.dynamicScanText = scanTerms[0];
				let termIndex = 0;
				const termInterval = setInterval(() => {
					termIndex = (termIndex + 1) % scanTerms.length;
					this.scanTermIndex = termIndex;
					this.scanTermPassed[termIndex] = true;
					this.dynamicScanText = scanTerms[termIndex];
				}, 1500);

				try {
					const imageBase64 = await this.prepareImageForApi(this.capturedImage);
					this.capturedImage = imageBase64;
					this.analyzeStep = 1;
					this.analyzingStatus = getFaceUi(this.locale).analyzingFate;
					this.persistFaceSession();

					const result = await analyzeFace({
						imagePath: imageBase64,
						locale: this.locale,
						analysis_type: 'face'
					});

					if (result.isInvalid === true) {
						uni.showToast({
							title: pickLocaleText(this.locale, result.errorMsg || '请上传清晰正脸照片', result.errorMsgEn),
							icon: 'none',
							duration: 5000
						});
						return;
					}

					this.analyzeStep = 2;
					this.analyzingStatus = getFaceUi(this.locale).analyzingReport;
					await new Promise((resolve) => setTimeout(resolve, 800));
					this.generateReportFromAPI(result);

					uni.showToast({ title: getFaceUi(this.locale).toastSuccess, icon: 'success' });
				} catch (error: any) {
					console.error('面相分析失败:', error);
					uni.showToast({
						title: error.message || (this.locale === 'en' ? 'Analysis failed' : '分析失败，请重试'),
						icon: 'none',
						duration: 5000
					});
				} finally {
					this.isAnalyzing = false;
					this.analyzeStep = 0;
					this.scanTermIndex = 0;
					this.scanTermPassed = [];
					this.analyzingStatus = '';
					clearInterval(termInterval);
				}
			},
			generateReportFromAPI(apiResult: FaceAnalysisResult): void {
				const now = new Date();
				const timeString = `${now.getFullYear()}-${this.formatNumber(now.getMonth() + 1)}-${this.formatNumber(now.getDate())} ${this.formatNumber(now.getHours())}:${this.formatNumber(now.getMinutes())}`;

				this.reportData = {
					id: `face_report_${Date.now()}`,
					imagePath: this.capturedImage || '',
					analyzeTime: timeString,
					results: [],
					fullData: apiResult
				};
				this.persistFaceSession();
			},
			handleReset(): void {
				this.capturedImage = null;
				this.reportData = null;
				this.resetPreviewTransform();
				clearFaceSession();
			},
			handleDownloadReport(): void {
				this.showWechatDialog = true;
			}
		}
	};
</script>

