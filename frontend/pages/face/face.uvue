	}

	.analyzing-header {
		padding: 28rpx 30rpx 12rpx;
	}

	.analyzing-area {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		width: 100%;
		gap: 20rpx;
	}

	.scan-frame-wrap {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.scan-animation-container {
		position: relative;
		width: 100%;
		background-color: #2a2118;
		border-radius: 16rpx;
		border: 3rpx solid #5a3e2b;
		overflow: hidden;
		box-shadow: 0 8rpx 24rpx rgba(90, 62, 43, 0.15);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.scan-animation-container.portrait {
		height: 520rpx;
		min-height: 520rpx;
		max-height: 560rpx;
	}

	.scan-preview-image {
		width: 100%;
		height: 100%;
	}

	.scan-glow {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 80rpx;
		background: linear-gradient(to bottom, rgba(183, 110, 74, 0.35), transparent);
		animation: scanMovePortrait 2.8s linear infinite;
		z-index: 4;
		pointer-events: none;
	}

	.scan-line {
		position: absolute;
		top: 0;
		left: 24rpx;
		right: 24rpx;
		height: 4rpx;
		background: linear-gradient(90deg, transparent, #f0c4a8, #b76e4a, #f0c4a8, transparent);
		box-shadow: 0 0 16rpx rgba(183, 110, 74, 0.8);
		animation: scanMovePortrait 2.8s linear infinite;
		z-index: 5;
		pointer-events: none;
	}

	@keyframes scanMovePortrait {
		0% { transform: translateY(0); opacity: 0.4; }
		15% { opacity: 1; }
		85% { opacity: 1; }
		100% { transform: translateY(520rpx); opacity: 0.4; }
	}

	.scan-pulse {
		animation: facePulse 2s ease-in-out infinite;
	}

	@keyframes facePulse {
		0% { opacity: 0.55; transform: scale(0.98); }
		50% { opacity: 1; transform: scale(1); }
		100% { opacity: 0.55; transform: scale(0.98); }
	}

	.analyze-status-card {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 16rpx;
		padding: 24rpx;
		box-sizing: border-box;
		background: linear-gradient(180deg, #fffdf9 0%, #faf6ef 100%);
		border: 2rpx solid #e8e0cc;
		border-radius: 16rpx;
		box-shadow: 0 4rpx 16rpx rgba(90, 62, 43, 0.06);
	}

	.analyze-status-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #5a3e2b;
		text-align: center;
		line-height: 1.5;
	}

	.analyze-progress-head {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 16rpx;
		width: 100%;
	}

	.analyze-progress-value {
		font-size: 28rpx;
		font-weight: bold;
		color: #b76e4a;
		min-width: 72rpx;
		text-align: right;
	}

	.analyze-progress-track {
		flex: 1;
		height: 12rpx;
		background-color: #f0e8da;
		border-radius: 8rpx;
		overflow: hidden;
	}

	.analyze-progress-fill {
		height: 100%;
		background: linear-gradient(90deg, #8c7662, #5a3e2b);
		border-radius: 8rpx;
		transition: width 0.6s ease;
	}

	.analyze-steps {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		width: 100%;
		gap: 8rpx;
		padding: 4rpx 0 8rpx;
	}

	.analyze-step {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8rpx;
		opacity: 0.45;
	}

	.analyze-step.active,
	.analyze-step.current {
		opacity: 1;
	}

	.analyze-step-dot {
		width: 16rpx;
		height: 16rpx;
		border-radius: 50%;
		background-color: #e8e0cc;
		border: 2rpx solid #c8b99b;
	}

	.analyze-step.active .analyze-step-dot {
		background-color: #5a3e2b;
		border-color: #5a3e2b;
	}

	.analyze-step.current .analyze-step-dot {
		background-color: #b76e4a;
		border-color: #b76e4a;
		box-shadow: 0 0 0 6rpx rgba(183, 110, 74, 0.2);
	}

	.analyze-step-label {
		font-size: 20rpx;
		color: #8c7662;
		text-align: center;
		line-height: 1.3;
	}

	.analyze-step.current .analyze-step-label {
		color: #5a3e2b;
		font-weight: bold;
	}

	.analyzing-status {
		font-size: 26rpx;
		font-weight: bold;
		color: #5a3e2b;
		text-align: center;
		line-height: 1.5;
	}

	.analyzing-patience-hint {
		font-size: 22rpx;
		color: #8c7662;
		text-align: center;
		line-height: 1.5;
	}

	.scan-dimension-panel {
		width: 100%;
		padding: 24rpx 20rpx;
		box-sizing: border-box;
		background-color: #fff;
		border: 2rpx solid #e8e0cc;
		border-radius: 16rpx;
		box-shadow: inset 0 0 24rpx rgba(90, 62, 43, 0.03);
	}

	.scan-dimension-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10rpx;
		margin-bottom: 20rpx;
		padding-bottom: 16rpx;
		border-bottom: 1rpx dashed #e8e0cc;
	}

	.scan-dimension-title {
		font-size: 28rpx;
		font-weight: bold;
		color: #5a3e2b;
	}

	.scan-dimension-current {
		font-size: 24rpx;
		color: #b76e4a;
		text-align: center;
		line-height: 1.4;
	}

	.scan-dimension-grid {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 12rpx;
		width: 100%;
	}

	.scan-dimension-item {
		width: calc(50% - 6rpx);
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 10rpx;
		padding: 16rpx 14rpx;
		box-sizing: border-box;
		background-color: #faf6ef;
		border: 1rpx solid #ebe3d4;
		border-radius: 12rpx;
		opacity: 0.65;
	}

	.scan-dimension-item.active {
		opacity: 1;
		background-color: #f3ebe0;
		border-color: #b76e4a;
		box-shadow: 0 4rpx 12rpx rgba(183, 110, 74, 0.12);
	}

	.scan-dimension-item.done {
		opacity: 1;
		background-color: #f7f3eb;
		border-color: #d8cbb8;
	}

	.scan-dimension-mark {
		width: 28rpx;
		height: 28rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.mark-done {
		font-size: 22rpx;
		color: #5a3e2b;
		font-weight: bold;
	}

	.mark-pending {
		font-size: 28rpx;
		color: #c8b99b;
		line-height: 1;
	}

	.mark-spinner {
		width: 18rpx;
		height: 18rpx;
		border-radius: 50%;
		border: 3rpx solid #e8e0cc;
		border-top-color: #b76e4a;
		animation: spinMark 0.8s linear infinite;
	}

	@keyframes spinMark {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.scan-dimension-label {
		flex: 1;
		font-size: 22rpx;
		color: #8c7662;
		line-height: 1.35;
	}

	.scan-dimension-item.active .scan-dimension-label {
		color: #5a3e2b;
		font-weight: bold;
	}

	.scan-dimension-item.done .scan-dimension-label {
		color: #6b5645;
	}

	.face-footer {
		display: flex;
		flex-direction: column;
		width: 92%;
		padding: 0 0 36rpx;
		gap: 20rpx;
		box-sizing: border-box;
		flex-shrink: 0;
	}

	.face-btn {
		width: 100%;
		height: 96rpx;
		border-radius: 48rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		border: none;
	}

	.btn-primary {
		background-color: #5a3e2b;
		color: #fff;
	}

	.btn-secondary {
		background-color: #fff;
		color: #5a3e2b;
		border: 1rpx solid #5a3e2b;
	}

	.btn-text {
		font-weight: bold;
		color: inherit;
	}

	.result-area {
		width: 100%;
		height: calc(100vh - 40rpx);
	}

	.result-scroll {
		height: 100%;
	}

	.result-card {
		padding: 30rpx 25rpx 60rpx;
		box-sizing: border-box;
	}

	.result-header-top-row {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 24rpx;
	}

	.result-title {
		font-size: 36rpx;
		font-weight: bold;
		color: #5a3e2b;
		display: block;
	}

	.result-time {
		font-size: 24rpx;
		color: #8c7662;
		margin-top: 8rpx;
		display: block;
	}

	.result-lang-inline {
		display: flex;
		flex-direction: row;
		gap: 10rpx;
	}

	.result-lang-btn {
		padding: 6rpx 18rpx;
		border-radius: 24rpx;
		border: 2rpx solid #c8b99b;
		background-color: #fff;
		font-size: 22rpx;
		color: #8c7662;
	}

	.result-lang-btn.active {
		background-color: #5a3e2b;
		color: #fff;
		border-color: #5a3e2b;
	}

	.face-visual-section {
		background-color: #fff;
		border-radius: 12rpx;
		padding: 20rpx;
		border: 1rpx solid #e8e0cc;
		margin-bottom: 30rpx;
	}

	.face-photo {
		width: 100%;
		height: 480rpx;
		border-radius: 8rpx;
	}

	.section-header {
		margin-bottom: 24rpx;
		border-left: 8rpx solid #5a3e2b;
		padding-left: 20rpx;
	}

	.section-title {
		font-size: 34rpx;
		font-weight: bold;
		color: #5a3e2b;
	}

	.summary-section,
	.features-section,
	.dimensions-section,
	.suggestions-section {
		margin-bottom: 30rpx;
	}

	.harsh-warning-card {
		background-color: #fff9f8;
		border: 2rpx solid #d9a09a;
		border-radius: 12rpx;
		overflow: hidden;
		margin-bottom: 30rpx;
	}

	.warning-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 15rpx;
		padding: 25rpx 30rpx;
		background: linear-gradient(to right, #fdecea, #fff9f8);
		border-bottom: 2rpx solid #f5d0cd;
	}

	.warning-stamp {
		width: 45rpx;
		height: 45rpx;
	}

	.warning-title {
		color: #a82e2e;
		font-weight: bold;
		font-size: 32rpx;
	}

	.warning-content {
		padding: 30rpx;
	}

	.warning-text {
		color: #5a3e2b;
		font-size: 28rpx;
		line-height: 1.8;
	}

	.summary-grid {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 20rpx;
		background-color: #fff;
		border-radius: 12rpx;
		padding: 30rpx 20rpx;
		border: 1rpx solid #e8e0cc;
	}

	.summary-item {
		width: 30%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12rpx;
	}

	.summary-score-circle {
		width: 100rpx;
		height: 100rpx;
		border-radius: 50%;
		border: 4rpx solid #b76e4a;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #fdfaf5;
	}

	.summary-score {
		font-size: 32rpx;
		font-weight: bold;
		color: #5a3e2b;
	}

	.summary-score-unit {
		font-size: 20rpx;
		color: #8c7662;
	}

	.summary-dim-name {
		font-size: 24rpx;
		color: #5a3e2b;
		text-align: center;
	}

	.overall-card {
		margin-top: 24rpx;
		background-color: #fff;
		border-radius: 12rpx;
		padding: 30rpx;
		border: 1rpx solid #e8e0cc;
	}

	.overall-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #5a3e2b;
		margin-bottom: 16rpx;
		display: block;
	}

	.overall-text {
		font-size: 28rpx;
		color: #636366;
		line-height: 1.75;
	}

	.features-card,
	.suggestions-card {
		background-color: #fff;
		border-radius: 12rpx;
		padding: 30rpx;
		border: 1rpx solid #e8e0cc;
	}

	.feature-item {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: flex-start;
		padding-bottom: 20rpx;
		margin-bottom: 20rpx;
		border-bottom: 1rpx dashed #f0eadd;
		gap: 20rpx;
	}

	.feature-item:last-child {
		border-bottom: none;
		margin-bottom: 0;
		padding-bottom: 0;
	}

	.feature-label {
		font-size: 28rpx;
		color: #8c7662;
		flex-shrink: 0;
	}

	.feature-value {
		font-size: 28rpx;
		color: #5a3e2b;
		font-weight: bold;
		text-align: right;
		flex: 1;
	}

	.feature-detail-card {
		background-color: #fff;
		border-radius: 12rpx;
		padding: 28rpx 30rpx;
		border: 1rpx solid #e8e0cc;
		margin-top: 20rpx;
	}

	.feature-detail-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #5a3e2b;
		margin-bottom: 12rpx;
		display: block;
	}

	.feature-detail-desc {
		font-size: 28rpx;
		color: #636366;
		line-height: 1.7;
	}

	.dimension-card {
		background-color: #fff;
		border-radius: 12rpx;
		padding: 30rpx;
		border: 1rpx solid #e8e0cc;
		margin-bottom: 20rpx;
	}

	.dimension-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 20rpx;
		margin-bottom: 16rpx;
		padding-bottom: 16rpx;
		border-bottom: 1rpx dashed #f0eadd;
	}

	.dim-icon-box {
		width: 80rpx;
		height: 80rpx;
		border-radius: 50%;
		background-color: #fdfaf5;
		border: 1rpx solid #e8e0cc;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.dim-custom-icon {
		width: 52rpx;
		height: 52rpx;
	}

	.dimension-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #5a3e2b;
	}

	.dimension-content {
		font-size: 28rpx;
		color: #636366;
		line-height: 1.75;
		white-space: pre-line;
	}

	.suggestion-group {
		margin-bottom: 24rpx;
	}

	.suggestion-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 12rpx;
		margin-bottom: 12rpx;
	}

	.suggestion-dot {
		width: 14rpx;
		height: 14rpx;
		border-radius: 50%;
	}

	.career-dot { background-color: #b7a04a; }
	.life-dot { background-color: #6b8e23; }

	.suggestion-type {
		font-size: 30rpx;
		font-weight: bold;
		color: #5a3e2b;
	}

	.suggestion-text {
		font-size: 28rpx;
		color: #636366;
		line-height: 1.6;
	}

	.suggestion-footer {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 12rpx;
		background-color: #fdfaf5;
		padding: 20rpx;
		border-radius: 8rpx;
		border: 1rpx solid #f0eadd;
	}

	.tip-icon { font-size: 28rpx; }

	.tip-text {
		font-size: 24rpx;
		color: #8c7662;
		line-height: 1.5;
		flex: 1;
	}

	.result-actions {
		display: flex;
		flex-direction: row;
		gap: 24rpx;
		margin-top: 20rpx;
	}

	.result-btn {
		flex: 1;
		height: 96rpx;
		border-radius: 48rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		border: none;
	}

	.wechat-mask {
		position: fixed;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.6);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 999;
	}

	.wechat-dialog {
		width: 620rpx;
		padding: 50rpx 40rpx 40rpx;
		border-radius: 12rpx;
		background-color: #fff;
		border: 4rpx solid #5a3e2b;
		display: flex;
		flex-direction: column;
		align-items: center;
		box-sizing: border-box;
	}

	.wechat-title {
		font-size: 36rpx;
		font-weight: bold;
		color: #5a3e2b;
		margin-bottom: 30rpx;
	}

	.wechat-qrcode {
		width: 400rpx;
		margin-bottom: 30rpx;
	}

	.wechat-desc {
		font-size: 26rpx;
		color: #636366;
		line-height: 1.6;
		text-align: center;
		margin-bottom: 40rpx;
	}

	.wechat-close-btn {
		width: 100%;
		height: 90rpx;
		border-radius: 45rpx;
		background-color: #5a3e2b;
		color: #fff;
		border: none;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.archive-card,
	.three-section-card,
	.official-card,
	.palace-card,
	.fortune-card,
	.balance-card {
		background-color: #fff;
		border-radius: 12rpx;
		padding: 24rpx 28rpx;
		border: 1rpx solid #e8e0cc;
		margin-bottom: 20rpx;
	}

	.archive-row {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 12rpx 0;
		border-bottom: 1rpx dashed #f0eadd;
	}

	.archive-row:last-of-type {
		border-bottom: none;
	}

	.archive-label,
	.official-label,
	.palace-label,
	.balance-label {
		font-size: 26rpx;
		color: #8c7662;
		flex-shrink: 0;
	}

	.archive-value {
		font-size: 28rpx;
		color: #5a3e2b;
		font-weight: bold;
		text-align: right;
	}

	.archive-block {
		margin-top: 16rpx;
	}

	.archive-block.muted {
		background-color: #faf6ef;
		border-radius: 10rpx;
		padding: 16rpx 20rpx;
	}

	.archive-text {
		font-size: 26rpx;
		color: #636366;
		line-height: 1.7;
		display: block;
	}

	.archive-text.small {
		font-size: 22rpx;
		color: #8c7662;
		margin-top: 8rpx;
	}

	.three-section-head {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 12rpx;
		margin-bottom: 12rpx;
		flex-wrap: wrap;
	}

	.three-section-name {
		font-size: 30rpx;
		font-weight: bold;
		color: #5a3e2b;
	}

	.three-section-age {
		font-size: 22rpx;
		color: #8c7662;
		background-color: #faf6ef;
		padding: 4rpx 14rpx;
		border-radius: 16rpx;
	}

	.three-section-score {
		margin-left: auto;
		font-size: 28rpx;
		font-weight: bold;
		color: #b76e4a;
	}

	.three-section-summary {
		font-size: 28rpx;
		color: #5a3e2b;
		line-height: 1.6;
		margin-bottom: 10rpx;
		display: block;
	}

	.three-section-details {
		font-size: 26rpx;
		color: #636366;
		line-height: 1.75;
		display: block;
	}

	.balance-text {
		font-size: 26rpx;
		color: #636366;
		line-height: 1.7;
		margin-top: 10rpx;
		display: block;
	}

	.official-name,
	.palace-name {
		font-size: 30rpx;
		font-weight: bold;
		color: #5a3e2b;
		margin-bottom: 16rpx;
		display: block;
	}

	.official-row,
	.palace-row {
		margin-bottom: 12rpx;
	}

	.official-text,
	.palace-text {
		font-size: 26rpx;
		color: #636366;
		line-height: 1.7;
		margin-top: 6rpx;
		display: block;
	}

	.palace-head {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 14rpx;
	}

	.palace-fortune {
		font-size: 24rpx;
		color: #b76e4a;
		font-weight: bold;
		background-color: #faf6ef;
		padding: 6rpx 16rpx;
		border-radius: 16rpx;
	}

	.fortune-head {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
