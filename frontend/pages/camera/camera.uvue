	.scan-animation-container {
		position: relative;
		width: 400rpx;
		height: 500rpx;
		background-color: #fdfaf5;
		border-radius: 20rpx;
		overflow: hidden;
		border: 2rpx solid #e8e0cc;
	}

	.scan-hand-bg {
		width: 100%;
		height: 100%;
		opacity: 0.2;
		animation: pulse 2s ease-in-out infinite;
	}

	@keyframes pulse {
		0% { opacity: 0.15; transform: scale(0.98); }
		50% { opacity: 0.3; transform: scale(1.02); }
		100% { opacity: 0.15; transform: scale(0.98); }
	}

	.scan-hand-bg.mirror {
		transform: scaleX(-1);
	}

	.scan-line {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 4rpx;
		background: linear-gradient(to right, transparent, #b76e4a, transparent);
		box-shadow: 0 0 15rpx #b76e4a;
		animation: scanMove 3s linear infinite;
		z-index: 5;
	}

	.scan-glow {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100rpx;
		background: linear-gradient(to bottom, rgba(183, 110, 74, 0.2), transparent);
		animation: scanMove 3s linear infinite;
		z-index: 4;
	}

	@keyframes scanMove {
		0% { transform: translateY(-100rpx); }
		100% { transform: translateY(600rpx); }
	}

	.analyzing-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 15rpx;
	}

	.analyzing-text {
		font-size: 34rpx;
		color: #5a3e2b;
		font-weight: bold;
		letter-spacing: 2rpx;
	}

