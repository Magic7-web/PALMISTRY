		padding: 0 40rpx;
	}

	.analyzing-status {
		font-size: 24rpx;
		color: #8c7662;
		font-style: italic;
	}

	.scan-term-overlay {
		position: absolute;
		bottom: 40rpx;
		left: 0;
		width: 100%;
		display: flex;
		justify-content: center;
		z-index: 10;
	}

	.scan-term-text {
		background-color: rgba(90, 62, 43, 0.7);
		color: #fdf7ee;
		padding: 10rpx 30rpx;
		border-radius: 30rpx;
		font-size: 24rpx;
		letter-spacing: 2rpx;
		animation: termFade 1.5s infinite;
	}

	@keyframes termFade {
		0% { opacity: 0.5; transform: translateY(10rpx); }
		50% { opacity: 1; transform: translateY(0); }
		100% { opacity: 0.5; transform: translateY(-10rpx); }
	}
