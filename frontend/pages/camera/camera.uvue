		color: #666;
	}

	.btn-confirm {
		background-color: #007aff;
		color: #fff;
	}

	.guide-area {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		min-height: 0;
	}

	.guide-box {
		width: 500rpx;
		height: 100%;
		max-height: 600rpx;
		border: 4rpx dashed #ddd;
		border-radius: 20rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		position: relative;
		background-color: #fafafa;
		box-sizing: border-box;
	}

	.hand-outline {
		width: 100%;
		height: 85%;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 30rpx;
		box-sizing: border-box;
	}

	.hand-image {
		width: 100%;
		height: 100%;
		max-width: 380rpx;
		max-height: 480rpx;
		opacity: 0.7;
		transition: transform 0.3s ease;
	}

	.hand-image.mirror {
		transform: scaleX(-1);
	}

	.guide-text {
		font-size: 24rpx;
		color: #666;
		text-align: center;
		padding: 20rpx;
		margin-top: 20rpx;
		line-height: 1.5;
	}

	.camera-footer {
		display: flex;
		flex-direction: column;
		width: 100%;
		padding: 40rpx 40rpx 60rpx;
		background-color: #fdf7ee;
		box-sizing: border-box;
		flex-shrink: 0;
		align-items: center;
	}

	.camera-btn {
		width: 100%;
		max-width: 670rpx;
		height: 100rpx;
		background-color: #5a3e2b;
		color: #fff;
		border-radius: 50rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 32rpx;
		font-weight: bold;
		border: none;
		margin-bottom: 25rpx;
		box-shadow: 0 8rpx 20rpx rgba(90, 62, 43, 0.2);
	}

	.album-btn {
		width: 100%;
		max-width: 670rpx;
		height: 100rpx;
		background-color: #fff;
		color: #5a3e2b;
		border: 1rpx solid #5a3e2b;
		border-radius: 50rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 32rpx;
		font-weight: bold;
	}

	.policy-links {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12rpx;
		margin-top: 28rpx;
		padding: 0 20rpx;
	}

	.policy-link,
	.policy-separator {
		font-size: 22rpx;
		line-height: 1.6;
		color: #8c7662;
	}

	.policy-link {
		text-decoration: underline;
	}

	.btn-text {
		color: inherit;
		font-weight: bold;
	}

	/* 结果显示区域现代样式 */
	.result-area {
		width: 100%;
		height: 100%;
		background-color: #fdf7ee;
		box-sizing: border-box;
	}

	.result-scroll {
		width: 100%;
		height: 100%;
	}

	.result-card {
		width: 100%;
		background-color: #fff;
		background-image: 
			linear-gradient(to right, #fdf7ee 2rpx, transparent 2rpx),
			linear-gradient(to bottom, #fdf7ee 2rpx, transparent 2rpx);
		background-size: 40rpx 40rpx;
		border-radius: 12rpx;
		border: 4rpx double #5a3e2b;
		padding: 40rpx 30rpx;
		box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.05);
		box-sizing: border-box;
	}

	.result-header {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		width: 100%;
		margin-bottom: 40rpx;
		border-bottom: 2rpx solid #5a3e2b;
		padding-bottom: 20rpx;
		position: relative;
		box-sizing: border-box;
	}

	.result-header-top-row {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		justify-content: space-between;
		width: 100%;
		gap: 16rpx;
		box-sizing: border-box;
	}

	.result-header-text-block {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		flex: 1;
		min-width: 0;
		padding-left: 44rpx;
		padding-right: 8rpx;
		box-sizing: border-box;
	}

	.result-lang-inline {
		display: flex;
		flex-direction: row;
		align-items: center;
		flex-shrink: 0;
		gap: 10rpx;
		padding-top: 8rpx;
		position: relative;
		z-index: 2;
	}

	.result-lang-btn {
		padding: 8rpx 22rpx;
		border-radius: 28rpx;
		border: 2rpx solid #c8b99b;
		background-color: #fff;
		font-size: 24rpx;
		color: #5a3e2b;
		font-weight: bold;
	}

	.result-lang-btn.active {
		background: linear-gradient(135deg, #5a3e2b, #3d2a1d);
		color: #fdf7ee;
		border-color: #5a3e2b;
	}

	.result-subtitle {
		font-size: 26rpx;
		color: #8c7662;
		line-height: 1.55;
		margin-top: 20rpx;
		width: 100%;
		text-align: center;
		padding: 0 10rpx;
		box-sizing: border-box;
	}

	.result-header::after {
		content: "";
		position: absolute;
		bottom: -6rpx;
		left: 0;
		width: 100%;
		height: 2rpx;
		background-color: #5a3e2b;
	}

	.result-title {
		font-size: 44rpx;
		font-weight: bold;
		color: #5a3e2b;
		letter-spacing: 3rpx;
		margin-bottom: 10rpx;
		position: relative;
		text-align: left;
	}

	.result-title::before, .result-title::after {
		content: "✦";
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		font-size: 24rpx;
		color: #c8b99b;
	}

	.result-title::before { left: -40rpx; }
	.result-title::after { right: -40rpx; }

	.result-time {
		font-size: 26rpx;
		color: #8c7662;
		font-weight: 400;
	}

	/* 交互式手相标注区域样式 */
	.interactive-hand-section {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 40rpx 0;
		background-color: #fdfaf5;
		border-radius: 12rpx;
		margin-bottom: 40rpx;
		border: 2rpx solid #e8e0cc;
		position: relative;
	}

	.interactive-hand-section::before, .interactive-hand-section::after {
		content: "";
		position: absolute;
		width: 40rpx;
		height: 40rpx;
		border: 4rpx solid #5a3e2b;
	}

	.interactive-hand-section::before {
		top: -4rpx; left: -4rpx;
		border-right: none; border-bottom: none;
	}

	.interactive-hand-section::after {
		bottom: -4rpx; right: -4rpx;
		border-left: none; border-top: none;
	}

	.hand-visual-wrapper {
		position: relative;
		width: 550rpx;
		height: 650rpx;
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 30rpx;
		border-radius: 20rpx;
		overflow: hidden;
		background-color: #f5efe0;
		border: 1rpx solid #dcd1b5;
	}

	.user-hand-image {
		position: absolute;
		width: 100%;
		height: 100%;
		z-index: 1;
		opacity: 0.9;
	}

	.hand-base-image {
		position: absolute;
		width: 450rpx;
		height: 550rpx;
		opacity: 0.3;
		z-index: 2;
		transition: all 0.5s ease;
		pointer-events: none;
	}

	.hand-base-image.mirror {
		transform: scaleX(-1);
	}

	.hand-lines-glow-layer {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		display: flex;
		justify-content: center;
		align-items: center;
		z-index: 3;
	}

	.line-glow-img {
		position: absolute;
		width: 450rpx;
		height: 550rpx;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		z-index: 3;
		filter: drop-shadow(0 0 10rpx #b76e4a) brightness(1.2);
	}

	.line-glow-img.mirror {
		transform: scaleX(-1);
	}

	/* 国风切换器 */
	.thematic-line-selector {
		display: flex;
		flex-direction: row;
		justify-content: center;
		width: 90%;
		gap: 40rpx;
		margin-top: 20rpx;
	}

	.line-tab-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 10rpx 0;
		position: relative;
	}

	.tab-item-text {
		font-size: 30rpx;
		color: #8c7662;
		font-weight: 500;
		transition: all 0.3s;
	}

	.line-tab-item.active .tab-item-text {
		color: #5a3e2b;
		font-weight: bold;
		transform: scale(1.1);
	}

	.tab-item-line {
		width: 40rpx;
		height: 4rpx;
		background-color: #5a3e2b;
		margin-top: 8rpx;
		border-radius: 2rpx;
	}

	.line-details-panel {
		width: 90%;
		margin-top: 16rpx;
	}

	.line-detail-item {
		padding: 16rpx 8rpx;
	}

	.line-detail-item:last-child {
		padding-bottom: 0;
	}

	.line-detail-header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 10rpx;
	}

	.line-tag-wrapper {
		padding: 4rpx 0;
	}

	.line-tag-text {
		font-size: 32rpx;
		color: #5a3e2b;
		font-weight: bold;
	}

	.line-score {
		font-size: 34rpx;
		font-weight: bold;
		color: #b76e4a;
	}

	.line-description {
		font-size: 28rpx;
		color: #5a3e2b;
		line-height: 1.8;
		display: block;
	}

	/* 详细维度分析样式 */
	.dimensions-section {
		display: flex;
		flex-direction: column;
		gap: 30rpx;
		padding: 20rpx 0;
	}

	/* 国风预警卡片 */
	.harsh-warning-card {
		background-color: #fff9f8;
		border: 2rpx solid #d9a09a;
		border-radius: 12rpx;
		padding: 0;
		margin-bottom: 30rpx;
		overflow: hidden;
		box-shadow: 0 10rpx 30rpx rgba(168, 46, 46, 0.1);
		position: relative;
	}

	.harsh-warning-card::before {
		content: "!";
		position: absolute;
		right: -20rpx;
		bottom: -40rpx;
		font-size: 200rpx;
		color: rgba(168, 46, 46, 0.05);
		font-weight: bold;
		z-index: 0;
	}

	.warning-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 25rpx 30rpx;
		background: linear-gradient(to right, #fdecea, #fff9f8);
		gap: 15rpx;
		border-bottom: 2rpx solid #f5d0cd;
		position: relative;
		z-index: 1;
	}

	.warning-stamp {
		width: 45rpx;
		height: 45rpx;
	}

	.warning-title {
		color: #a82e2e;
		font-weight: 900;
		font-size: 32rpx;
		letter-spacing: 4rpx;
		text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
	}

	.warning-content {
		padding: 35rpx 40rpx;
		position: relative;
		z-index: 1;
	}

	.warning-text {
		color: #5a3e2b;
		font-size: 30rpx;
		line-height: 1.8;
		font-weight: 600;
		text-align: justify;
	}

	/* 综合命定结论卡片 */
	.overall-conclusion-card {
		background-color: #fff;
		border-radius: 30rpx;
		padding: 30rpx;
		margin-top: 20rpx;
		border: 1rpx solid #f0f0f0;
		box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
	}

	.overall-text {
		font-size: 28rpx;
		color: #1c1c1e;
		line-height: 1.6;
		font-style: italic;
	}

	.dimension-card {
		display: flex;
		flex-direction: row;
		background-color: #fcfaf2;
		background-image: url('https://img.alicdn.com/imgextra/i2/O1CN01m99vS21Z5vXvz1Z5v_!!6000000000001-2-tps-100-100.png'); /* 极淡的底纹 */
		border-radius: 24rpx;
		padding: 30rpx;
		gap: 24rpx;
		border: 1rpx solid rgba(90, 62, 43, 0.1);
		box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.02);
	}

	.dimension-icon-box {
		width: 90rpx;
		height: 90rpx;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		background-color: #fdfaf5;
		border: 1rpx solid #e8e0cc;
	}

	.dim-custom-icon {
		width: 60rpx;
		height: 60rpx;
	}

	.handType-icon { background-color: #e3f2fd; color: #2196f3; }
	.palmMounds-icon { background-color: #f3e5f5; color: #9c27b0; }
	.specialMarks-icon { background-color: #fffde7; color: #fbc02d; }
	.career-icon { background-color: #e3f2fd; color: #2196f3; }
	.love-icon { background-color: #fce4ec; color: #f06292; }
	.health-icon { background-color: #e8f5e9; color: #4caf50; }
	.personality-icon { background-color: #fff3e0; color: #ff9800; }
	.recentLuck-icon { background-color: #fce4ec; color: #c2185b; }

	.dimension-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 8rpx;
	}

	.dimension-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #1c1c1e;
	}

	.dimension-content {
		font-size: 26rpx;
		color: #636366;
		line-height: 1.75;
		white-space: pre-line;
	}

	.features-card, .suggestions-card {
		background-color: #fff;
		border-radius: 30rpx;
		padding: 30rpx;
		margin-top: 20rpx;
		border: 1rpx solid #f0f0f0;
		box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
	}

	.card-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #5a3e2b;
		margin-bottom: 24rpx;
		display: block;
		padding-left: 20rpx;
		border-left: 10rpx solid #5a3e2b;
		position: relative;
	}

	.card-title::after {
		content: "";
		position: absolute;
		bottom: -10rpx;
		left: 0;
		width: 100rpx;
		height: 2rpx;
		background-color: #5a3e2b;
		opacity: 0.3;
	}

	.feature-item {
		display: flex;
		flex-direction: row;
		margin-bottom: 16rpx;
	}

	.feature-label {
		font-size: 28rpx;
		color: #8e8e93;
		width: 140rpx;
	}

	.feature-value {
		flex: 1;
		font-size: 28rpx;
		color: #1c1c1e;
	}

	.suggestion-item {
		margin-bottom: 24rpx;
	}

	.suggestion-tag {
		font-size: 22rpx;
		padding: 4rpx 16rpx;
		border-radius: 8rpx;
		margin-bottom: 12rpx;
		display: inline-block;
	}

	.career-tag { background-color: #e3f2fd; color: #2196f3; }
	.life-tag { background-color: #e8f5e9; color: #4caf50; }

	.suggestion-text {
		font-size: 28rpx;
		color: #1c1c1e;
		line-height: 1.6;
	}

	.suggestion-tip {
		margin-top: 20rpx;
		padding-top: 20rpx;
		border-top: 1rpx dashed #eee;
	}

	.tip-text {
		font-size: 24rpx;
		color: #aeaeb2;
		font-style: italic;
	}

	.followup-section {
		background-color: #fff;
		border-radius: 30rpx;
		padding: 30rpx;
		margin-top: 20rpx;
		border: 1rpx solid #f0f0f0;
		box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
	}

	.followup-tabs {
		display: flex;
		flex-direction: row;
		gap: 12rpx;
		margin-bottom: 22rpx;
		padding: 8rpx;
		border-radius: 18rpx;
		background-color: #f8f0e5;
		box-sizing: border-box;
	}

	.followup-tab {
		flex: 1;
		min-width: 0;
		height: 68rpx;
		border-radius: 14rpx;
		background-color: transparent;
		border: none;
		box-shadow: none;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0 10rpx;
	}

	.followup-tab.active {
		background-color: #5a3e2b;
		box-shadow: 0 8rpx 18rpx rgba(90, 62, 43, 0.18);
	}

	.followup-tab::after {
		border: none;
	}

	.followup-tab-text {
		display: block;
		width: 100%;
		font-size: 28rpx;
		font-weight: bold;
		color: #7a6655;
		text-align: center;
		line-height: 1;
		white-space: nowrap;
	}

	.followup-tab.active .followup-tab-text {
		color: #fffaf1;
	}

	.followup-panel {
		background: linear-gradient(180deg, #fffdf8 0%, #fff 100%);
		border: 1rpx solid #eadfca;
		border-radius: 24rpx;
		padding: 24rpx;
		box-sizing: border-box;
	}

	.followup-panel-head {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		justify-content: space-between;
		gap: 18rpx;
		margin-bottom: 18rpx;
	}

	.followup-locked-panel {
		position: relative;
		min-height: 760rpx;
		border-radius: 20rpx;
		overflow: hidden;
		background-color: #fbf7ef;
		border: 1rpx solid #eee0c9;
	}

	.followup-preview-blur {
		min-height: 760rpx;
		padding: 36rpx 28rpx;
		filter: blur(7px);
		-webkit-filter: blur(7px);
		opacity: 0.78;
		transform: scale(1.01);
	}

	.followup-preview-text {
		display: block;
		font-size: 27rpx;
		color: #2f1d13;
		line-height: 1.85;
		margin-bottom: 22rpx;
	}

	.followup-lock-overlay {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 18rpx;
		padding: 34rpx;
		background-color: rgba(255, 250, 241, 0.72);
		box-sizing: border-box;
	}

	.followup-lock-overlay .followup-unlock-btn {
		width: 100%;
		max-width: 520rpx;
		margin-top: 0;
	}

	.followup-generating {
		min-height: 760rpx;
		border-radius: 20rpx;
		border: 1rpx solid #eee0c9;
		background-color: #fbf7ef;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 48rpx;
		box-sizing: border-box;
	}

	.followup-spinner {
		width: 58rpx;
		height: 58rpx;
		border-radius: 50%;
		border: 6rpx solid #e3d2b5;
		border-top-color: #5a3e2b;
		animation: spin 0.9s linear infinite;
		margin-bottom: 18rpx;
	}

	.followup-generating-title {
		font-size: 30rpx;
		font-weight: bold;
		color: #5a3e2b;
		margin-bottom: 8rpx;
	}

	.followup-generating-desc {
		font-size: 24rpx;
		color: #736357;
		line-height: 1.55;
		text-align: center;
	}

	@keyframes spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	.followup-card-title-block {
		flex: 1;
		min-width: 0;
	}

	.followup-card-title {
		display: block;
		font-size: 30rpx;
		font-weight: bold;
		color: #5a3e2b;
		margin-bottom: 8rpx;
	}

	.followup-card-desc {
		display: block;
		font-size: 24rpx;
		color: #736357;
		line-height: 1.6;
	}

	.followup-card-price {
		flex-shrink: 0;
		font-size: 28rpx;
		font-weight: bold;
		color: #2f1d13;
		background-color: #f8efdf;
		border-radius: 999rpx;
		padding: 8rpx 16rpx;
	}

	.followup-answer-box {
		padding: 20rpx;
		border-radius: 18rpx;
		background-color: #fbf7ef;
		border-left: 8rpx solid #5a3e2b;
	}

	.followup-answer-title {
		display: block;
		font-size: 26rpx;
		font-weight: bold;
		color: #5a3e2b;
		margin-bottom: 12rpx;
	}

	.followup-answer-text {
		display: block;
		font-size: 26rpx;
		color: #1c1c1e;
		line-height: 1.7;
		white-space: pre-line;
	}

	.followup-answer-hint {
		display: block;
