<template>
	<view class="camera-container">
		<!-- 背景暗纹 -->
		<view class="bg-decoration">
			<view class="bg-bagua"></view>
		</view>

		<view class="camera-content-wrapper">
			<view class="camera-header" v-if="!reportData">
				<view class="header-main">
					<text class="header-title">{{ ui.headerTitle }}</text>
					<image class="header-stamp" src="/static/favicon.png" mode="aspectFit"></image>
				</view>
				<view class="header-deco"></view>
				<text class="header-subtitle">{{ ui.headerSubtitle }}</text>
				<view class="lang-switch-row">
					<text class="switch-label">{{ locale === 'en' ? 'Language' : '语言' }}</text>
					<view class="switch-buttons">
						<button
							class="hand-btn mini lang-btn"
							:class="{ 'active': locale === 'zh' }"
							@click="setLocale('zh')"
						>
							<text class="hand-text">{{ ui.langZh }}</text>
						</button>
						<button
							class="hand-btn mini lang-btn"
							:class="{ 'active': locale === 'en' }"
							@click="setLocale('en')"
						>
							<text class="hand-text">{{ ui.langEn }}</text>
						</button>
					</view>
				</view>
				<view class="hand-switch">
					<view class="switch-group">
						<text class="switch-label">{{ ui.genderLabel }}</text>
						<view class="switch-buttons">
							<button 
								class="hand-btn mini" 
								:class="{ 'active': gender === 'male' }"
								@click="gender = 'male'"
							>
								<text class="hand-text">{{ ui.male }}</text>
							</button>
							<button 
								class="hand-btn mini" 
								:class="{ 'active': gender === 'female' }"
								@click="gender = 'female'"
							>
								<text class="hand-text">{{ ui.female }}</text>
							</button>
						</view>
					</view>
					<view class="switch-group">
						<text class="switch-label">{{ ui.handLabel }}</text>
						<view class="switch-buttons">
							<button 
								class="hand-btn mini" 
								:class="{ 'active': handSide === 'left' }"
								@click="switchHand('left')"
							>
								<text class="hand-text">{{ ui.leftHand }}</text>
							</button>
							<button 
								class="hand-btn mini" 
								:class="{ 'active': handSide === 'right' }"
								@click="switchHand('right')"
							>
								<text class="hand-text">{{ ui.rightHand }}</text>
							</button>
						</view>
					</view>
				</view>
			</view>

			<view class="camera-content" :class="{ 'report-mode': reportData }">
			<!-- 结果显示区域 -->
			<view class="result-area" v-if="reportData">
				<scroll-view class="result-scroll" scroll-y="true">
					<view class="result-card">
						<view class="result-header">
							<view class="result-header-top-row">
								<view class="result-header-text-block">
									<text class="result-title">{{ ui.resultTitle }}</text>
									<text class="result-time" v-if="reportData.analyzeTime">{{ reportData.analyzeTime }}</text>
								</view>
								<view class="result-lang-inline">
									<button
										class="result-lang-btn"
										:class="{ active: locale === 'zh' }"
										@click="setLocale('zh')"
									>
										中文
									</button>
									<button
										class="result-lang-btn"
										:class="{ active: locale === 'en' }"
										@click="setLocale('en')"
									>
										EN
									</button>
								</view>
							</view>
							<text class="result-subtitle">{{ ui.headerSubtitle }}</text>
						</view>

						<!-- 交互式手相标注区域 -->
						<view class="interactive-hand-section">
							<view class="hand-visual-wrapper">
								<!-- 用户图片 (底层) -->
								<image 
									class="user-hand-image" 
									:src="reportData.imagePath" 
									mode="aspectFit"
								></image>
								
								<!-- 卡通手底图 (仅在未选中线条时显示，用于定位和参考) -->
								<image 
									v-if="!selectedLine"
									class="hand-base-image" 
									:class="{ 'mirror': handSide === 'right' }"
									src="@/static/hand.png" 
									mode="aspectFit"
								></image>
								
								<!-- 动态线条层 -->
								<view class="hand-lines-glow-layer">
									<image 
										v-if="selectedLine === 'life'" 
										class="line-glow-img" 
										:class="{ 'mirror': handSide === 'right' }"
										src="@/static/hand-life.png" 
										mode="aspectFit"
									></image>
									<image 
										v-if="selectedLine === 'wisdom'" 
										class="line-glow-img" 
										:class="{ 'mirror': handSide === 'right' }"
										src="@/static/Cause-hand.png" 
										mode="aspectFit"
									></image>
									<image 
										v-if="selectedLine === 'emotion'" 
										class="line-glow-img" 
										:class="{ 'mirror': handSide === 'right' }"
										src="@/static/feeling-hand.png" 
										mode="aspectFit"
									></image>
									<image 
										v-if="selectedLine === 'fate'" 
										class="line-glow-img" 
										:class="{ 'mirror': handSide === 'right' }"
										src="@/static/fate-hand.png" 
										mode="aspectFit"
									></image>
								</view>
							</view>

							<!-- 国风线条切换器 -->
							<view class="thematic-line-selector">
								<view 
									v-for="(tab, index) in handTabs" 
									:key="index"
									class="line-tab-item"
									:class="{ 'active': selectedLine === tab.id }"
									@click="selectHandLine(tab.id)"
								>
									<text class="tab-item-text">{{ tab.name }}</text>
									<view class="tab-item-line" v-if="selectedLine === tab.id"></view>
								</view>
							</view>

							<!-- 掌纹线评分：Tab 下方统一模块展示 -->
							<view class="line-details-panel" v-if="orderedLineResults.length > 0">
								<view
									class="line-detail-item"
									v-for="(line, lineIndex) in orderedLineResults"
									:key="lineIndex"
								>
									<view class="line-detail-header">
										<view class="line-tag-wrapper">
											<text class="line-tag-text">「{{ pickTxt(line.type, line.typeEn) }}」</text>
										</view>
										<text class="line-score" v-if="line.score != null">{{ line.score }}{{ ui.scoreUnit }}</text>
									</view>
									<text class="line-description">{{ pickTxt(line.description, line.descriptionEn) }}</text>
								</view>
							</view>
						</view>
						
						<!-- 详细分析内容区域 -->
						<view class="dimensions-section">
							<!-- 致命命理警示 - 重新设计为国风告示风格 -->
							<view class="harsh-warning-card" v-if="reportData.fullData && reportData.fullData.harshWarning">
								<view class="warning-header">
									<image class="warning-stamp" src="/static/favicon.png" mode="aspectFit"></image>
									<text class="warning-title">{{ ui.warningTitle }}</text>
								</view>
								<view class="warning-content">
									<text class="warning-text">{{ pickTxt(reportData.fullData.harshWarning, reportData.fullData.harshWarningEn) }}</text>
								</view>
							</view>

							<!-- 其他 AI 分析内容 -->
							<view v-if="reportData.fullData">
								<!-- 详细维度分析 -->
								<view class="dimension-card" v-for="key in getOrderedDimensionKeys(reportData.fullData.dimensions)" :key="key">
									<view class="dimension-icon-box" :class="key + '-icon'">
										<image class="dim-custom-icon" :src="getDimensionIcon(key)" mode="aspectFit"></image>
									</view>
									<view class="dimension-info">
										<text class="dimension-title">{{ dimTitle(reportData.fullData.dimensions[key]) }}</text>
										<text class="dimension-content">{{ dimContent(reportData.fullData.dimensions[key]) }}</text>
									</view>
								</view>

								<!-- 综合命定结论 -->
								<view class="overall-conclusion-card" v-if="reportData.fullData.overallAnalysis">
									<text class="card-title">{{ ui.overallCardTitle }}</text>
									<text class="overall-text">{{ pickTxt(reportData.fullData.overallAnalysis, reportData.fullData.overallAnalysisEn) }}</text>
								</view>

								<!-- 掌部特征 -->
								<view class="features-card" v-if="reportData.fullData.palmFeatures">
									<text class="card-title">{{ ui.featuresCardTitle }}</text>
									<view class="feature-item">
										<text class="feature-label">{{ ui.featurePalmShape }}</text>
										<text class="feature-value">{{ pickTxt(reportData.fullData.palmFeatures.palmShape, reportData.fullData.palmFeatures.palmShapeEn) }}</text>
									</view>
									<view class="feature-item">
										<text class="feature-label">{{ ui.featureFinger }}</text>
										<text class="feature-value">{{ pickTxt(reportData.fullData.palmFeatures.fingerRatio, reportData.fullData.palmFeatures.fingerRatioEn) }}</text>
									</view>
									<view class="feature-item">
										<text class="feature-label">{{ ui.featureMound }}</text>
										<text class="feature-value">{{ pickTxt(reportData.fullData.palmFeatures.palmMound, reportData.fullData.palmFeatures.palmMoundEn) }}</text>
									</view>
								</view>

								<!-- 专家建议 -->
								<view class="suggestions-card" v-if="reportData.fullData.suggestions">
									<text class="card-title">{{ ui.suggestionsCardTitle }}</text>
									<view class="suggestion-item">
										<view class="suggestion-header">
											<text class="suggestion-tag career-tag">{{ ui.careerAdviceTag }}</text>
										</view>
										<text class="suggestion-text">{{ pickTxt(reportData.fullData.suggestions.career, reportData.fullData.suggestions.careerEn) }}</text>
									</view>
									<view class="suggestion-item">
										<view class="suggestion-header">
											<text class="suggestion-tag life-tag">{{ ui.lifeAdviceTag }}</text>
										</view>
										<text class="suggestion-text">{{ pickTxt(reportData.fullData.suggestions.life, reportData.fullData.suggestions.lifeEn) }}</text>
									</view>
									<view class="suggestion-tip">
										<text class="tip-text">{{ pickTxt(reportData.fullData.suggestions.tip, reportData.fullData.suggestions.tipEn) }}</text>
									</view>
								</view>
							</view>

							<!-- 继续追问模块：首报免费，后续按模块付费 -->
							<view class="followup-section" v-if="followUpModules.length > 0">
								<view class="section-header">
									<text class="section-title">{{ ui.followUpSectionTitle }}</text>
									<text class="section-tips">{{ ui.followUpSectionTip }}</text>
								</view>

								<view class="followup-tabs">
									<button
										class="followup-tab"
										v-for="module in followUpModules"
										:key="module.id"
										:class="{ active: activeFollowUpModuleId === module.id }"
										@click="switchFollowUpTab(module.id)"
									>
										<text class="followup-tab-text">{{ getFollowUpTabLabel(module) }}</text>
									</button>
								</view>

								<view class="followup-panel" v-if="activeFollowUpModuleId === 'love'">
									<view class="followup-panel-head">
										<view class="followup-card-title-block">
											<text class="followup-card-title">{{ getFollowUpModuleTitle('love') }}</text>
											<text class="followup-card-desc">{{ getFollowUpModuleDesc('love') }}</text>
										</view>
										<text class="followup-card-price">{{ getFollowUpModulePriceLabel('love') }}</text>
									</view>

									<view class="followup-answer-box" v-if="getFollowUpAnswer('love')">
										<text class="followup-answer-title">{{ ui.followUpAnswerTitle }}</text>
										<text class="followup-answer-text">{{ getFollowUpAnswerText('love') }}</text>
										<text class="followup-answer-hint">{{ ui.followUpAnswerHint }}</text>
									</view>

									<view class="followup-generating" v-else-if="isFollowUpGenerating('love')">
										<view class="followup-spinner"></view>
										<text class="followup-generating-title">{{ locale === 'en' ? 'Generating deep reading' : '正在生成深度解读' }}</text>
										<text class="followup-generating-desc">{{ locale === 'en' ? 'The AI is reading this module based on your palm.' : 'AI 正在结合你的手相重新推演这个模块。' }}</text>
									</view>

									<view class="followup-locked-panel" v-else>
										<view class="followup-preview-blur">
											<text class="followup-preview-text">{{ getFollowUpModulePreview('love') }}</text>
											<text class="followup-preview-text">
												{{ locale === 'en'
													? 'The full reading includes why this pattern appears, what it means, practical next steps, and the risks to avoid.'
													: '完整内容会继续展开：为什么这么判断、解读出来的结果、应对策略，以及你最需要避开的风险。' }}
											</text>
										</view>
										<view class="followup-lock-overlay">
											<button
												class="followup-unlock-btn"
												@click="openFollowUpPaymentById('love')"
											>
												<text class="btn-text">
													{{ locale === 'en' ? 'Unlock this module ' : '解锁当前模块 ' }}{{ getFollowUpModulePriceLabel('love') }}
												</text>
											</button>
											<button
												class="followup-unlock-btn bundle-btn"
												v-if="!isAllFollowUpUnlocked()"
												@click="openBundlePayment"
											>
												<text class="btn-text">
													{{ locale === 'en' ? 'Unlock all ' : '一次解锁全部 ' }}{{ getBundlePriceLabel() }}
												</text>
											</button>
										</view>
									</view>
								</view>

								<view class="followup-panel" v-if="activeFollowUpModuleId === 'career'">
									<view class="followup-panel-head">
										<view class="followup-card-title-block">
											<text class="followup-card-title">{{ getFollowUpModuleTitle('career') }}</text>
											<text class="followup-card-desc">{{ getFollowUpModuleDesc('career') }}</text>
										</view>
										<text class="followup-card-price">{{ getFollowUpModulePriceLabel('career') }}</text>
									</view>

									<view class="followup-answer-box" v-if="getFollowUpAnswer('career')">
										<text class="followup-answer-title">{{ ui.followUpAnswerTitle }}</text>
										<text class="followup-answer-text">{{ getFollowUpAnswerText('career') }}</text>
										<text class="followup-answer-hint">{{ ui.followUpAnswerHint }}</text>
									</view>

									<view class="followup-generating" v-else-if="isFollowUpGenerating('career')">
										<view class="followup-spinner"></view>
										<text class="followup-generating-title">{{ locale === 'en' ? 'Generating deep reading' : '正在生成深度解读' }}</text>
										<text class="followup-generating-desc">{{ locale === 'en' ? 'The AI is reading this module based on your palm.' : 'AI 正在结合你的手相重新推演这个模块。' }}</text>
									</view>

									<view class="followup-locked-panel" v-else>
										<view class="followup-preview-blur">
											<text class="followup-preview-text">{{ getFollowUpModulePreview('career') }}</text>
											<text class="followup-preview-text">
												{{ locale === 'en'
													? 'The full reading includes why this pattern appears, what it means, practical next steps, and the risks to avoid.'
													: '完整内容会继续展开：为什么这么判断、解读出来的结果、应对策略，以及你最需要避开的风险。' }}
											</text>
										</view>
										<view class="followup-lock-overlay">
											<button class="followup-unlock-btn" @click="openFollowUpPaymentById('career')">
												<text class="btn-text">
													{{ locale === 'en' ? 'Unlock this module ' : '解锁当前模块 ' }}{{ getFollowUpModulePriceLabel('career') }}
												</text>
											</button>
											<button class="followup-unlock-btn bundle-btn" v-if="!isAllFollowUpUnlocked()" @click="openBundlePayment">
												<text class="btn-text">
													{{ locale === 'en' ? 'Unlock all ' : '一次解锁全部 ' }}{{ getBundlePriceLabel() }}
												</text>
											</button>
										</view>
									</view>
								</view>

								<view class="followup-panel" v-if="activeFollowUpModuleId === 'health'">
									<view class="followup-panel-head">
										<view class="followup-card-title-block">
											<text class="followup-card-title">{{ getFollowUpModuleTitle('health') }}</text>
											<text class="followup-card-desc">{{ getFollowUpModuleDesc('health') }}</text>
										</view>
										<text class="followup-card-price">{{ getFollowUpModulePriceLabel('health') }}</text>
									</view>

									<view class="followup-answer-box" v-if="getFollowUpAnswer('health')">
										<text class="followup-answer-title">{{ ui.followUpAnswerTitle }}</text>
										<text class="followup-answer-text">{{ getFollowUpAnswerText('health') }}</text>
										<text class="followup-answer-hint">{{ ui.followUpAnswerHint }}</text>
									</view>

									<view class="followup-generating" v-else-if="isFollowUpGenerating('health')">
										<view class="followup-spinner"></view>
										<text class="followup-generating-title">{{ locale === 'en' ? 'Generating deep reading' : '正在生成深度解读' }}</text>
										<text class="followup-generating-desc">{{ locale === 'en' ? 'The AI is reading this module based on your palm.' : 'AI 正在结合你的手相重新推演这个模块。' }}</text>
									</view>

									<view class="followup-locked-panel" v-else>
										<view class="followup-preview-blur">
											<text class="followup-preview-text">{{ getFollowUpModulePreview('health') }}</text>
											<text class="followup-preview-text">
												{{ locale === 'en'
													? 'The full reading includes why this pattern appears, what it means, practical next steps, and the risks to avoid.'
													: '完整内容会继续展开：为什么这么判断、解读出来的结果、应对策略，以及你最需要避开的风险。' }}
											</text>
										</view>
										<view class="followup-lock-overlay">
											<button class="followup-unlock-btn" @click="openFollowUpPaymentById('health')">
												<text class="btn-text">
													{{ locale === 'en' ? 'Unlock this module ' : '解锁当前模块 ' }}{{ getFollowUpModulePriceLabel('health') }}
												</text>
											</button>
											<button class="followup-unlock-btn bundle-btn" v-if="!isAllFollowUpUnlocked()" @click="openBundlePayment">
												<text class="btn-text">
													{{ locale === 'en' ? 'Unlock all ' : '一次解锁全部 ' }}{{ getBundlePriceLabel() }}
												</text>
											</button>
										</view>
									</view>
								</view>
							</view>
						</view>
						
						<view class="result-actions">
							<button class="result-btn btn-primary" @click="handleDownloadReport">{{ ui.downloadReport }}</button>
							<button class="result-btn btn-secondary" @click="handleReset">{{ ui.retakePhoto }}</button>
						</view>

						<!-- 微信引流弹窗：玄学大师版文案 -->
						<view class="wechat-mask" v-if="showWechatDialog">
							<view class="wechat-dialog">
								<text class="wechat-title">{{ ui.wechatTitle }}</text>
								<image class="wechat-qrcode" src="/static/wechact.jpg" mode="widthFix" />
								<text class="wechat-desc">{{ ui.wechatDesc }}</text>
								<button class="wechat-close-btn" @click="showWechatDialog = false">
									<text class="btn-text">{{ ui.wechatOk }}</text>
								</button>
							</view>
						</view>
					</view>
				</scroll-view>
			</view>

			<!-- 分析中状态 -->
			<view class="analyzing-area" v-else-if="isAnalyzing">
				<view class="scan-animation-container">
					<image class="scan-hand-bg" src="@/static/hand.png" :class="{ 'mirror': handSide === 'right' }" mode="aspectFit"></image>
					<view class="scan-line"></view>
					<view class="scan-glow"></view>
					<!-- 扫描时的术语显示 -->
					<view class="scan-term-overlay">
						<text class="scan-term-text">{{ dynamicScanText }}</text>
					</view>
				</view>
				<view class="analyzing-content">
					<text class="analyzing-text">{{ ui.analyzingMain }}</text>
					<text class="analyzing-patience-hint">{{ ui.analyzingPatienceHint }}</text>
					<text class="analyzing-status">{{ analyzingStatus }}</text>
				</view>
			</view>

			<!-- 预览区域 -->
			<view class="preview-area" v-else-if="capturedImage">
				<view 
					class="preview-container"
					@touchstart.prevent="handleTouchStart"
					@touchmove.prevent="handleTouchMove"
					@touchend.prevent="handleTouchEnd"
					@mousedown="handleMouseDown"
					@mousemove="handleMouseMove"
					@mouseup="handleMouseUp"
					@mouseleave="handleMouseUp"
				>
					<!-- 用户上传的图片（底层，可缩放拖拽） -->
					<view 
						class="image-wrapper"
						:style="{
							transform: `translate(${imageOffsetX}rpx, ${imageOffsetY}rpx) scale(${imageScale})`,
							transition: isMoving || isScaling ? 'none' : 'transform 0.1s ease-out'
						}"
					>
						<image 
							class="preview-image" 
							:src="capturedImage" 
							mode="aspectFit"
						></image>
					</view>
					<!-- 手形轮廓图（上层，固定） -->
					<view class="hand-overlay">
						<image 
							class="hand-image" 
							:class="{ 'mirror': handSide === 'right' }"
							src="@/static/hand.png" 
							mode="aspectFit"
						></image>
					</view>
					<!-- 缩放控制按钮 -->
					<view class="scale-controls" @touchstart.stop @mousedown.stop>
						<button class="scale-btn" @click.stop="zoomIn">
							<text class="scale-icon">+</text>
						</button>
						<button class="scale-btn" @click.stop="zoomOut">
							<text class="scale-icon">−</text>
						</button>
						<button class="scale-btn reset-btn" @click.stop="resetTransform">
							<text class="scale-icon">↺</text>
						</button>
					</view>
				</view>
				<view class="preview-actions">
					<button class="action-btn btn-cancel" @click="handleCancel">{{ ui.previewRetake }}</button>
					<button class="action-btn btn-confirm" @click="handleConfirm">{{ ui.previewConfirm }}</button>
				</view>
			</view>

			<!-- 引导区域 -->
			<view class="guide-area" v-else>
				<view class="guide-box">
					<view class="hand-outline">
						<image 
							class="hand-image" 
							:class="{ 'mirror': handSide === 'right' }"
							src="@/static/hand.png" 
							mode="aspectFit"
						></image>
					</view>
					<text class="guide-text">{{ handSide === 'left' ? ui.guideLeft : ui.guideRight }}</text>
				</view>
			</view>
		</view>

		<view class="camera-footer" v-if="!reportData">
			<button class="camera-btn" @click="handleTakePhoto">
				<text class="btn-text">{{ capturedImage ? ui.previewRetake : ui.footerPhoto }}</text>
			</button>
			<button class="album-btn" @click="handleChooseFromAlbum">
				<text class="btn-text">{{ ui.footerAlbum }}</text>
			</button>
			<view class="policy-links">
				<text class="policy-link" @click="openPolicyPage('/static/pricing.html')">Pricing</text>
				<text class="policy-separator">|</text>
				<text class="policy-link" @click="openPolicyPage('/static/terms.html')">Terms</text>
				<text class="policy-separator">|</text>
				<text class="policy-link" @click="openPolicyPage('/static/privacy.html')">Privacy</text>
				<text class="policy-separator">|</text>
				<text class="policy-link" @click="openPolicyPage('/static/refund.html')">Refund</text>
			</view>
		</view>
	</view>

		<!-- 追问模块支付弹窗：只用于后续追问，不再拦截首个免费报告 -->
		<view class="payment-mask" v-if="showPaymentDialog">
			<view class="payment-dialog">
				<text class="payment-title">{{ ui.paymentTitle }}</text>
				<text class="payment-desc">{{ ui.paymentDesc }}</text>
				<view class="payment-topic" v-if="paymentSummaryLabel">
					<text class="payment-topic-label">{{ locale === 'en' ? 'Module' : '追问模块' }}</text>
					<text class="payment-topic-name">{{ paymentSummaryLabel }}</text>
				</view>
				<view class="payment-method-tabs">
					<button
						class="payment-method-tab"
						:class="{ active: paymentMethod === 'paypal' }"
						@click="selectPaymentMethod('paypal')"
					>
						<text class="payment-method-text">{{ ui.paymentPayPalTab }}</text>
					</button>
					<button
						class="payment-method-tab"
						:class="{ active: paymentMethod === 'alipay' }"
						@click="selectPaymentMethod('alipay')"
					>
						<text class="payment-method-text">{{ ui.paymentAlipayTab }}</text>
					</button>
				</view>

				<view class="paypal-panel" v-if="paymentMethod === 'paypal'">
					<text class="payment-price">US$ {{ paymentPrice }}</text>
					<view v-if="paymentLoading" class="payment-loading">
						<text class="payment-loading-text">{{ ui.paymentLoading }}</text>
					</view>
					<view id="paypal-button-container" class="paypal-button-host" v-show="!paymentLoading"></view>
				</view>

				<view class="alipay-panel" v-if="paymentMethod === 'alipay'">
					<text class="alipay-title">{{ ui.alipayTitle }}</text>

					<view class="alipay-pay-block" v-if="!paymentTestMode">
						<view v-if="paymentOrderStatus === 'creating'" class="alipay-pay-loading">
							<text class="alipay-pay-loading-text">{{ ui.alipayOrderCreating }}</text>
						</view>
						<view v-else-if="alipayPrice.length > 0">
							<text class="alipay-pay-label">{{ ui.alipayUniqueBadge }}</text>
							<view class="alipay-amount-row">
								<text class="alipay-hero-amount">¥{{ alipayPrice }}</text>
								<button class="alipay-copy-btn" @click="copyUniquePaymentAmount">
									<text class="alipay-copy-text">{{ ui.alipayCopyAmount }}</text>
								</button>
							</view>
							<text class="alipay-pay-hint">{{ ui.alipayUniquePayHint }}</text>
							<text class="alipay-pay-sub">{{ getAlipayListedPriceHint() }}</text>
							<view
								class="alipay-countdown-row"
								v-if="paymentOrderStatus === 'pending' && paymentExpiresAt > 0"
							>
								<text class="alipay-countdown-label">{{ ui.alipayCountdownLabel }}</text>
								<text class="alipay-countdown-time">{{ paymentCountdownText }}</text>
							</view>
							<text
								class="alipay-countdown-hint"
								v-if="paymentOrderStatus === 'pending' && paymentExpiresAt > 0"
							>
								{{ ui.alipayCountdownHint }}
							</text>
						</view>
					</view>

					<image class="alipay-qr" :src="alipayQrCode" mode="widthFix"></image>

					<text class="alipay-notice">{{ getAlipayStatusText() }}</text>
					<text class="alipay-meta" v-if="paymentOrderId && !paymentTestMode">
						{{ ui.alipayOrderLabel }}: {{ paymentOrderId }}
					</text>
					<text class="alipay-meta" v-if="!paymentTestMode">{{ ui.alipayEmailLabel }}: {{ supportEmail }}</text>

					<button
						v-if="paymentTestMode"
						class="alipay-paid-btn"
						@click="confirmAlipayTestUnlock"
					>
						<text class="btn-text">{{ ui.alipayTestUnlockButton }}</text>
					</button>
				</view>

				<button class="payment-cancel-btn" @click="closePaymentDialog">
					<text class="btn-text">{{ ui.paymentCancel }}</text>
				</button>
			</view>
		</view>

		<app-tab-bar current="palm"></app-tab-bar>
</view>
</template>

<script lang="uts">
	import AppTabBar from '@/components/app-tab-bar/app-tab-bar.uvue';
	import type {
		PalmistryReport,
		ReportResult,
		PalmistryAnalysisResult,
		DimensionDetail,
		FollowUpModule,
		FollowUpPack,
		FollowUpAnswerRecord,
		ActiveReportSnapshot
	} from '@/types/index';
	import { analyzePalmistry, analyzeFollowUpReading } from '@/utils/qwenApi';
	import {
		convertImageToBase64ForApi,
		resolveImageForApi,
		isApiReadyImage,
		isEphemeralImagePath
	} from '@/utils/imageHelper';
	import { getOrderedDimensionKeys as orderDimensionKeys } from '@/utils/dimensionHelper';
	import { PAYMENT_CONFIG } from '@/utils/paymentConfig';
	import { createPaymentOrder, fetchPaymentOrder } from '@/utils/paymentApi';
	import {
		saveActiveReportSnapshot,
		loadActiveReportSnapshot,
		clearActiveReportSnapshot,
		loadFollowUpAnswers,
		saveFollowUpAnswer,
		clearFollowUpAnswers
	} from '@/utils/sessionStore';
	import {
		loadPayPalSdk,
		renderPayPalButtons,
		clearPayPalButtonContainer
	} from '@/utils/paypalPayment';
	import {
		getAppLocale,
		setAppLocale,
		getCameraUi,
		pickLocaleText,
		type AppLocale,
		SCAN_TERMS_ZH,
		SCAN_TERMS_EN
	} from '@/utils/locale';

	type HandSide = 'left' | 'right';
	type PaymentMethod = 'paypal' | 'alipay';
	type PaymentTarget = 'followup';

	interface CameraPageData {
		locale: AppLocale;
		capturedImage: string | null;
		handSide: HandSide;
		gender: 'male' | 'female';
		imageScale: number;
		imageOffsetX: number;
		imageOffsetY: number;
		lastTouchDistance: number;
		lastTouchX: number;
		lastTouchY: number;
		isMoving: boolean;
		isScaling: boolean;
		// 新增字段
		isAnalyzing: boolean;
		analyzingStatus: string;
		dynamicScanText: string; // 新增：动态扫描文字
		reportData: PalmistryReport | null;
		// 新增：当前选中的交互线条类型
		selectedLine: string | null;
		reportSessionId: string;
		followUpModules: FollowUpModule[];
		followUpBundle: FollowUpPack;
		followUpAnswers: FollowUpAnswerRecord[];
		activeFollowUpModuleId: string;
		followUpGeneratingModuleId: string;
		pendingFollowUpModule: FollowUpModule | null;
		paymentTarget: PaymentTarget | null;
		paymentSummaryLabel: string;
		// 下载报告引流弹窗
		showWechatDialog: boolean;
		// PayPal 支付弹窗
		showPaymentDialog: boolean;
		paymentLoading: boolean;
		paymentPrice: string;
		alipayPrice: string;
		alipayQrCode: string;
		supportEmail: string;
		paymentMethod: PaymentMethod;
		manualPaymentCode: string;
		paymentOrderId: string;
		paymentOrderStatus: string;
		paymentDisplayPrice: string;
		paymentExpiresAt: number;
		paymentPollTimer: number | null;
		paymentCountdownTimer: number | null;
		countdownTick: number;
		paymentTestMode: boolean;
	}

	export default {
		name: 'CameraPage',
		components: {
			AppTabBar
		},
		data(): CameraPageData {
			return {
				locale: getAppLocale(),
				capturedImage: null,
				handSide: 'left', // 默认左手
				gender: 'male', // 默认男性
				imageScale: 1.0, // 图片缩放比例
				imageOffsetX: 0, // 图片X轴偏移
				imageOffsetY: 0, // 图片Y轴偏移
				lastTouchDistance: 0, // 上次触摸距离（用于缩放）
				lastTouchX: 0, // 上次触摸X坐标（用于拖拽）
				lastTouchY: 0, // 上次触摸Y坐标（用于拖拽）
				isMoving: false, // 是否正在移动
				isScaling: false, // 是否正在缩放
				// 新增字段初始化
				isAnalyzing: false,
				analyzingStatus: '准备中...',
				dynamicScanText: '',
				reportData: null,
				selectedLine: 'life', // 默认选中生命线
				reportSessionId: '',
				followUpModules: [
					{
						id: 'love',
						title: '情缘深度解读',
						titleEn: 'Love deep reading',
						description: '解读关系节奏、相处模式、桃花窗口和感情避坑。',
						descriptionEn: 'Read relationship timing, emotional patterns, and love risks.',
						previewText: '你的感情线并不是单纯的顺或不顺，而是呈现出一种先热后审、外柔内防的关系模式。掌纹里的细小分叉说明你在感情里容易一边期待亲密，一边又会用理性反复确认安全感。接下来的情缘重点不是有没有人出现，而是你能不能识别真正稳定的人，以及避开只给情绪刺激却不给现实承诺的关系。',
						previewTextEn: 'Your heart line does not simply show good or bad luck. It points to a pattern of warm attraction followed by careful testing. The small branches suggest that you want closeness but also need repeated signs of emotional safety. The next love focus is not whether someone appears, but whether you can identify stable affection and avoid relationships that offer intensity without commitment.',
						priceUsd: PAYMENT_CONFIG.priceUsd,
						priceCny: PAYMENT_CONFIG.priceCny,
						prompt: '请结合当前报告，围绕关系节奏、相处方式、沟通模式、遇到合适对象的窗口、避免烂桃花，给出爱情深度解读。',
						promptEn: 'Based on the current report, give a deep love reading about relationship timing, communication patterns, suitable partners, and emotional risks.'
					},
					{
						id: 'career',
						title: '事业财运深度解读',
						titleEn: 'Career and wealth deep reading',
						description: '解读上升路径、机会选择、财运节奏和事业避坑。',
						descriptionEn: 'Read career direction, opportunity timing, wealth rhythm, and work risks.',
						previewText: '你的事业线显示出来的不是没有机会，而是机会往往伴随压力和选择成本。智慧线与命运线之间的呼应说明你适合靠判断力、执行力和阶段性积累打开局面，而不是频繁换方向。事业财运的关键在于先做出一个能被看见的结果，再谈更大的跳跃，否则容易出现忙了很多却没有沉淀的情况。',
						previewTextEn: 'Your fate line does not suggest a lack of opportunity. It suggests that opportunities often come with pressure and decision costs. The link between head line and fate line points to progress through judgment, execution, and accumulated proof rather than constant switching. Your career and wealth path depends on creating visible results before making larger moves.',
						priceUsd: PAYMENT_CONFIG.priceUsd,
						priceCny: PAYMENT_CONFIG.priceCny,
						prompt: '请结合当前报告，围绕工作选择、跳槽或转岗时机、上升路径、执行节奏、贵人阻力、财运节奏和避坑，给出事业财运深度解读。',
						promptEn: 'Based on the current report, give a deep career and wealth reading about work choices, timing, growth path, execution rhythm, support, resistance, and risks.'
					},
					{
						id: 'health',
						title: '身心能量深度解读',
						titleEn: 'Mind and body energy deep reading',
						description: '解读压力、睡眠、体力消耗、作息和身心修复策略。',
						descriptionEn: 'Read stress, sleep, energy drain, routines, and recovery strategy.',
						previewText: '你的生命线和掌丘状态更像是在提醒你：问题不是短期有没有大病，而是长期消耗之后恢复速度会变慢。掌纹中的细碎纹路通常对应压力累积、睡眠质量和情绪负荷。身心能量的重点不是制造焦虑，而是看清你在哪些习惯上持续透支，以及如何把作息、运动、饮食和体检节奏重新拉回稳定。',
						previewTextEn: 'Your life line and mounts read more like a warning about long-term depletion than an immediate illness. Fine stress lines often point to accumulated pressure, sleep quality, and emotional load. The focus is not fear, but recognizing where daily habits drain your energy and how to rebuild rhythm through sleep, movement, food, and checkups.',
						priceUsd: PAYMENT_CONFIG.priceUsd,
						priceCny: PAYMENT_CONFIG.priceCny,
						prompt: '请结合当前报告，围绕压力、睡眠、体力消耗、作息、体检、生活习惯调整和身心修复，给出身心能量深度解读。',
						promptEn: 'Based on the current report, give a deep mind and body energy reading about stress, sleep, energy drain, routines, checkups, and recovery.'
					}
				],
				followUpBundle: {
					id: 'all',
					title: '全部解锁',
					titleEn: 'Unlock all',
					description: '一次性解锁爱情、事业、健康三个模块，适合想要完整建议的用户。',
					descriptionEn: 'Unlock love, career, and health in one purchase.',
					priceUsd: PAYMENT_CONFIG.bundlePriceUsd,
					priceCny: PAYMENT_CONFIG.bundlePriceCny,
					moduleIds: ['love', 'career', 'health']
				},
				followUpAnswers: [],
				activeFollowUpModuleId: 'love',
				followUpGeneratingModuleId: '',
				pendingFollowUpModule: null,
				paymentTarget: null,
				paymentSummaryLabel: '',
				showWechatDialog: false,
				showPaymentDialog: false,
				paymentLoading: false,
				paymentPrice: PAYMENT_CONFIG.priceUsd,
				alipayPrice: PAYMENT_CONFIG.priceCny,
				alipayQrCode: PAYMENT_CONFIG.alipayQrCode,
				supportEmail: PAYMENT_CONFIG.supportEmail,
				paymentMethod: 'paypal',
				manualPaymentCode: '',
				paymentOrderId: '',
				paymentOrderStatus: '',
				paymentDisplayPrice: '',
				paymentExpiresAt: 0,
				paymentPollTimer: null,
				paymentCountdownTimer: null,
				countdownTick: 0,
				paymentTestMode: PAYMENT_CONFIG.testMode
			};
		},
		computed: {
			/** 当前语言下的界面文案 */
			ui(): Record<string, string> {
				return getCameraUi(this.locale);
			},
			/** 支付倒计时 mm:ss */
			paymentCountdownText(): string {
				void this.countdownTick;
				return this.getPaymentCountdownText();
			},
			/**
			 * 线条 Tab 配置
			 */
			handTabs(): Array<Record<string, string>> {
				if (this.locale === 'en') {
					return [
						{ id: 'life', name: 'Life Line' },
						{ id: 'wisdom', name: 'Head Line' },
						{ id: 'emotion', name: 'Heart Line' },
						{ id: 'fate', name: 'Fate Line' }
					];
				}
				return [
					{ id: 'life', name: '生命线' },
					{ id: 'wisdom', name: '智慧线' },
					{ id: 'emotion', name: '感情线' },
					{ id: 'fate', name: '命运线' }
				];
			},
			/**
			 * 获取当前选中线条的详细信息
			 */
			selectedLineInfo(): ReportResult | null {
				if (!this.reportData || !this.selectedLine) return null;
				
				const typeMap: Record<string, string> = {
					'life': '生命线',
					'wisdom': '智慧线',
					'emotion': '感情线',
					'fate': '命运线'
				};
				
				const targetTypeName = typeMap[this.selectedLine];
				for (let i = 0; i < this.reportData.results.length; i += 1) {
					const item = this.reportData.results[i];
					if (item.type === targetTypeName) {
						return item;
					}
				}
				return null;
			},
			/** 按 Tab 顺序排列的全部掌纹线评分 */
			orderedLineResults(): ReportResult[] {
				if (!this.reportData || this.reportData.results.length === 0) {
					return [];
				}
				const order = ['生命线', '智慧线', '感情线', '命运线'];
				const ordered: ReportResult[] = [];
				for (let i = 0; i < order.length; i += 1) {
					const typeName = order[i];
					for (let j = 0; j < this.reportData!.results.length; j += 1) {
						const item = this.reportData!.results[j];
						if (item.type === typeName) {
							ordered.push(item);
							break;
						}
					}
				}
				return ordered.length > 0 ? ordered : this.reportData.results;
			}
		},
		onLoad(options: Record<string, any>) {
			console.log('拍照页面加载', options);
			this.syncLocaleFromStorage();
			this.restoreActiveReportSnapshot();
			this.ensureDefaultSelectedLine();
		},
		onShow() {
			this.syncLocaleFromStorage();
		},
		methods: {
			openPolicyPage(path: string): void {
				// #ifdef H5
				const g = globalThis as any;
				if (g.window) {
					g.window.open(path, '_blank');
				}
				// #endif

				// #ifndef H5
				uni.showToast({
					title: path,
					icon: 'none'
				});
				// #endif
			},
			applyNavTitle(): void {
				const t = getCameraUi(this.locale).navTitle;
				uni.setNavigationBarTitle({ title: t });
			},
			syncLocaleFromStorage(): void {
				const saved = getAppLocale();
				if (this.locale !== saved) {
					this.locale = saved;
				}
				this.applyNavTitle();
			},
			setLocale(next: AppLocale): void {
				if (this.locale === next) {
					return;
				}
				this.locale = next;
				setAppLocale(next);
				this.applyNavTitle();
				if (this.reportData != null) {
					this.persistActiveReportSnapshot();
				}
			},
			pickTxt(zhText: string, enText?: string | null): string {
				return pickLocaleText(this.locale, zhText, enText);
			},
			dimTitle(dim: DimensionDetail): string {
				return pickLocaleText(this.locale, dim.title, dim.titleEn);
			},
			dimContent(dim: DimensionDetail): string {
				return pickLocaleText(this.locale, dim.content, dim.contentEn);
			},
			/**
			 * 切换手（左/右）
			 */
			switchHand(side: HandSide): void {
				this.handSide = side;
				console.log('切换手:', side);
			},
			
			/**
			 * 获取维度图标路径
			 */
			getDimensionIcon(key: string): string {
				const icons: Record<string, string> = {
					'handType': '/static/命格.png',
					'palmMounds': '/static/命格.png',
					'specialMarks': '/static/命格.png',
					'personality': '/static/命格.png',
					'career': '/static/事业.png',
					'love': '/static/感情.png',
					'health': '/static/健康.png',
					'wealth': '/static/财富.png',
					'recentLuck': '/static/命格.png'
				};
				return icons[key] || '/static/命格.png';
			},

			getOrderedDimensionKeys(dimensions: Record<string, DimensionDetail> | null | undefined): string[] {
				return orderDimensionKeys(dimensions);
			},

				/**
				 * 拍照
				 */
			handleTakePhoto(): void {
				uni.chooseImage({
					count: 1,
					sizeType: ['compressed'],
					sourceType: ['camera'],
					success: (res) => {
						if (res.tempFilePaths && res.tempFilePaths.length > 0) {
							this.capturedImage = res.tempFilePaths[0];
							console.log('拍照成功', res.tempFilePaths[0]);
						}
					},
					fail: (error) => {
						console.error('拍照失败', error);
						uni.showToast({
							title: '拍照失败，请重试',
							icon: 'none'
						});
					}
				});
			},

			/**
			 * 从相册选择
			 */
			handleChooseFromAlbum(): void {
				uni.chooseImage({
					count: 1,
					sizeType: ['compressed'],
					sourceType: ['album'],
					success: (res) => {
						if (res.tempFilePaths && res.tempFilePaths.length > 0) {
							this.capturedImage = res.tempFilePaths[0];
							console.log('选择图片成功', res.tempFilePaths[0]);
						}
					},
					fail: (error) => {
						console.error('选择图片失败', error);
						uni.showToast({
							title: '选择图片失败，请重试',
							icon: 'none'
						});
					}
				});
			},

			/**
			 * 取消/重新拍照
			 */
			handleCancel(): void {
				this.capturedImage = null;
				this.reportData = null;
				// 重置图片变换参数
				this.imageScale = 1.0;
				this.imageOffsetX = 0;
				this.imageOffsetY = 0;
			},

			/**
			 * 触摸开始
			 */
			handleTouchStart(e: any): void {
				// 检查是否点击在按钮上
				const target = e.target || e.currentTarget;
				if (target && (target.classList && (target.classList.contains('scale-btn') || target.closest('.scale-controls')))) {
					return; // 如果点击的是按钮，不处理拖拽
				}
				e.preventDefault && e.preventDefault();
				const touches = e.touches || [];
				if (touches.length === 1) {
					// 单指拖拽
					this.isMoving = true;
					this.isScaling = false;
					const touch = touches[0];
					this.lastTouchX = touch.clientX || touch.x || 0;
					this.lastTouchY = touch.clientY || touch.y || 0;
				} else if (touches.length === 2) {
					// 双指缩放
					this.isMoving = false;
					this.isScaling = true;
					const touch1 = touches[0];
					const touch2 = touches[1];
					const x1 = touch1.clientX || touch1.x || 0;
					const y1 = touch1.clientY || touch1.y || 0;
					const x2 = touch2.clientX || touch2.x || 0;
					const y2 = touch2.clientY || touch2.y || 0;
					const distance = Math.sqrt(
						Math.pow(x2 - x1, 2) + 
						Math.pow(y2 - y1, 2)
					);
					this.lastTouchDistance = distance;
				}
			},

			/**
			 * 触摸移动
			 */
			handleTouchMove(e: any): void {
				e.preventDefault && e.preventDefault();
				const touches = e.touches || [];
				if (touches.length === 1 && this.isMoving) {
					// 单指拖拽
					const touch = touches[0];
					const currentX = touch.clientX || touch.x || 0;
					const currentY = touch.clientY || touch.y || 0;
					const deltaX = (currentX - this.lastTouchX) * 2; // 转换为rpx
					const deltaY = (currentY - this.lastTouchY) * 2;
					this.imageOffsetX += deltaX;
					this.imageOffsetY += deltaY;
					this.lastTouchX = currentX;
					this.lastTouchY = currentY;
				} else if (touches.length === 2) {
					// 双指缩放
					this.isMoving = false;
					this.isScaling = true;
					const touch1 = touches[0];
					const touch2 = touches[1];
					const x1 = touch1.clientX || touch1.x || 0;
					const y1 = touch1.clientY || touch1.y || 0;
					const x2 = touch2.clientX || touch2.x || 0;
					const y2 = touch2.clientY || touch2.y || 0;
					const distance = Math.sqrt(
						Math.pow(x2 - x1, 2) + 
						Math.pow(y2 - y1, 2)
					);
					if (this.lastTouchDistance > 0) {
						const scaleChange = distance / this.lastTouchDistance;
						let newScale = this.imageScale * scaleChange;
						// 限制缩放范围 0.5 - 3.0
						newScale = Math.max(0.5, Math.min(3.0, newScale));
						this.imageScale = newScale;
					}
					this.lastTouchDistance = distance;
				}
			},

			/**
			 * 触摸结束
			 */
			handleTouchEnd(e: any): void {
				e.preventDefault && e.preventDefault();
				this.isMoving = false;
				this.isScaling = false;
				this.lastTouchDistance = 0;
			},

			/**
			 * 鼠标按下（PC端拖拽）
			 */
			handleMouseDown(e: any): void {
				// 检查是否点击在按钮上
				const target = e.target || e.currentTarget;
				if (target && (target.classList && (target.classList.contains('scale-btn') || target.closest('.scale-controls')))) {
					return; // 如果点击的是按钮，不处理拖拽
				}
				// 只在PC端且没有触摸时处理鼠标事件
				if (e.touches && e.touches.length > 0) {
					return;
				}
				this.isMoving = true;
				this.isScaling = false;
				this.lastTouchX = e.clientX || e.x || 0;
				this.lastTouchY = e.clientY || e.y || 0;
			},

			/**
			 * 鼠标移动（PC端拖拽）
			 */
			handleMouseMove(e: any): void {
				// 只在PC端且没有触摸时处理鼠标事件
				if (e.touches && e.touches.length > 0) {
					return;
				}
				if (this.isMoving) {
					const currentX = e.clientX || e.x || 0;
					const currentY = e.clientY || e.y || 0;
					const deltaX = (currentX - this.lastTouchX) * 2; // 转换为rpx
					const deltaY = (currentY - this.lastTouchY) * 2;
					this.imageOffsetX += deltaX;
					this.imageOffsetY += deltaY;
					this.lastTouchX = currentX;
					this.lastTouchY = currentY;
				}
			},

			/**
			 * 鼠标释放（PC端拖拽）
			 */
			handleMouseUp(): void {
				this.isMoving = false;
				this.isScaling = false;
			},

			/**
			 * 放大图片
			 */
			zoomIn(e?: any): void {
				if (e) {
					e.preventDefault && e.preventDefault();
					e.stopPropagation && e.stopPropagation();
				}
				console.log('放大前:', this.imageScale);
				let newScale = this.imageScale + 0.2;
				newScale = Math.min(3.0, newScale);
				this.imageScale = newScale;
				console.log('放大后:', this.imageScale);
			},

			/**
			 * 缩小图片
			 */
			zoomOut(e?: any): void {
				if (e) {
					e.preventDefault && e.preventDefault();
					e.stopPropagation && e.stopPropagation();
				}
				console.log('缩小前:', this.imageScale);
				let newScale = this.imageScale - 0.2;
				newScale = Math.max(0.5, newScale);
				this.imageScale = newScale;
				console.log('缩小后:', this.imageScale);
			},

			/**
			 * 选中手相线条
			 */
			selectHandLine(lineType: string): void {
				this.selectedLine = lineType;
				console.log('切换选中线条:', lineType);
			},

			/**
			 * 确保 Tab id 合法，刷新后默认生命线
			 */
			ensureDefaultSelectedLine(): void {
				const validIds = ['life', 'wisdom', 'emotion', 'fate'];
				let matched = false;
				for (let i = 0; i < validIds.length; i += 1) {
					if (this.selectedLine === validIds[i]) {
						matched = true;
						break;
					}
				}
				if (!matched) {
					this.selectedLine = 'life';
				}
			},

			/**
			 * 重置图片变换
			 */
			resetTransform(e?: any): void {
				if (e) {
					e.preventDefault && e.preventDefault();
					e.stopPropagation && e.stopPropagation();
				}
				console.log('重置前:', { scale: this.imageScale, x: this.imageOffsetX, y: this.imageOffsetY });
				this.imageScale = 1.0;
				this.imageOffsetX = 0;
				this.imageOffsetY = 0;
				console.log('重置后:', { scale: this.imageScale, x: this.imageOffsetX, y: this.imageOffsetY });
			},

			/**
			 * 确认使用当前图片：首个报告免费，直接进入分析
			 */
			handleConfirm(): void {
				if (!this.capturedImage) {
					uni.showToast({
						title: getCameraUi(this.locale).toastNeedPhoto,
						icon: 'none'
					});
					return;
				}
				this.runAnalysis();
			},

			/**
			 * 创建报告会话 ID
			 */
			createReportSessionId(): string {
				const now = new Date();
				const year = now.getFullYear();
				const month = this.formatNumber(now.getMonth() + 1);
				const day = this.formatNumber(now.getDate());
				const hours = this.formatNumber(now.getHours());
				const minutes = this.formatNumber(now.getMinutes());
				const seconds = this.formatNumber(now.getSeconds());
				const random = Math.floor(1000 + Math.random() * 9000);
				return `RP${year}${month}${day}-${hours}${minutes}${seconds}-${random}`;
			},

			/**
			 * 载入本地保存的报告快照和追问结果
			 */
			restoreActiveReportSnapshot(): void {
				try {
					const snapshot = loadActiveReportSnapshot();
					if (!snapshot) {
						return;
					}

					this.reportSessionId = snapshot.sessionId;
					this.gender = snapshot.gender;
					this.handSide = snapshot.handSide;
					// 语言以 app_locale 为准，不用快照里的旧 locale 覆盖用户选择

					let restoredImage = snapshot.capturedImage;
					const snapshotReportImage = snapshot.reportData != null ? snapshot.reportData.imagePath : '';
					if (isApiReadyImage(snapshotReportImage)) {
						restoredImage = snapshotReportImage;
					} else if (isEphemeralImagePath(restoredImage || '')) {
						restoredImage = null;
					}
					this.capturedImage = restoredImage;

					if (snapshot.reportData) {
						this.reportData = snapshot.reportData;
						if (isApiReadyImage(restoredImage || '')) {
							this.reportData.imagePath = restoredImage as string;
						}
						this.selectedLine = 'life';
						this.followUpAnswers = loadFollowUpAnswers(snapshot.sessionId);
						this.isAnalyzing = false;
						console.log('已恢复报告快照:', snapshot.sessionId);
					}
				} catch (error) {
					console.error('恢复报告快照失败', error);
				}
			},

			/**
			 * 保存当前报告快照，便于刷新后继续查看追问答案
			 */
			persistActiveReportSnapshot(): void {
				if (!this.reportData || !this.reportSessionId) {
					return;
				}

				const imageToSave = isApiReadyImage(this.capturedImage || '')
					? (this.capturedImage as string)
					: (isApiReadyImage(this.reportData.imagePath || '') ? this.reportData.imagePath : '');

				const reportDataForSnapshot = {
					...this.reportData,
					imagePath: imageToSave || this.reportData.imagePath
				};

				const snapshot: ActiveReportSnapshot = {
					sessionId: this.reportSessionId,
					capturedImage: imageToSave || this.capturedImage || '',
					gender: this.gender,
					handSide: this.handSide,
					locale: this.locale,
					reportData: reportDataForSnapshot,
					createdAt: new Date().toISOString()
				};
				saveActiveReportSnapshot(snapshot);
				this.followUpAnswers = loadFollowUpAnswers(this.reportSessionId);
			},

			/**
			 * @deprecated 旧版人工备注码，支付闭环改用后端 orderId
			 */
			createManualPaymentCode(): string {
				const now = new Date();
				const year = now.getFullYear();
				const month = this.formatNumber(now.getMonth() + 1);
				const day = this.formatNumber(now.getDate());
				const random = Math.floor(100000 + Math.random() * 900000);
				return `CN${year}${month}${day}-${random}`;
			},

			switchFollowUpTab(moduleId: string): void {
				this.activeFollowUpModuleId = moduleId;
			},

			getFollowUpTabLabel(module: FollowUpModule): string {
				if (this.locale === 'en') {
					if (module.id === 'love') return 'Love';
					if (module.id === 'career') return 'Career';
					if (module.id === 'health') return 'Health';
					return module.titleEn || module.title;
				}
				if (module.id === 'love') return '爱情';
				if (module.id === 'career') return '事业';
				if (module.id === 'health') return '健康';
				return module.title;
			},

			getFollowUpModuleById(moduleId: string): FollowUpModule {
				for (let i = 0; i < this.followUpModules.length; i += 1) {
					const item = this.followUpModules[i];
					if (item.id === moduleId) {
						return item;
					}
				}
				return this.followUpModules[0] as FollowUpModule;
			},

			getFollowUpModuleTitle(moduleId: string): string {
				const module = this.getFollowUpModuleById(moduleId);
				return this.pickTxt(module.title, module.titleEn);
			},

			getFollowUpModuleDesc(moduleId: string): string {
				const module = this.getFollowUpModuleById(moduleId);
				return this.pickTxt(module.description, module.descriptionEn);
			},

			getFollowUpModulePreview(moduleId: string): string {
				const module = this.getFollowUpModuleById(moduleId);
				return this.pickTxt(module.previewText, module.previewTextEn);
			},

			getFollowUpModulePriceLabel(moduleId: string): string {
				return this.getFollowUpPriceLabel(this.getFollowUpModuleById(moduleId));
			},

			openFollowUpPaymentById(moduleId: string): void {
				this.openFollowUpPayment(this.getFollowUpModuleById(moduleId));
			},

			getFollowUpPriceLabel(module: FollowUpModule): string {
				return this.locale === 'zh' ? `¥${module.priceCny}` : `$${module.priceUsd}`;
			},

			getBundlePriceLabel(): string {
				return this.locale === 'zh' ? `¥${this.followUpBundle.priceCny}` : `$${this.followUpBundle.priceUsd}`;
			},

			isAllFollowUpUnlocked(): boolean {
				const unlockedIds = this.getUnlockedModuleIds();
				for (let i = 0; i < this.followUpBundle.moduleIds.length; i += 1) {
					const id = this.followUpBundle.moduleIds[i];
					let matched = false;
					for (let j = 0; j < unlockedIds.length; j += 1) {
						if (unlockedIds[j] === id) {
							matched = true;
							break;
						}
					}
					if (!matched) {
						return false;
					}
				}
				return true;
			},

			isFollowUpGenerating(moduleId: string): boolean {
				return this.followUpGeneratingModuleId === moduleId || this.followUpGeneratingModuleId === this.followUpBundle.id;
			},

			/**
			 * 打开追问模块支付
			 */
			openFollowUpPayment(module: FollowUpModule): void {
				if (!this.reportData) {
					uni.showToast({
						title: getCameraUi(this.locale).toastAnalyzeFirst,
						icon: 'none'
					});
					return;
				}

				this.pendingFollowUpModule = module;
				this.paymentTarget = 'followup';
				this.paymentSummaryLabel = this.pickTxt(module.title, module.titleEn);
				this.paymentPrice = module.priceUsd;
				this.alipayPrice = module.priceCny;
				this.paymentDisplayPrice = module.priceCny;
				this.alipayQrCode = PAYMENT_CONFIG.alipayQrCode;
				this.paymentOrderId = '';
				this.paymentOrderStatus = '';
				this.showPaymentDialog = true;
				clearPayPalButtonContainer('paypal-button-container');

				const canUsePayPal = PAYMENT_CONFIG.paypalClientId != null && PAYMENT_CONFIG.paypalClientId.length > 0;
				const preferredMethod: PaymentMethod = this.locale === 'zh' && PAYMENT_CONFIG.alipayEnabled
					? 'alipay'
					: (canUsePayPal ? 'paypal' : 'alipay');
				this.selectPaymentMethod(preferredMethod);
			},

			/**
			 * 打开全部解锁支付
			 */
			openBundlePayment(): void {
				if (!this.reportData) {
					uni.showToast({
						title: getCameraUi(this.locale).toastAnalyzeFirst,
						icon: 'none'
					});
					return;
				}

				this.pendingFollowUpModule = null;
				this.paymentTarget = 'followup';
				this.paymentSummaryLabel = this.pickTxt(this.followUpBundle.title, this.followUpBundle.titleEn);
				this.paymentPrice = this.followUpBundle.priceUsd;
				this.alipayPrice = this.followUpBundle.priceCny;
				this.paymentDisplayPrice = this.followUpBundle.priceCny;
				this.alipayQrCode = PAYMENT_CONFIG.alipayBundleQrCode;
				this.paymentOrderId = '';
				this.paymentOrderStatus = '';
				this.showPaymentDialog = true;
				clearPayPalButtonContainer('paypal-button-container');

				const canUsePayPal = PAYMENT_CONFIG.paypalClientId != null && PAYMENT_CONFIG.paypalClientId.length > 0;
				const preferredMethod: PaymentMethod = this.locale === 'zh' && PAYMENT_CONFIG.alipayEnabled
					? 'alipay'
					: (canUsePayPal ? 'paypal' : 'alipay');
				this.selectPaymentMethod(preferredMethod);
			},

			/**
			 * 获取某个追问模块的已保存答案
			 */
			getFollowUpAnswer(moduleId: string): FollowUpAnswerRecord | null {
				if (!this.reportSessionId) {
					return null;
				}
				for (let i = 0; i < this.followUpAnswers.length; i += 1) {
					const item = this.followUpAnswers[i];
					if (item.moduleId === moduleId) {
						return item;
					}
				}
				return null;
			},

			getFollowUpAnswerText(moduleId: string): string {
				const answer = this.getFollowUpAnswer(moduleId);
				if (!answer) {
					return '';
				}
				if (this.locale === 'en') {
					if (answer.answerEn != null && answer.answerEn.length > 0) {
						return answer.answerEn;
					}
					const fallback = this.getFollowUpDimensionFallback(moduleId);
					if (fallback != null && fallback.length > 0) {
						return fallback;
					}
				}
				return answer.answer;
			},

			getFollowUpDimensionFallback(moduleId: string): string | null {
				if (!this.reportData || !this.reportData.fullData || !this.reportData.fullData.dimensions) {
					return null;
				}
				const dim = this.reportData.fullData.dimensions[moduleId];
				if (!dim) {
					return null;
				}
				return this.pickTxt(dim.content, dim.contentEn);
			},

			/**
			 * 获取已解锁模块ID集合
			 */
			getUnlockedModuleIds(): string[] {
				const moduleIds: string[] = [];
				for (let i = 0; i < this.followUpAnswers.length; i += 1) {
					moduleIds.push(this.followUpAnswers[i].moduleId);
				}
				return moduleIds;
			},

			/**
			 * 获取追问报告摘要文本
			 */
			getFollowUpReportSummaryText(): string {
				if (!this.reportData || !this.reportData.fullData) {
					return this.locale === 'en' ? 'No base report summary yet.' : '暂无首报摘要。';
				}

				const summary = this.reportData.fullData.summary;
				const dimensions = this.reportData.fullData.dimensions;
				const selectedLineText = this.selectedLineInfo
					? this.pickTxt(this.selectedLineInfo.type, this.selectedLineInfo.typeEn)
					: (this.locale === 'en' ? 'No line selected' : '未选择线条');

				if (this.locale === 'en') {
					return [
						`Selected line: ${selectedLineText}`,
						`Life line: ${this.pickTxt(summary.lifeLine.dimension, summary.lifeLine.dimensionEn)} / ${this.pickTxt(summary.lifeLine.brief, summary.lifeLine.briefEn)}`,
						`Head line: ${this.pickTxt(summary.wisdomLine.dimension, summary.wisdomLine.dimensionEn)} / ${this.pickTxt(summary.wisdomLine.brief, summary.wisdomLine.briefEn)}`,
						`Heart line: ${this.pickTxt(summary.emotionLine.dimension, summary.emotionLine.dimensionEn)} / ${this.pickTxt(summary.emotionLine.brief, summary.emotionLine.briefEn)}`,
						`Fate line: ${this.pickTxt(summary.fateLine.dimension, summary.fateLine.dimensionEn)} / ${this.pickTxt(summary.fateLine.brief, summary.fateLine.briefEn)}`,
						`Overall: ${this.pickTxt(this.reportData.fullData.overallAnalysis, this.reportData.fullData.overallAnalysisEn)}`,
						`Tip: ${this.pickTxt(this.reportData.fullData.suggestions.tip, this.reportData.fullData.suggestions.tipEn)}`,
						`Career: ${this.pickTxt(dimensions.career.title, dimensions.career.titleEn)} / ${this.pickTxt(dimensions.career.content, dimensions.career.contentEn)}`,
						`Love: ${this.pickTxt(dimensions.love.title, dimensions.love.titleEn)} / ${this.pickTxt(dimensions.love.content, dimensions.love.contentEn)}`,
						`Health: ${this.pickTxt(dimensions.health.title, dimensions.health.titleEn)} / ${this.pickTxt(dimensions.health.content, dimensions.health.contentEn)}`
					].join('\n');
				}

				return [
					`当前选中线条：${selectedLineText}`,
					`生命线：${this.pickTxt(summary.lifeLine.dimension, summary.lifeLine.dimensionEn)} / ${this.pickTxt(summary.lifeLine.brief, summary.lifeLine.briefEn)}`,
					`智慧线：${this.pickTxt(summary.wisdomLine.dimension, summary.wisdomLine.dimensionEn)} / ${this.pickTxt(summary.wisdomLine.brief, summary.wisdomLine.briefEn)}`,
					`感情线：${this.pickTxt(summary.emotionLine.dimension, summary.emotionLine.dimensionEn)} / ${this.pickTxt(summary.emotionLine.brief, summary.emotionLine.briefEn)}`,
					`命运线：${this.pickTxt(summary.fateLine.dimension, summary.fateLine.dimensionEn)} / ${this.pickTxt(summary.fateLine.brief, summary.fateLine.briefEn)}`,
					`整体结论：${this.pickTxt(this.reportData.fullData.overallAnalysis, this.reportData.fullData.overallAnalysisEn)}`,
					`建议：${this.pickTxt(this.reportData.fullData.suggestions.tip, this.reportData.fullData.suggestions.tipEn)}`,
					`事业维度：${this.pickTxt(dimensions.career.title, dimensions.career.titleEn)} / ${this.pickTxt(dimensions.career.content, dimensions.career.contentEn)}`,
					`爱情维度：${this.pickTxt(dimensions.love.title, dimensions.love.titleEn)} / ${this.pickTxt(dimensions.love.content, dimensions.love.contentEn)}`,
					`健康维度：${this.pickTxt(dimensions.health.title, dimensions.health.titleEn)} / ${this.pickTxt(dimensions.health.content, dimensions.health.contentEn)}`
				].join('\n');
			},

			/**
			 * 生成追问答案（中英双语，用于 API 失败时的本地 fallback）
			 */
			buildFollowUpAnswerPair(module: FollowUpModule): { answer: string; answerEn: string } {
				return {
					answer: this.buildFollowUpAnswerZh(module),
					answerEn: this.buildFollowUpAnswerEn(module)
				};
			},

			buildFollowUpAnswerZh(module: FollowUpModule): string {
				const selectedLineText = this.selectedLineInfo
					? this.pickTxt(this.selectedLineInfo.title, this.selectedLineInfo.titleEn)
					: '';
				const summaryLine = this.reportData && this.reportData.fullData && this.reportData.fullData.suggestions
					? this.pickTxt(this.reportData.fullData.suggestions.tip, this.reportData.fullData.suggestions.tipEn)
					: '';
				const prompt = module.prompt;

				if (module.id === 'love') {
					return [
						`为什么这么判断：结合当前报告里“${selectedLineText}”和整体情感倾向，你的感情模式更像是“先观察、后投入”，而不是一上来就冲得很快。`,
						`解读结果：你更适合看稳定性、沟通质量和边界感，而不是只看心动强度。若对方长期忽冷忽热、承诺不清，关系很容易被消耗。`,
						`应对策略：短期先降低期待，把注意力放在对方是否持续投入、是否愿意明确表达、是否能在现实层面配合你。长期则要建立自己的筛选标准，不用情绪替代判断。`,
						`风险与避坑：最容易踩的坑是过早投入、替对方找借口、为了保住关系不断让步。${summaryLine ? `\n补充提醒：${summaryLine}` : ''}`,
						`问题原文：${prompt}`
					].join('\n\n');
				}

				if (module.id === 'career') {
					return [
						`为什么这么判断：从当前报告看，你的事业决策更适合“先收敛，再出手”，说明你不是没有机会，而是容易在节奏没稳住时过早切换方向。`,
						`解读结果：你接下来的上升路径更依赖执行力、积累和可量化产出，而不是单次冲刺。比起盲目换赛道，你更适合先把一个方向做深、做稳。`,
						`应对策略：短期优先处理能快速产出结果的事情，减少反复试错；长期要建立自己的能力护城河，比如稳定技能、核心作品、可复用经验和人脉资产。${selectedLineText ? `\n和“${selectedLineText}”相关的部分尤其要注意节奏与执行力。` : ''}`,
						`风险与避坑：最容易犯的错误是情绪上头就想跳槽、创业或重启，结果方向频繁摇摆。${summaryLine ? `\n补充提醒：${summaryLine}` : ''}`,
						`问题原文：${prompt}`
					].join('\n\n');
				}

				if (module.id === 'health') {
					return [
						`为什么这么判断：从当前报告看，你的健康核心问题不是“有没有毛病”，而是压力长期堆积、作息失衡和精力透支。手相里如果生命线起伏、健康区细纹多，通常意味着你对外硬扛、对内消耗太快。`,
						`解读结果：你当前更需要管理的是生活节奏，而不是单点焦虑。若继续高压硬撑，问题往往会先体现在睡眠、精力、情绪和恢复速度上。`,
						`应对策略：短期把睡眠、饮食、运动、补水和体检节奏拉回正常；长期建立稳定的身体维护习惯，不要等到明显不适才处理。`,
						`风险与避坑：最容易踩的坑是忽视早期信号、把疲劳当成小事、靠咖啡因或意志力硬顶。${summaryLine ? `\n补充提醒：${summaryLine}` : ''}`,
						`问题原文：${prompt}`
					].join('\n\n');
				}

				return [
					`为什么这么判断：当前报告显示你的问题不在“有没有答案”，而在“如何把答案落到具体动作”。`,
					`解读结果：你需要的不是泛泛结论，而是可执行、可验证、可持续的建议。`,
					`应对策略：建议把追问聚焦到一个明确场景，再按现实条件做判断。`,
					`风险与避坑：不要把模糊希望当成确定结果，也不要同时追太多问题导致结论失焦。`,
					`问题原文：${prompt}`
				].join('\n\n');
			},

			buildFollowUpAnswerEn(module: FollowUpModule): string {
				const selectedLineText = this.selectedLineInfo
					? this.pickTxt(this.selectedLineInfo.titleEn || this.selectedLineInfo.title, this.selectedLineInfo.titleEn)
					: '';
				const summaryLine = this.reportData && this.reportData.fullData && this.reportData.fullData.suggestions
					? this.pickTxt(this.reportData.fullData.suggestions.tipEn || this.reportData.fullData.suggestions.tip, this.reportData.fullData.suggestions.tipEn)
					: '';
				const prompt = module.promptEn || module.prompt;

				if (module.id === 'love') {
					return [
						`Why this reading: Based on "${selectedLineText}" and your overall emotional pattern, you tend to observe first and invest later rather than rushing in quickly.`,
						`What it means: Stability, communication quality, and boundaries matter more than intensity alone. If someone is inconsistent or unclear about commitment, the relationship can drain you.`,
						`What to do: In the short term, lower expectations and watch whether the other person keeps showing up, communicates clearly, and supports you in real life. Long term, build clear standards instead of letting emotion replace judgment.`,
						`Risks to avoid: Investing too early, making excuses for the other person, and giving up your boundaries to keep the relationship.${summaryLine ? `\nExtra note: ${summaryLine}` : ''}`,
						`Original question: ${prompt}`
					].join('\n\n');
				}

				if (module.id === 'career') {
					return [
						`Why this reading: Your career path works better with "consolidate first, then move" rather than switching direction before momentum is stable.`,
						`What it means: Growth depends on execution, accumulation, and measurable results more than one dramatic sprint. Deepening one direction is safer than constantly changing lanes.`,
						`What to do: Focus on tasks that produce visible outcomes soon, and build a long-term moat through skills, portfolio, reusable experience, and relationships.${selectedLineText ? `\nPay special attention to pace and execution around "${selectedLineText}".` : ''}`,
						`Risks to avoid: Impulsive job changes, side hustles, or restarts driven by emotion rather than evidence.${summaryLine ? `\nExtra note: ${summaryLine}` : ''}`,
						`Original question: ${prompt}`
					].join('\n\n');
				}

				if (module.id === 'health') {
					return [
						`Why this reading: The core issue is not a single illness but long-term stress, irregular routines, and energy depletion.`,
						`What it means: You need rhythm management more than panic. If pressure continues, sleep, mood, recovery speed, and daily energy are usually the first areas affected.`,
						`What to do: Reset sleep, food, movement, hydration, and checkup routines in the short term. Build sustainable maintenance habits for the long term.`,
						`Risks to avoid: Ignoring early warning signs, treating fatigue as minor, and relying on caffeine or willpower alone.${summaryLine ? `\nExtra note: ${summaryLine}` : ''}`,
						`Original question: ${prompt}`
					].join('\n\n');
				}

				return [
					`Why this reading: The report suggests your challenge is turning insight into action.`,
					`What it means: You need practical, verifiable, sustainable guidance rather than vague reassurance.`,
					`What to do: Narrow the question to one real scenario and decide based on current constraints.`,
					`Risks to avoid: Treating hope as certainty or chasing too many questions at once.`,
					`Original question: ${prompt}`
				].join('\n\n');
			},

			/** @deprecated 保留兼容，内部转中文答案 */
			buildFollowUpAnswer(module: FollowUpModule): string {
				return this.buildFollowUpAnswerZh(module);
			},

			/**
			 * 完成追问解锁后，保存答案到本地
			 */
			async completeFollowUpUnlock(provider: string, orderRef: string): Promise<void> {
				if (!this.reportData || !this.reportSessionId) {
					return;
				}

				const module = this.pendingFollowUpModule;
				this.followUpGeneratingModuleId = module ? module.id : this.followUpBundle.id;
				const moduleIds = module ? [module.id] : this.followUpBundle.moduleIds;
				const moduleRecords: Array<{ id: string; title: string; prompt: string; promptEn?: string | null }> = module
					? [{
						id: module.id,
						title: this.pickTxt(module.title, module.titleEn),
						prompt: this.pickTxt(module.prompt, module.promptEn),
						promptEn: module.promptEn || null
					}]
					: (() => {
						const result: Array<{ id: string; title: string; prompt: string; promptEn?: string | null }> = [];
						for (let i = 0; i < this.followUpModules.length; i += 1) {
							const item = this.followUpModules[i];
							for (let j = 0; j < this.followUpBundle.moduleIds.length; j += 1) {
								if (this.followUpBundle.moduleIds[j] === item.id) {
									result.push({
										id: item.id,
										title: this.pickTxt(item.title, item.titleEn),
										prompt: this.pickTxt(item.prompt, item.promptEn),
										promptEn: item.promptEn || null
									});
									break;
								}
							}
						}
						return result;
					})();

				this.showPaymentDialog = false;
				this.paymentLoading = false;
				clearPayPalButtonContainer('paypal-button-container');

				try {
					let imageBase64: string | null = null;
					try {
						imageBase64 = await resolveImageForApi(
							this.capturedImage || '',
							this.reportData.imagePath || ''
						);
					} catch (imageError) {
						console.warn('追问未附带图片，将仅基于首报摘要生成:', imageError);
					}

					const apiAnswers = await analyzeFollowUpReading({
						imagePath: imageBase64,
						gender: this.gender,
						handSide: this.handSide,
						locale: this.locale,
						reportSummaryText: this.getFollowUpReportSummaryText(),
						moduleIds,
						moduleDetails: (() => {
							const details: Array<{ id: string; title: string; prompt: string }> = [];
							for (let i = 0; i < moduleRecords.length; i += 1) {
								details.push({
									id: moduleRecords[i].id,
									title: moduleRecords[i].title,
									prompt: moduleRecords[i].prompt
								});
							}
							return details;
						})()
					});

					const now = new Date().toISOString();
					moduleRecords.forEach((record) => {
						let apiAnswer = null as any;
						for (let i = 0; i < apiAnswers.length; i += 1) {
							if (apiAnswers[i].moduleId === record.id) {
								apiAnswer = apiAnswers[i];
								break;
							}
						}
						const sourceModule = this.getFollowUpModuleById(record.id);
						const fallbackPair = this.buildFollowUpAnswerPair(sourceModule);
						const answerText = (apiAnswer != null && apiAnswer.answer) ? apiAnswer.answer : fallbackPair.answer;
						const answerEnText = (apiAnswer != null && apiAnswer.answerEn) ? apiAnswer.answerEn : fallbackPair.answerEn;
						saveFollowUpAnswer({
							sessionId: this.reportSessionId,
							moduleId: record.id,
							moduleTitle: record.title,
							question: record.prompt,
							answer: answerText,
							answerEn: answerEnText,
							paymentProvider: provider,
							orderRef: orderRef,
							paidAt: now
						});
					});
				} catch (error) {
					console.error('追问API失败，使用本地答案作为fallback', error);
					const now = new Date().toISOString();
					moduleRecords.forEach((record) => {
						const sourceModule = this.getFollowUpModuleById(record.id);
						const fallbackPair = this.buildFollowUpAnswerPair(sourceModule);
						saveFollowUpAnswer({
							sessionId: this.reportSessionId,
							moduleId: record.id,
							moduleTitle: record.title,
							question: record.prompt,
							answer: fallbackPair.answer,
							answerEn: fallbackPair.answerEn,
							paymentProvider: provider,
							orderRef: orderRef,
							paidAt: now
						});
					});
				}

				this.followUpAnswers = loadFollowUpAnswers(this.reportSessionId);
				this.followUpGeneratingModuleId = '';
				this.pendingFollowUpModule = null;
				this.paymentTarget = null;
				this.paymentSummaryLabel = '';
				uni.showToast({
					title: getCameraUi(this.locale).toastPaymentSuccess,
					icon: 'success'
				});
			},

			selectPaymentMethod(method: PaymentMethod): void {
				this.paymentMethod = method;
				clearPayPalButtonContainer('paypal-button-container');

				if (method === 'paypal') {
					this.stopPaymentPolling();
					if (PAYMENT_CONFIG.paypalClientId == null || PAYMENT_CONFIG.paypalClientId.length === 0) {
						uni.showToast({
							title: getCameraUi(this.locale).toastPayPalNotConfigured,
							icon: 'none',
							duration: 4000
						});
						this.paymentMethod = 'alipay';
						this.paymentLoading = false;
						this.startAlipayOrder();
						return;
					}

					this.paymentLoading = true;
					setTimeout(() => {
						this.mountPayPalButtons();
					}, 250);
					return;
				}

				this.paymentLoading = false;
				this.startAlipayOrder();
			},

			getAlipayListedPriceHint(): string {
				const u = getCameraUi(this.locale);
				return u.alipayListedPriceHint.replace('{price}', this.paymentDisplayPrice);
			},

			copyUniquePaymentAmount(): void {
				if (this.alipayPrice.length === 0) {
					return;
				}
				uni.setClipboardData({
					data: this.alipayPrice,
					success: () => {
						uni.showToast({
							title: getCameraUi(this.locale).toastAmountCopied,
							icon: 'none'
						});
					}
				});
			},

			getPaymentCountdownText(): string {
				if (this.paymentExpiresAt <= 0) {
					return '--:--';
				}
				const remainingMs = this.paymentExpiresAt - Date.now();
				if (remainingMs <= 0) {
					return '00:00';
				}
				const totalSeconds = Math.floor(remainingMs / 1000);
				const minutes = Math.floor(totalSeconds / 60);
				const seconds = totalSeconds % 60;
				const minuteText = minutes < 10 ? `0${minutes}` : `${minutes}`;
				const secondText = seconds < 10 ? `0${seconds}` : `${seconds}`;
				return `${minuteText}:${secondText}`;
			},

			getAlipayStatusText(): string {
				const u = getCameraUi(this.locale);
				if (this.paymentTestMode) {
					return u.alipayManualNotice;
				}
				if (this.paymentOrderStatus === 'creating') {
					return u.alipayOrderCreating;
				}
				if (this.paymentOrderStatus === 'pending') {
					return u.alipayWaitingPayment;
				}
				if (this.paymentOrderStatus === 'paid') {
					return u.alipayOrderPaid;
				}
				if (this.paymentOrderStatus === 'expired') {
					return u.alipayOrderExpired;
				}
				if (this.paymentOrderStatus === 'error') {
					return u.alipayOrderError;
				}
				return u.alipayWaitingPayment;
			},

			async startAlipayOrder(): Promise<void> {
				if (this.paymentTestMode) {
					this.paymentOrderStatus = 'test';
					return;
				}
				if (!this.reportSessionId) {
					return;
				}

				this.stopPaymentPolling();
				this.paymentOrderStatus = 'creating';
				this.paymentOrderId = '';

				const isBundle = this.pendingFollowUpModule == null;
				const moduleIds: string[] = isBundle
					? this.followUpBundle.moduleIds
					: [this.pendingFollowUpModule!.id];
				const displayPrice = isBundle
					? this.followUpBundle.priceCny
					: this.pendingFollowUpModule!.priceCny;

				try {
					const order = await createPaymentOrder({
						displayPrice,
						productType: isBundle ? 'bundle' : 'single',
						sessionId: this.reportSessionId,
						moduleIds
					});
					this.paymentOrderId = order.orderId;
					this.alipayPrice = order.amount;
					this.paymentDisplayPrice = order.displayPrice;
					this.paymentExpiresAt = order.expiresAt;
					if (order.qrCodeUrl != null && order.qrCodeUrl.length > 0) {
						this.alipayQrCode = order.qrCodeUrl;
					}
					this.paymentOrderStatus = 'pending';
					this.startPaymentPolling();
				} catch (error) {
					console.error('Create payment order failed:', error);
					this.paymentOrderStatus = 'error';
					uni.showToast({
						title: getCameraUi(this.locale).alipayOrderError,
						icon: 'none'
					});
				}
			},

			startPaymentPolling(): void {
				this.stopPaymentPolling();
				this.countdownTick = 0;
				this.pollPaymentOrderOnce();
				this.paymentPollTimer = setInterval(() => {
					this.pollPaymentOrderOnce();
				}, PAYMENT_CONFIG.pollIntervalMs) as number;
				this.paymentCountdownTimer = setInterval(() => {
					this.countdownTick += 1;
					if (this.paymentExpiresAt > 0 && Date.now() >= this.paymentExpiresAt) {
						this.paymentOrderStatus = 'expired';
						this.stopPaymentPolling();
					}
				}, 1000) as number;
			},

			stopPaymentPolling(): void {
				if (this.paymentPollTimer != null) {
					clearInterval(this.paymentPollTimer);
					this.paymentPollTimer = null;
				}
				if (this.paymentCountdownTimer != null) {
					clearInterval(this.paymentCountdownTimer);
					this.paymentCountdownTimer = null;
				}
			},

			async pollPaymentOrderOnce(): Promise<void> {
				if (this.paymentOrderId.length === 0 || this.paymentOrderStatus === 'paid') {
					return;
				}

				try {
					const order = await fetchPaymentOrder(this.paymentOrderId);
					if (order.status === 'paid') {
						this.paymentOrderStatus = 'paid';
						this.stopPaymentPolling();
						this.completeFollowUpUnlock('alipay', order.orderId);
						return;
					}
					if (order.status === 'expired' || order.status === 'conflict') {
						this.paymentOrderStatus = 'expired';
						this.stopPaymentPolling();
					}
				} catch (error) {
					console.error('Poll payment order failed:', error);
				}
			},

			confirmAlipayTestUnlock(): void {
				if (!this.paymentTestMode) {
					return;
				}
				this.stopPaymentPolling();
				this.completeFollowUpUnlock('alipay', `TEST-${Date.now()}`);
			},

			/**
			 * 挂载 PayPal 支付按钮
			 */
			mountPayPalButtons(): void {
				const u = getCameraUi(this.locale);
				loadPayPalSdk(PAYMENT_CONFIG.paypalClientId)
					.then(() => {
						return renderPayPalButtons(
							'#paypal-button-container',
							this.paymentPrice,
							PAYMENT_CONFIG.productName,
							{
								onSuccess: (orderId: string) => {
									this.handlePaymentSuccess(orderId);
								},
								onCancel: () => {
									uni.showToast({
										title: u.toastPaymentCancelled,
										icon: 'none'
									});
								},
								onError: (message: string) => {
									console.error('PayPal error:', message);
									uni.showToast({
										title: message,
										icon: 'none',
										duration: 4000
									});
								}
							}
						);
					})
					.catch((error: any) => {
						console.error('PayPal mount failed:', error);
						uni.showToast({
							title: u.toastPaymentFailed,
							icon: 'none',
							duration: 4000
						});
					})
					.finally(() => {
						this.paymentLoading = false;
					});
			},

			/**
			 * PayPal 付款成功回调
			 */
			handlePaymentSuccess(orderId: string): void {
				console.log('PayPal payment completed, order:', orderId);
				try {
					uni.setStorageSync('paypal_last_order_id', orderId);
				} catch (e) {
					console.error('save order id failed', e);
				}
				if (this.paymentTarget === 'followup') {
					this.completeFollowUpUnlock('paypal', orderId);
					return;
				}

				this.showPaymentDialog = false;
				clearPayPalButtonContainer('paypal-button-container');
				uni.showToast({
					title: getCameraUi(this.locale).toastPaymentSuccess,
					icon: 'success'
				});
			},

			/**
			 * 关闭支付弹窗
			 */
			closePaymentDialog(): void {
				this.showPaymentDialog = false;
				this.paymentLoading = false;
				this.stopPaymentPolling();
				this.paymentTarget = null;
				this.pendingFollowUpModule = null;
				this.paymentSummaryLabel = '';
				this.paymentOrderId = '';
				this.paymentOrderStatus = '';
				clearPayPalButtonContainer('paypal-button-container');
			},

			/**
			 * 执行手相 AI 分析（付费成功后调用）
			 */
			async runAnalysis(): Promise<void> {
				if (!this.capturedImage) {
					return;
				}

				if (!this.reportSessionId) {
					this.reportSessionId = this.createReportSessionId();
				}

				const u = getCameraUi(this.locale);
				this.isAnalyzing = true;
				this.analyzingStatus = u.analyzingExtract;
				this.reportData = null;

				const scanTerms = this.locale === 'en' ? SCAN_TERMS_EN : SCAN_TERMS_ZH;
				let termIndex = 0;
				this.dynamicScanText = scanTerms[0];
				let termInterval = 0;
				termInterval = setInterval(() => {
					termIndex = (termIndex + 1) % scanTerms.length;
					this.dynamicScanText = scanTerms[termIndex];
				}, 1500);

				try {
					console.log('开始转换图片为base64...');
					const imageBase64 = await convertImageToBase64ForApi(this.capturedImage);
					// 持久化 base64，避免刷新后 blob URL 失效导致追问接口 400
					this.capturedImage = imageBase64;

					this.analyzingStatus = getCameraUi(this.locale).analyzingFate;

					const result = await analyzePalmistry({
						imagePath: imageBase64,
						gender: this.gender,
						handSide: this.handSide,
						locale: this.locale
					});

					if (result.isInvalid === true) {
						uni.showToast({
							title: pickLocaleText(
								this.locale,
								result.errorMsg || '识别失败，请确保上传手掌图片',
								result.errorMsgEn
							),
							icon: 'none',
							duration: 5000
						});
						this.isAnalyzing = false;
						return;
					}

					this.analyzingStatus = getCameraUi(this.locale).analyzingReport;
					await new Promise((resolve) => setTimeout(resolve, 800));

					this.generateReportFromAPI(result);

					this.analyzingStatus = getCameraUi(this.locale).analyzingDone;

					uni.showToast({
						title: getCameraUi(this.locale).toastSuccess,
						icon: 'success'
					});
				} catch (error: any) {
					console.error('=== 分析失败 ===', error);

					let errorMessage = '分析失败，请重试';
					if (error.message) {
						if (error.message.includes('转换')) {
							errorMessage = '图片转换失败，请重试';
						} else if (error.message.includes('timeout') || error.message.includes('超时')) {
							errorMessage = '分析超时，请检查网络';
						} else if (error.message.includes('API调用失败')) {
							errorMessage = 'API调用失败，请检查网络连接和API配置';
						} else {
							errorMessage = error.message;
						}
					}

					uni.showToast({
						title: errorMessage,
						icon: 'none',
						duration: 5000
					});

					console.log('使用模拟数据作为fallback');
					this.generateMockReport();
				} finally {
					this.isAnalyzing = false;
					this.analyzingStatus = '';
					clearInterval(termInterval);
				}
			},

			/**
			 * 从API结果生成报告
			 */
			generateReportFromAPI(apiResult: any): void {
				const now = new Date();
				const year = now.getFullYear();
				const month = this.formatNumber(now.getMonth() + 1);
				const day = this.formatNumber(now.getDate());
				const hours = this.formatNumber(now.getHours());
				const minutes = this.formatNumber(now.getMinutes());
				const timeString = `${year}-${month}-${day} ${hours}:${minutes}`;

				// 检查新格式的数据结构
				if (!apiResult.summary || !apiResult.dimensions) {
					console.error('API结果格式不正确，使用模拟数据');
					this.generateMockReport();
					return;
				}

				// 从新格式中提取结果（含英文字段）
				const s = apiResult.summary;
				const results: ReportResult[] = [
					{
						type: '生命线',
						typeEn: 'Life Line',
						title: s.lifeLine.dimension,
						titleEn: s.lifeLine.dimensionEn,
						description: s.lifeLine.brief,
						descriptionEn: s.lifeLine.briefEn,
						score: s.lifeLine.score
					},
					{
						type: '智慧线',
						typeEn: 'Head Line',
						title: s.wisdomLine.dimension,
						titleEn: s.wisdomLine.dimensionEn,
						description: s.wisdomLine.brief,
						descriptionEn: s.wisdomLine.briefEn,
						score: s.wisdomLine.score
					},
					{
						type: '感情线',
						typeEn: 'Heart Line',
						title: s.emotionLine.dimension,
						titleEn: s.emotionLine.dimensionEn,
						description: s.emotionLine.brief,
						descriptionEn: s.emotionLine.briefEn,
						score: s.emotionLine.score
					},
					{
						type: '命运线',
						typeEn: 'Fate Line',
						title: s.fateLine.dimension,
						titleEn: s.fateLine.dimensionEn,
						description: s.fateLine.brief,
						descriptionEn: s.fateLine.briefEn,
						score: s.fateLine.score
					}
				];

				// 保存完整的API结果到reportData中，以便后续显示详细内容
				this.reportData = {
					id: this.reportSessionId,
					sessionId: this.reportSessionId,
					imagePath: this.capturedImage || '',
					analyzeTime: timeString,
					results: results,
					// 保存完整数据以便显示详细分析
					fullData: apiResult
				};
				this.persistActiveReportSnapshot();
			},

			/**
			 * 生成模拟报告数据
			 */
			generateMockReport(): void {
				if (!this.reportSessionId) {
					this.reportSessionId = this.createReportSessionId();
				}

				const now = new Date();
				const year = now.getFullYear();
				const month = this.formatNumber(now.getMonth() + 1);
				const day = this.formatNumber(now.getDate());
				const hours = this.formatNumber(now.getHours());
				const minutes = this.formatNumber(now.getMinutes());
				const timeString = `${year}-${month}-${day} ${hours}:${minutes}`;

				const mockResults: ReportResult[] = [
					{
						type: '生命线',
						typeEn: 'Life Line',
						title: '生命能',
						titleEn: 'Vitality',
						description: '生命线基础雄厚但中段出现细微岛纹，警示长期高压透支已动摇命元。',
						descriptionEn: 'A strong life line with a faint island mid-way warns of burnout.',
						score: 85
					},
					{
						type: '智慧线',
						typeEn: 'Head Line',
						title: '智谋度',
						titleEn: 'Wisdom',
						description: '智慧线过于平直且末端下坠，显示思维理性到近乎冷酷，却极易在关键时刻陷入偏执。',
						descriptionEn: 'A straight head line dipping at the end suggests rigid thinking and stubborn streaks.',
						score: 70
					},
					{
						type: '感情线',
						typeEn: 'Heart Line',
						title: '情缘力',
						titleEn: 'Emotion',
						description: '感情线断续且杂纹丛生，命带红尘情孽，易深陷不伦或无果之恋。',
						descriptionEn: 'A broken heart line hints at turbulent relationships.',
						score: 60
					},
					{
						type: '命运线',
						typeEn: 'Fate Line',
						title: '天命轨迹',
						titleEn: 'Fate',
						description: '命运线深长且清晰，预示人生轨迹明确，但中段有分叉，暗示中年会有重大转折，需把握机遇。',
						descriptionEn: 'A clear fate line with a fork suggests a major mid-life turning point.',
						score: 75
					}
				];

				// 补全 fullData 结构
				const mockFullData: PalmistryAnalysisResult = {
					summary: {
						lifeLine: {
							dimension: '生命能',
							dimensionEn: 'Vitality',
							score: 8.5,
							brief: '生命线基础雄厚但中段出现细微岛纹，警示长期高压透支已动摇命元。',
							briefEn: 'Strong vitality line with mid-palm warning signs.'
						},
						wisdomLine: {
							dimension: '智谋度（事业）',
							dimensionEn: 'Wisdom (career)',
							score: 7.0,
							brief: '智慧线过于平直且末端下坠，显示思维理性到近乎冷酷，却极易在关键时刻陷入偏执。',
							briefEn: 'Head line reads as overly rational and stubborn under pressure.'
						},
						emotionLine: {
							dimension: '情缘力（婚姻）',
							dimensionEn: 'Emotion (love)',
							score: 6.0,
							brief: '感情线断续且杂纹丛生，命带红尘情孽，易深陷不伦或无果之恋。',
							briefEn: 'Heart line shows emotional turbulence.'
						},
						fateLine: {
							dimension: '天命轨迹',
							dimensionEn: 'Fate line',
							score: 7.5,
							brief: '命运线深长且清晰，预示人生轨迹明确，但中段有分叉，暗示中年会有重大转折，需把握机遇。',
							briefEn: 'Clear fate line with a fork near mid-life.'
						}
					},
					dimensions: {
						handType: {
							title: '五行命格',
							titleEn: 'Five elements / hand type',
							content: '你属于典型的"火型手"，性格急躁如烈火，虽有极强的开拓精神和执行力，但也极易因冲动而招致挫败。命格中缺乏"水"的滋润，导致为人处世过于刚硬，缺乏弹性。',
							contentEn: 'Fire-type hand: driven and impulsive; needs more flexibility.'
						},
						palmMounds: {
							title: '星丘压制',
							titleEn: 'Mounts',
							content: '土星丘过度隆起且伴有杂纹，显示你内心深处压抑着巨大的孤独感和不安全感。太阳丘平淡，意味着你的才华往往难以在早期获得对等的社会认可，存在"怀才不遇"的压制。',
							contentEn: 'Prominent Saturn mount; subdued Sun mount may delay recognition.'
						},
						specialMarks: {
							title: '凶吉征兆',
							titleEn: 'Signs',
							content: '智慧线末端出现细微岛纹，这是典型的由于过度透支精力导致的思维停滞预兆。事业线中段有横切纹，预示着在35岁左右会遭遇一次重大的职业转型或财务危机。',
							contentEn: 'Small island on head line; career stress line around mid-30s.'
						},
						career: {
							title: '财官利禄',
							titleEn: 'Career & wealth',
							content: '财库线尚不闭合，这意味着你虽然赚钱能力强，但守财极难，开销如流水。贵人线断续，显示你习惯单打独斗，不擅利用人脉资源，这严重制约了你的官禄高度。',
							contentEn: 'Strong earning but weak saving; underuse of networks.'
						},
						love: {
							title: '红尘情孽',
							titleEn: 'Love',
							content: '感情线断续且向食指延伸不足，这预示着你在亲密关系中极度自私，总希望对方无条件迁就自己。若不改掉这种唯我独尊的性格，二婚风险极大，晚年易生凄凉。',
							contentEn: 'Relationship pattern skews selfish; work on empathy.'
						},
						health: {
							title: '命元警示',
							titleEn: 'Health',
							content: '生命线中段变浅，预示消化系统或心血管方面存在隐患。长期高压工作已严重侵蚀你的命元。',
							contentEn: 'Mid life line fade suggests stress-related health risks.'
						},
						wealth: {
							title: '财帛福禄',
							titleEn: 'Windfall',
							content: '财帛宫位见红润之色，预示近期将有偏财入账。但需注意守成，不可因一时贪念而陷入投机之险。',
							contentEn: 'Short-term windfall possible; avoid reckless bets.'
						}
					},
					harshWarning: '你最大的问题在于"狂妄自大"与"自毁灭倾向"。你总是在即将成功时，因为无法控制的情绪暴走或盲目自信而亲手毁掉前程。若不学会低头与自省，你的人生终将是一场悲剧性的轮回。',
					harshWarningEn: 'Your blind spots are pride and self-sabotage right before success.',
					overallAnalysis: '你的命格属于典型的"先繁华后凋零"。前半生依仗天赋可占得先机，但若无后天德行的修养，中年后必遇大劫。需修身养性，方可改命。',
					overallAnalysisEn: 'Early gains from talent need discipline to sustain later life.',
					lineDetails: [],
					palmFeatures: {
						palmShape: '修长火型掌',
						palmShapeEn: 'Long fire-type palm',
						fingerRatio: '中指过长',
						fingerRatioEn: 'Long middle finger',
						palmMound: '土星丘过度隆起',
						palmMoundEn: 'Raised Saturn mount'
					},
					suggestions: {
						career: '学会藏锋，不要在实力不足时过早展露野心。',
						careerEn: 'Keep ambitions private until you can back them up.',
						life: '每日冥想，强行压制内心的躁动。',
						lifeEn: 'Daily calm practice to steady the mind.',
						tip: '命理乃定数，亦是提醒。转念即转运，好自为之。',
						tipEn: 'Fate is a mirror; change mindset, change outcomes.'
					}
				};

				this.reportData = {
					id: this.reportSessionId || `report_${Date.now()}`,
					sessionId: this.reportSessionId || '',
					imagePath: this.capturedImage || '',
					analyzeTime: timeString,
					results: mockResults,
					fullData: mockFullData
				};
				this.persistActiveReportSnapshot();
			},

			/**
			 * 格式化数字为两位字符串
			 */
			formatNumber(num: number): string {
				return num < 10 ? `0${num}` : `${num}`;
			},

			/**
			 * 下载报告
			 */
			handleDownloadReport(): void {
				if (!this.reportData) {
					uni.showToast({
						title: getCameraUi(this.locale).toastAnalyzeFirst,
						icon: 'none'
					});
					return;
				}
				// 显示微信引流弹窗
				this.showWechatDialog = true;
			},

			/**
			 * 重置（重新拍照）
			 */
			handleReset(): void {
				if (this.reportSessionId) {
					clearFollowUpAnswers(this.reportSessionId);
				}
				clearActiveReportSnapshot();
				this.reportSessionId = '';
				this.followUpAnswers = [];
				this.activeFollowUpModuleId = 'love';
				this.followUpGeneratingModuleId = '';
				this.pendingFollowUpModule = null;
				this.paymentTarget = null;
				this.paymentSummaryLabel = '';
				this.showPaymentDialog = false;
				this.paymentLoading = false;
				clearPayPalButtonContainer('paypal-button-container');
				this.capturedImage = null;
				this.reportData = null;
				this.imageScale = 1.0;
				this.imageOffsetX = 0;
				this.imageOffsetY = 0;
			}
		}
	};
</script>

<style>
	.camera-container {
		display: flex;
		flex-direction: column;
		width: 100%;
		min-height: 100vh;
		background-color: #fdf7ee;
		background-image: 
			radial-gradient(#f4ebd0 1px, transparent 0),
			radial-gradient(#f4ebd0 1px, transparent 0);
		background-size: 40px 40px;
		background-position: 0 0, 20px 20px;
		overflow-x: hidden;
		box-sizing: border-box;
		align-items: center;
		font-family: "STKaiti", "Kaiti", "SimKai", serif;
		position: relative;
	}

	.bg-decoration {
		position: fixed;
		top: 0; left: 0; width: 100%; height: 100%;
		pointer-events: none;
		z-index: 0;
		display: flex;
		justify-content: center;
		align-items: center;
		overflow: hidden;
	}

	.bg-bagua {
		width: 1200rpx;
		height: 1200rpx;
		opacity: 0.03;
		background-image: url('https://img.alicdn.com/imgextra/i4/O1CN01Z5vXvz1Z5vXvz1Z5v_!!6000000000001-2-tps-1024-1024.png'); /* 使用通用的八卦图链接或本地素材 */
		background-size: contain;
		background-repeat: no-repeat;
		animation: rotateBg 60s linear infinite;
	}

	@keyframes rotateBg {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.camera-content-wrapper {
		width: 100%;
		max-width: 600px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		position: relative;
		min-height: 100vh;
		padding-bottom: 130rpx;
		box-sizing: border-box;
		box-shadow: 0 0 80rpx rgba(90, 62, 43, 0.15);
		background-color: #fdf7ee;
		/* 侧边装饰线，模拟卷轴 */
		border-left: 2rpx solid #e8e0cc;
		border-right: 2rpx solid #e8e0cc;
	}

	.camera-content-wrapper::before {
		content: "";
		position: absolute;
		top: 0; left: 0; right: 0; bottom: 0;
		pointer-events: none;
		border: 30rpx solid transparent;
		/* 增加边角装饰感 */
		border-image: radial-gradient(circle, #e8e0cc 20%, transparent 80%) 20;
		opacity: 0.3;
		z-index: 0;
	}

	.camera-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		padding: 60rpx 20rpx 35rpx;
		background-color: #fdf7ee;
		box-sizing: border-box;
		flex-shrink: 0;
	}

	.header-main {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 15rpx;
		margin-bottom: 15rpx;
	}

	.header-stamp {
		width: 80rpx;
		height: 80rpx;
		opacity: 0.9;
		animation: seal落印 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	@keyframes seal落印 {
		0% { transform: scale(3); opacity: 0; }
		70% { transform: scale(0.9); opacity: 1; }
		100% { transform: scale(1); opacity: 0.9; }
	}

	.header-deco {
		width: 300rpx;
		height: 4rpx;
		background-color: #5a3e2b;
		margin-bottom: 20rpx;
		position: relative;
	}

	.header-deco::before, .header-deco::after {
		content: "";
		position: absolute;
		width: 10rpx;
		height: 10rpx;
		border: 2rpx solid #5a3e2b;
		transform: rotate(45deg);
		top: -5rpx;
	}

	.header-deco::before { left: -15rpx; }
	.header-deco::after { right: -15rpx; }

	.header-title {
		font-size: 46rpx;
		font-weight: bold;
		color: #5a3e2b;
		letter-spacing: 6rpx;
		text-shadow: 2rpx 2rpx 4rpx rgba(90, 62, 43, 0.1);
	}

	.header-subtitle {
		font-size: 28rpx;
