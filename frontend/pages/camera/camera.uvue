		align-items: center;
		gap: 20rpx;
		margin-top: 10rpx;
		width: 100%;
	}

	.switch-group {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 20rpx;
	}

	.switch-label {
		font-size: 24rpx;
