	}

	.hand-btn {
		padding: 14rpx 45rpx;
		border-radius: 40rpx;
		border: 2rpx solid #c8b99b;
		background: linear-gradient(to bottom, #fff, #fdfaf5);
		font-size: 26rpx;
		color: #8c7662;
		transition: all 0.3s ease;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
	}

	.hand-btn.mini {
		padding: 8rpx 30rpx;
		min-width: 100rpx;
	}

	.hand-btn.active {
		background: linear-gradient(135deg, #5a3e2b, #3d2a1d);
		border-color: #5a3e2b;
		color: #fdf7ee;
		box-shadow: 0 6rpx 20rpx rgba(90, 62, 43, 0.3);
		transform: translateY(-2rpx);
	}

	.hand-text {
		color: inherit;
		font-weight: bold;
	}

	.camera-content {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 95%;
		padding: 20rpx;
		margin: 20rpx 0;
		background-color: #fff;
		background-image: 
			linear-gradient(rgba(232, 224, 204, 0.1) 1rpx, transparent 1rpx),
			linear-gradient(90deg, rgba(232, 224, 204, 0.1) 1rpx, transparent 1rpx);
		background-size: 20rpx 20rpx;
		border-radius: 12rpx;
		border: 2rpx solid #e8e0cc;
		box-sizing: border-box;
		box-shadow: inset 0 0 40rpx rgba(0,0,0,0.02);
		overflow: hidden;
		min-height: 500rpx;
		position: relative;
		z-index: 1;
	}

	.camera-content.report-mode {
		margin: 0;
		padding: 0;
		border-radius: 0;
		background-color: #fdf7ee;
		border: none;
		box-shadow: none;
	}

	.preview-area {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.preview-container {
		flex: 1;
		width: 100%;
		position: relative;
		overflow: hidden;
		border-radius: 10rpx;
		background-color: #fafafa;
		touch-action: none;
	}

	.image-wrapper {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		transform-origin: center center;
		touch-action: none;
	}

	.preview-image {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.hand-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: none;
		z-index: 10;
		touch-action: none;
	}

	.hand-overlay .hand-image {
		width: 100%;
		height: 100%;
		max-width: 380rpx;
		max-height: 480rpx;
		opacity: 0.7;
		transition: transform 0.3s ease;
	}

	.scale-controls {
		position: absolute;
		top: 20rpx;
		right: 20rpx;
		display: flex;
		flex-direction: column;
		gap: 15rpx;
		z-index: 100;
		pointer-events: auto;
		touch-action: manipulation;
	}

	.scale-btn {
		width: 80rpx;
		height: 80rpx;
		border-radius: 50%;
		background-color: rgba(0, 0, 0, 0.7);
		border: 2rpx solid rgba(255, 255, 255, 0.5);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.2s ease;
		box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
		user-select: none;
		-webkit-user-select: none;
		position: relative;
		z-index: 101;
	}

	.scale-btn:active {
		background-color: rgba(0, 122, 255, 0.9);
		transform: scale(0.9);
	}

	.scale-icon {
		font-size: 40rpx;
		color: #fff;
		font-weight: bold;
		line-height: 1;
		pointer-events: none;
		user-select: none;
		-webkit-user-select: none;
	}

	.reset-btn .scale-icon {
		font-size: 36rpx;
	}

	/* PC端鼠标样式 */
	@media (pointer: fine) {
		.preview-container {
			cursor: move;
		}

		.scale-btn:hover {
			background-color: rgba(0, 122, 255, 0.8);
			transform: scale(1.05);
			border-color: rgba(255, 255, 255, 0.8);
		}
	}

	.preview-actions {
