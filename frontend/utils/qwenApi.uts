function createFailedFaceMatchResult(message: string, messageEn: string): FaceMatchResult {
	return {
		isInvalid: true,
		errorMsg: message,
		errorMsgEn: messageEn,
		compatibilityScore: 0,
		compatibilityLevel: '-',
		compatibilityLevelEn: '-',
		previewSummary: message,
		previewSummaryEn: messageEn,
		complementarity: message,
		complementarityEn: messageEn,
		domesticLeader: '-',
		domesticLeaderEn: '-',
		careerLeader: '-',
		careerLeaderEn: '-',
		shortTermTrend: message,
		shortTermTrendEn: messageEn,
		midTermTrend: message,
		midTermTrendEn: messageEn,
		palaceMatch: message,
		palaceMatchEn: messageEn,
		communicationStyle: message,
		communicationStyleEn: messageEn,
		longTermTrend: message,
		longTermTrendEn: messageEn,
		wealthTogether: message,
		wealthTogetherEn: messageEn,
		conflictPoints: [message],
		conflictPointsEn: [messageEn],
		advice: [message],
		adviceEn: [messageEn],
		shareTeaser: message,
		shareTeaserEn: messageEn,
		disclaimer: message,
		disclaimerEn: messageEn
	};
}

