/** 合婚 prompt 只需 A 方报告核心字段，去掉双语冗余以缩短输入 */
function slimPersonAReportForMatch(reportJson: string): string {
	try {
		const parsed = JSON.parse(reportJson) as FaceAnalysisResult;
		const slim = {
			archive: parsed.archive != null ? {
				faceElement: parsed.archive.faceElement,
				spiritScore: parsed.archive.spiritScore,
				complexionOverview: parsed.archive.complexionOverview
			} : null,
			threeSections: parsed.threeSections,
			fiveOfficials: parsed.fiveOfficials,
			keyPalaces: parsed.keyPalaces,
			coreFortunes: parsed.coreFortunes
		};
		return JSON.stringify(slim);
	} catch (error) {
		console.warn('合婚报告 JSON 精简失败，使用截断原文', error);
		return reportJson.length > 16000 ? reportJson.substring(0, 16000) : reportJson;
	}
}

