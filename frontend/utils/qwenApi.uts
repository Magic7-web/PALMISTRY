/**
 * 通义千问API封装
 */

import { QWEN_CONFIG } from './config';
import type { PalmistryAnalysisResult, FollowUpReadingResult, FaceAnalysisResult, FaceMatchResult, FaceImprovementResult } from '@/types/index';
import type { AppLocale } from '@/utils/locale';
import { isApiReadyImage } from '@/utils/imageHelper';

/**
 * 代理请求头（Authorization 由后端 server/ 添加）
 */
function buildQwenRequestHeaders(): UTSJSONObject {
	return {
		'Content-Type': 'application/json',
		'X-DashScope-SSE': 'disable'
	};
}

/**
 * 解析代理或 DashScope 错误信息
 */
function extractProxyErrorMessage(res: any): string {
	if (res.data == null) {
		return res.errMsg || '未知错误';
	}
	if (typeof res.data === 'string') {
		return res.data;
	}
	if (res.data.success === false && res.data.message) {
		return String(res.data.message);
	}
	if (res.data.message) {
		return String(res.data.message);
	}
	if (res.data.error) {
		return typeof res.data.error === 'string' ? res.data.error : JSON.stringify(res.data.error);
	}
	return JSON.stringify(res.data);
}

/**
 * Qwen API 消息内容
 */
interface QwenMessage {
	role: 'user' | 'assistant' | 'system';
	content: Array<{
		type: 'text' | 'image';
		text?: string;
		image?: string; // 直接是在线URL字符串
	}>;
}

/**
 * Qwen API 请求参数
 */
interface QwenRequest {
	model: string;
	input: {
		messages: QwenMessage[];
	};
	parameters?: {
		temperature?: number;
		max_tokens?: number;
		top_p?: number;
	};
}

/**
 * Qwen API 响应
 */
interface QwenResponse {
	output: {
		choices: Array<{
			message: {
				role: string;
				content: string;
			};
		}>;
	};
	usage?: {
		total_tokens: number;
	};
}

/** 旧版线条识别结构（兼容 lines 数组格式） */
export interface DetectedLine {
	type: string;
	typeName: string;
	typeNameEn?: string;
	description?: string;
	descriptionEn?: string;
	clarity?: number;
	length?: number;
	points?: Array<{ x: number; y: number }>;
}

/**
 * 手相识别请求参数
 */
interface PalmistryAnalyzeRequest {
	imagePath: string;
	gender: 'male' | 'female';
	handSide: 'left' | 'right';
	/** 界面语言偏好（用于提示模型；中英文 JSON 字段均需返回） */
	locale?: AppLocale;
}

interface FollowUpAnalyzeRequest {
	/** 可为空：无图时仅基于首报摘要做文本追问 */
	imagePath?: string | null;
	gender: 'male' | 'female';
	handSide: 'left' | 'right';
	locale?: AppLocale;
	reportSummaryText: string;
	moduleIds: string[];
	moduleDetails?: Array<{
		id: string;
		title: string;
		prompt: string;
	}>;
}

/**
 * 面相识别请求参数
 */
interface FaceAnalyzeRequest {
	imagePath: string;
	gender?: 'male' | 'female';
	locale?: AppLocale;
	analysis_type?: 'face';
}

interface FaceMatchAnalyzeRequest {
	personAImage?: string | null;
	personBImage: string;
	/** 从面相报告带入时，A 方用已有报告 JSON，仅需上传 B 方照片 */
	personAReportJson?: string | null;
	locale?: AppLocale;
	analysis_type?: 'face_match' | 'face_match_report';
}

interface FaceImprovementAnalyzeRequest {
	reportJson: string;
	locale?: AppLocale;
	analysis_type?: 'face_improvement';
}

/**
 * 构建多语言提示词（中文主文案 + 并行英文字段说明）
 */
function buildPalmistryPrompt(handSideText: string, genderText: string, locale: AppLocale): string {
	const localeHint =
		locale === 'en'
			? 'The user prefers English UI, but you MUST still output Chinese in the main fields AND fill every *En field with natural English.'
			: '用户界面偏好为中文，但你仍必须为所有主字段同时提供对应的英文 *En 字段，便于双语展示。';

	const dimensionContentRule = `每个 dimensions 模块的 content / contentEn 必须写成「四段式完整分析」，禁止只写两三句摘要。
中文 content 总字数 120-220 字，必须依次包含以下四段（每段前保留标签）：
【判断依据】从掌形、掌丘、线条深浅/断续/分支等可见特征说明为何这样判断。
【命理解读】给出该维度的核心命理结论，语气犀利、具体，避免空话。
【现实表现】描述此人在工作、关系、习惯或处事方式上的典型表现。
【简短建议】给出 1-2 条可执行建议，用"建议/适合/注意"等表达，不做绝对命运论。
英文 contentEn 用同样四段结构，每段 2-4 句，信息量和中文一致。`;

	return `🪬 你是一位拥有三十年经验、眼神犀利且直击灵魂的专业手相命理大师。你不仅精通传统五行相法，更擅长捕捉掌纹中极其微小的差异。

【语言与输出】${localeHint}
你必须在 JSON 中同时包含中文主字段与英文平行字段：summary 四条线各含 dimensionEn、briefEn；dimensions 各维度含 titleEn、contentEn；顶层含 harshWarningEn、overallAnalysisEn；palmFeatures 含 palmShapeEn、fingerRatioEn、palmMoundEn；suggestions 含 careerEn、lifeEn、tipEn。无效图时 errorMsg 与 errorMsgEn 均需给出。

【免费报告厚度要求 — 极其重要】
这是一份「完整免费手相报告」，不是简短摘要。用户应感觉每个模块都读到了具体、有依据、能落地的分析。
${dimensionContentRule}
- harshWarning：中文 120-180 字，保留强风格、直指要害，不可过短。
- overallAnalysis / overallAnalysisEn：中文 180-300 字，综合四条主线、手型与掌丘，给出完整命格判断。
- summary 中四条线的 brief / briefEn：每条 35-60 字，比一句话摘要更具体。
- suggestions 中 career / life / tip 及对应 En：每条 40-80 字，给出具体行动方向。

⚠️ 第一步：图片合法性校验 (极度严格)
在进行任何分析前，请先判定图片内容：
1. 如果图片【不是】人类手掌，或者图片过于模糊、距离太远无法辨识掌纹：
   必须严格且仅返回如下格式的 JSON，严禁生成任何分析内容：
   {
     "isInvalid": true,
     "errorMsg": "【命理警示】此图非我界之物或天机晦暗（无法识别手掌）。请重新上传一张清晰、平整的【手掌】照片，方可推演乾坤。",
     "errorMsgEn": "This image is not a clear palm or cannot be read. Please upload a clear, flat photo of your palm.",
     "summary": {
       "lifeLine": { "dimension": "生命能", "dimensionEn": "Vitality", "score": 0, "brief": "-", "briefEn": "-" },
       "wisdomLine": { "dimension": "智谋度", "dimensionEn": "Wisdom", "score": 0, "brief": "-", "briefEn": "-" },
       "emotionLine": { "dimension": "情缘力", "dimensionEn": "Emotion", "score": 0, "brief": "-", "briefEn": "-" },
       "fateLine": { "dimension": "天命轨迹", "dimensionEn": "Fate", "score": 0, "brief": "-", "briefEn": "-" }
     },
     "dimensions": {
       "handType": { "title": "-", "titleEn": "-", "content": "-", "contentEn": "-" },
       "palmMounds": { "title": "-", "titleEn": "-", "content": "-", "contentEn": "-" },
       "specialMarks": { "title": "-", "titleEn": "-", "content": "-", "contentEn": "-" },
       "personality": { "title": "-", "titleEn": "-", "content": "-", "contentEn": "-" },
       "career": { "title": "-", "titleEn": "-", "content": "-", "contentEn": "-" },
       "love": { "title": "-", "titleEn": "-", "content": "-", "contentEn": "-" },
       "health": { "title": "-", "titleEn": "-", "content": "-", "contentEn": "-" },
       "recentLuck": { "title": "-", "titleEn": "-", "content": "-", "contentEn": "-" }
     },
     "harshWarning": "-",
     "harshWarningEn": "-",
     "overallAnalysis": "-",
     "overallAnalysisEn": "-",
     "lineDetails": [],
     "palmFeatures": { "palmShape": "-", "palmShapeEn": "-", "fingerRatio": "-", "fingerRatioEn": "-", "palmMound": "-", "palmMoundEn": "-" },
     "suggestions": { "career": "-", "careerEn": "-", "life": "-", "lifeEn": "-", "tip": "-", "tipEn": "-" }
   }
2. 如果图片是手掌，请继续执行以下深度分析。

🔍 第二步：极致差异化分析要求
为了避免千篇一律的结论，你必须像显微镜一样观察这张【${genderText}】的【${handSideText}】：
1. 【手型判定的科学依据】：
   - 火型（长掌短指）：分析其急躁与极强的开拓力。
   - 水型（圆掌长指）：分析其敏感、直觉与情绪起伏。
   - 土型（方掌短指）：分析其固执、务实与极度的稳健。
   - 风型（方掌长指）：分析其理性、逻辑与变动不居。
   *你必须明确判定其中一种，严禁无特殊理由地给出“相济/混合”等模棱两可的结论。*
2. 【掌纹微观细节】：
   - 观察掌纹的【深浅、断续、分支、岛纹】：深如刻石者性格刚毅，浅如发丝者心思细腻。
   - 观察【掌丘隆起】：哪个星丘（木星、土星、太阳、水星）最突出？这决定了人生的“爆发点”。
3. 【结论的唯一性】：每一份报告都必须是“量身定制”的。请根据图片的真实视觉信号，发掘此人与众不同的命理特征，不要再说大白话。

✨ 第三步：大师身份与语气
你是一位【激进、犀利且真实】的大师。称呼用户为"你"或"这位${genderText === '男性' ? '先生' : '女士'}"。你的语言应如刀锋般犀利，不恭维、不避讳，直接指出其运势中的【死穴】。英文平行字段（*En）应语气专业、直白，与中文信息一致，不要编造与图片无关的内容。禁止医疗/法律/投资保证，用"倾向/更适合/可能/建议"表达。

请返回JSON格式，严格按照以下结构（注意所有 *En 字段必须填写）：

{
  "isInvalid": false,
  "summary": {
    "lifeLine": { "dimension": "生命能", "dimensionEn": "Vitality (Life Line)", "score": 8.5, "brief": "35-60字具体描述", "briefEn": "English brief" },
    "wisdomLine": { "dimension": "智谋度（事业）", "dimensionEn": "Wisdom (Head Line)", "score": 7.0, "brief": "35-60字具体描述", "briefEn": "English brief" },
    "emotionLine": { "dimension": "情缘力（婚姻）", "dimensionEn": "Emotion (Heart Line)", "score": 6.0, "brief": "35-60字具体描述", "briefEn": "English brief" },
    "fateLine": { "dimension": "天命轨迹", "dimensionEn": "Fate Line", "score": 7.5, "brief": "35-60字具体描述", "briefEn": "English brief" }
  },
  "dimensions": {
    "handType": { "title": "五行命格", "titleEn": "Five Elements / Hand Type", "content": "四段式长文120-220字", "contentEn": "Four-part English analysis" },
    "palmMounds": { "title": "星丘压制", "titleEn": "Mounts", "content": "四段式长文", "contentEn": "Four-part English analysis" },
    "specialMarks": { "title": "凶吉征兆", "titleEn": "Signs", "content": "四段式长文", "contentEn": "Four-part English analysis" },
    "personality": { "title": "性格底色", "titleEn": "Personality Core", "content": "四段式长文", "contentEn": "Four-part English analysis" },
    "career": { "title": "财官利禄", "titleEn": "Career & Wealth", "content": "四段式长文", "contentEn": "Four-part English analysis" },
    "love": { "title": "红尘情孽", "titleEn": "Love & Relationships", "content": "四段式长文", "contentEn": "Four-part English analysis" },
    "health": { "title": "命元警示", "titleEn": "Health", "content": "四段式长文", "contentEn": "Four-part English analysis" },
    "recentLuck": { "title": "近期提醒", "titleEn": "Recent Outlook", "content": "四段式长文", "contentEn": "Four-part English analysis" }
  },
  "harshWarning": "【致命命理警示】120-180字，犀利具体。",
  "harshWarningEn": "English warning, same depth.",
  "overallAnalysis": "综合命定结论：180-300字，整合全局。",
  "overallAnalysisEn": "Overall conclusion in English, same depth.",
  "lineDetails": [
    {
      "type": "wisdom",
      "typeName": "智慧线",
      "typeNameEn": "Head Line",
      "description": "50-80字线条描述",
      "descriptionEn": "English line description",
      "interpretation": {
        "thinking": "...",
        "learning": "...",
        "decision": "..."
      }
    }
  ],
  "palmFeatures": {
    "palmShape": "...",
    "palmShapeEn": "...",
    "fingerRatio": "...",
    "fingerRatioEn": "...",
    "palmMound": "...",
    "palmMoundEn": "..."
  },
  "suggestions": {
    "career": "40-80字具体事业建议",
    "careerEn": "...",
    "life": "40-80字具体生活建议",
    "lifeEn": "...",
    "tip": "40-80字转运提醒",
    "tipEn": "..."
  }
}

重要要求：
1. 必须严格按照上述 JSON 结构返回，且所有 *En 字段必须为有效英文（无效图时可用 "-"）。
2. dimensions 必须包含 personality 与 recentLuck，且每个模块 content 必须满足四段式与字数要求。
3. 分数使用小数，范围在 0-10 之间。
4. lineDetails 至少包含 2-4 条主要线条解读。
5. 必须只返回纯 JSON 格式，不要包含任何 markdown 标记、代码块。`;
}

function buildFollowUpPrompt(
	handSideText: string,
	genderText: string,
	locale: AppLocale,
	reportSummaryText: string,
	moduleIds: string[],
	moduleDetails: Array<{
		id: string;
		title: string;
		prompt: string;
	}>
): string {
	const localeHint =
		locale === 'en'
			? 'The user prefers English UI. You MUST output both Chinese answer and English answerEn for each module; answerEn must be a full parallel translation with the same structure and depth as answer.'
			: '用户界面偏好为中文。你必须为每个模块同时输出中文 answer 与英文 answerEn，两者信息量一致，便于界面双语切换。';

	const moduleMap: Record<string, string> = {
		love: '爱情 / Love',
		career: '事业 / Career',
		health: '健康 / Health'
	};

	const detailMap: Record<string, { title: string; prompt: string }> = {};
	for (let i = 0; i < moduleDetails.length; i += 1) {
		const item = moduleDetails[i];
		detailMap[item.id] = {
			title: item.title,
			prompt: item.prompt
		};
	}

	let moduleList = '';
	for (let i = 0; i < moduleIds.length; i += 1) {
		const id = moduleIds[i];
		const detail = detailMap[id];
		const title = detail != null ? detail.title : (moduleMap[id] || id);
		const prompt = detail != null ? detail.prompt : '';
		if (i > 0) {
			moduleList += '\n';
		}
		moduleList += `${i + 1}. ${title}${prompt ? `\n   用户真正关心的问题：${prompt}` : ''}`;
	}

	return `🪬 你是一位拥有三十年经验、极其擅长手相深度追问的命理大师。

【语言与输出】${localeHint}
请基于同一张手相图和已有首报结论，输出一个“追问深度解读”JSON。不要重复首报，而要沿着用户关心的模块给出更长、更实用、更能转化的答案。你必须把内容写成“付费深度解答”的感觉，让用户明显感受到增量信息。

【当前分析对象】
${genderText}，${handSideText}

【用户已知的首报摘要】
${reportSummaryText}

【当前追问模块】
${moduleList}

【分析要求】
1. 每个模块必须写成完整深度解读，正文中要明确包含以下四段，并且最好用自然段分开：
   - 为什么这么判断
   - 解读出来的结果
   - 应对策略
   - 风险与避坑
2. 每个模块的正文必须足够长，建议 700-1000 个中文字符，不得少于 500 个中文字符，不能只写两三句。
3. 语言必须具体，避免空话。要把“掌纹/手型/掌丘/线条”与“现实建议”串起来，并写出用户可以直接执行的动作。
4. 不能给医疗、法律、投资保证，也不能写成绝对命运论；要保留“倾向/更适合/可能/建议”这些表达。
5. 如果模块是爱情，就必须围绕“关系节奏、相处方式、沟通模式、遇到合适对象的窗口、避免烂桃花”展开。
6. 如果模块是事业，就必须围绕“工作选择、跳槽/转岗时机、上升路径、执行节奏、贵人/阻力、避免错误决策”展开。
7. 如果模块是健康，就必须围绕“压力、睡眠、体力消耗、作息、体检、生活习惯调整”展开。
8. 输出要像一个付费深度解答，内容要比首报更细，用户能明显感到信息增量，并且每个模块都要给出至少 1 条短期动作建议 + 1 条长期策略建议 + 1 条避坑提醒。

【输出JSON结构】
{
  "answers": [
    {
      "moduleId": "love",
      "moduleTitle": "爱情",
      "answer": "中文长文，必须包含为什么、结果、策略、风险四段，且每段都要具体。",
      "answerEn": "English long text with the same four sections: why, result, strategy, risks."
    }
  ]
}

【重要】
1. 只返回纯JSON，不要markdown，不要代码块。
2. moduleId 必须与输入模块一一对应。
3. 每个模块必须同时填写 answer 与 answerEn，不得省略。
4. 如果是多个模块，请按顺序返回多项 answers。`;
}

/**
 * 构建面相分析提示词（手机端六模块精简版，区别于手相报告）
 */
function buildFacePrompt(locale: AppLocale): string {
	const localeHint =
		locale === 'en'
			? 'The user prefers English UI, but you MUST still output Chinese in the main fields AND fill every *En field with natural English.'
			: '用户界面偏好为中文，但你仍必须为所有主字段同时提供对应的英文 *En 字段，便于双语展示。';

	const invalidStub = `{
  "isInvalid": true,
  "errorMsg": "【命理警示】此图非正脸或天机晦暗，请上传清晰的正面人脸照片。",
  "errorMsgEn": "Please upload a clear front-facing photo.",
  "archive": { "confidence": 0, "classics": "-", "classicsEn": "-", "disclaimer": "-", "disclaimerEn": "-", "faceElement": "-", "faceElementEn": "-", "spiritScore": 0, "complexionOverview": "-", "complexionOverviewEn": "-" },
  "threeSections": {
    "upper": { "name": "上停", "nameEn": "Upper", "ageRange": "15-30岁", "ageRangeEn": "15-30", "score": 0, "summary": "-", "summaryEn": "-", "details": "-", "detailsEn": "-" },
    "middle": { "name": "中停", "nameEn": "Middle", "ageRange": "31-50岁", "ageRangeEn": "31-50", "score": 0, "summary": "-", "summaryEn": "-", "details": "-", "detailsEn": "-" },
    "lower": { "name": "下停", "nameEn": "Lower", "ageRange": "51岁+", "ageRangeEn": "51+", "score": 0, "summary": "-", "summaryEn": "-", "details": "-", "detailsEn": "-" },
    "balanceScore": 0, "imbalanceNote": "-", "imbalanceNoteEn": "-"
  },
  "fiveOfficials": [],
  "keyPalaces": [],
  "coreFortunes": {
    "career": { "label": "事业官禄", "labelEn": "Career", "stars": 0, "trend": "-", "trendEn": "-", "summary": "-", "summaryEn": "-" },
    "wealth": { "label": "财帛", "labelEn": "Wealth", "stars": 0, "trend": "-", "trendEn": "-", "summary": "-", "summaryEn": "-" },
    "love": { "label": "婚恋", "labelEn": "Love", "stars": 0, "trend": "-", "trendEn": "-", "summary": "-", "summaryEn": "-" }
  },
  "improvement": { "appearanceTips": "-", "appearanceTipsEn": "-", "behaviorTips": "-", "behaviorTipsEn": "-", "lifePlanning": "-", "lifePlanningEn": "-", "closingNote": "-", "closingNoteEn": "-" }
}`;

	return `🪬 你是一位精通麻衣神相、柳庄相法的专业面相师，正在为【手机端面相报告】撰写结论。

【任务类型】analysis_type: face（面相分析，NOT 手相/掌纹）
【分析对象】正面人脸照片（请根据照片自行判断性别与大致年龄段）

【语言与输出】${localeHint}

⚠️ 禁止输出手相、掌纹、生命线、智慧线、感情线等内容。本报告必须完全基于【面部】特征，遵循传统面相学逻辑。

⚠️ 第一步：图片合法性校验
若图片不是清晰正面人脸，必须仅返回：${invalidStub}

🔍 第二步：按以下【六大模块】输出 JSON（无 markdown 包裹）：

模块1 archive｜基础档案：confidence(0-100 AI识别置信度)、classics(参考古籍)、disclaimer(民俗文化参考免责声明)、faceElement(脸型五行：金/木/水/火/土)、spiritScore(0-10精气神)、complexionOverview(肤色气色总览)

模块2 threeSections｜三停流年：upper/middle/lower 各含 name、ageRange、score(0-10)、summary(40-60字)、details(80-120字)；balanceScore(三停均衡0-10)；imbalanceNote(失衡短板解读)

模块3 fiveOfficials｜五大官（必须5项）：采听官(耳)、保寿官(眉)、监察官(眼)、审辨官(鼻)、出纳官(口)。每项含 appearance(外观特征)、character(心性解读)、influence(运势影响)，各40-70字

模块4 keyPalaces｜十二宫重点（选6个最关键宫位，不要全凑数）：从命宫、财帛宫、兄弟宫、田宅宫、男女宫、疾厄宫、夫妻宫、迁移宫、官禄宫、福德宫、父母宫、奴仆宫中选。每项含 location、feature(AI识别特征)、fortuneLevel(吉/平/凶)、trend(短期趋势)、advice(改良建议)

模块5 coreFortunes｜三大核心运势：career/wealth/love 各含 stars(1-5整数星级)、trend(升/稳/降)、summary(60-90字)。侧重面相学逻辑，勿重复手相话术

模块6 improvement｜趋吉指南：appearanceTips(形象微调)、behaviorTips(相由心生修养)、lifePlanning(生活规划)、closingNote(总判结语，强调面相定根基、努力改运势，弱化宿命感)

JSON 结构示例（字段名必须一致）：
{
  "isInvalid": false,
  "archive": { "confidence": 88, "classics": "参考《麻衣神相》《柳庄相法》", "classicsEn": "...", "disclaimer": "...", "disclaimerEn": "...", "faceElement": "木型脸", "faceElementEn": "Wood face", "spiritScore": 7.5, "complexionOverview": "...", "complexionOverviewEn": "..." },
  "threeSections": { "upper": {...}, "middle": {...}, "lower": {...}, "balanceScore": 7.0, "imbalanceNote": "...", "imbalanceNoteEn": "..." },
  "fiveOfficials": [{ "name": "采听官（耳）", "nameEn": "Ears", "appearance": "...", "appearanceEn": "...", "character": "...", "characterEn": "...", "influence": "...", "influenceEn": "..." }],
  "keyPalaces": [{ "name": "命宫", "nameEn": "Life Palace", "location": "印堂", "locationEn": "...", "feature": "...", "featureEn": "...", "fortuneLevel": "吉", "fortuneLevelEn": "Auspicious", "trend": "...", "trendEn": "...", "advice": "...", "adviceEn": "..." }],
  "coreFortunes": {
    "career": { "label": "事业官禄运", "labelEn": "Career", "stars": 4, "trend": "稳步上升", "trendEn": "Rising", "summary": "...", "summaryEn": "..." },
    "wealth": { "label": "财帛运", "labelEn": "Wealth", "stars": 3, "trend": "...", "trendEn": "...", "summary": "...", "summaryEn": "..." },
    "love": { "label": "婚恋运", "labelEn": "Love", "stars": 4, "trend": "...", "trendEn": "...", "summary": "...", "summaryEn": "..." }
  },
  "improvement": { "appearanceTips": "...", "appearanceTipsEn": "...", "behaviorTips": "...", "behaviorTipsEn": "...", "lifePlanning": "...", "lifePlanningEn": "...", "closingNote": "...", "closingNoteEn": "..." }
}

要求：fiveOfficials 必须恰好5项；keyPalaces 必须6项；语气专业、具体、基于图片可见特征，禁止编造与图片无关的细节；禁止医疗/法律/投资保证。`;
}

function createFailedFaceResult(message: string, messageEn: string): FaceAnalysisResult {
	const emptySection = {
		name: '-',
		nameEn: '-',
		ageRange: '-',
		ageRangeEn: '-',
		score: 0,
		summary: message,
		summaryEn: messageEn,
		details: message,
		detailsEn: messageEn
	};
	const emptyFortune = {
		label: '-',
		labelEn: '-',
		stars: 0,
		trend: '-',
		trendEn: '-',
		summary: message,
		summaryEn: messageEn
	};
	return {
		archive: {
			confidence: 0,
			classics: '-',
			classicsEn: '-',
			disclaimer: message,
			disclaimerEn: messageEn,
			faceElement: '-',
			faceElementEn: '-',
			spiritScore: 0,
			complexionOverview: message,
			complexionOverviewEn: messageEn
		},
		threeSections: {
			upper: emptySection,
			middle: emptySection,
			lower: emptySection,
			balanceScore: 0,
			imbalanceNote: message,
			imbalanceNoteEn: messageEn
		},
		fiveOfficials: [],
		keyPalaces: [],
		coreFortunes: {
			career: emptyFortune,
			wealth: emptyFortune,
			love: emptyFortune
		},
		improvement: {
			appearanceTips: message,
			appearanceTipsEn: messageEn,
			behaviorTips: message,
			behaviorTipsEn: messageEn,
			lifePlanning: message,
			lifePlanningEn: messageEn,
			closingNote: message,
			closingNoteEn: messageEn
		}
	};
}

/**
 * 调用通义千问API分析手相
 */
export async function analyzePalmistry(
	request: PalmistryAnalyzeRequest
): Promise<PalmistryAnalysisResult> {
	try {
		// 1. 直接使用传入的图片数据（支持在线URL或base64格式）
		const imageData = request.imagePath;
		const isBase64 = imageData.startsWith('data:image/');
		console.log('使用图片数据:', imageData.substring(0, 50) + '...');
		console.log('图片数据类型:', isBase64 ? 'base64' : 'URL');

		// 2. 构建提示词（含中英双轨 JSON 字段说明）
		const handSideText = request.handSide === 'left' ? '左手' : '右手';
		const genderText = request.gender === 'male' ? '男性' : '女性';
		const locale: AppLocale = request.locale != null ? request.locale : 'en';
		const prompt = buildPalmistryPrompt(handSideText, genderText, locale);

		// 3. 构建API请求
		const apiRequest: QwenRequest = {
			model: QWEN_CONFIG.model,
			input: {
				messages: [
					{
						role: 'user',
						content: [
							{
								type: 'text',
								text: prompt
							},
							{
								type: 'image',
								image: imageData // 支持 data:image/jpeg;base64,xxxxx 格式或在线URL
							}
						]
					}
				]
			},
			parameters: {
				temperature: 0.1, // 低温度，更稳定的输出
				max_tokens: 8000, // 免费报告加厚 + 中英双轨需更长输出
				top_p: 0.8
			}
		};

		console.log('=== 平台检测 ===');
		console.log('当前endpoint:', QWEN_CONFIG.endpoint);
		console.log('是否为代理路径:', QWEN_CONFIG.endpoint.startsWith('/api/'));
		console.log('完整配置:', {
			endpoint: QWEN_CONFIG.endpoint,
			model: QWEN_CONFIG.model,
			imageDataType: isBase64 ? 'base64' : 'URL',
			requestSize: JSON.stringify(apiRequest).length
		});
		
		// 4. 调用API
		return new Promise<PalmistryAnalysisResult>((resolve, reject) => {
			console.log('发送API请求，请求数据大小:', JSON.stringify(apiRequest).length);
			
			uni.request({
				url: QWEN_CONFIG.endpoint,
				method: 'POST',
				header: buildQwenRequestHeaders(),
				data: apiRequest,
				timeout: QWEN_CONFIG.timeout,
				success: (res: any) => {
					console.log('API调用成功，状态码:', res.statusCode);
					console.log('API响应数据类型:', typeof res.data);
					console.log('API响应数据:', res.data);
					
					// 5. 解析响应
					if (res.statusCode !== 200) {
						const errorMsg = extractProxyErrorMessage(res);
						console.error('API调用失败:', res.statusCode, errorMsg);
						reject(new Error(`API调用失败: HTTP ${res.statusCode}, ${errorMsg}`));
						return;
					}

					if (res.data != null && res.data.success === false) {
						const errorMsg = extractProxyErrorMessage(res);
						reject(new Error(errorMsg));
						return;
					}

					// 检查响应数据是否为空或无效
					if (!res.data) {
						reject(new Error('API返回数据为空'));
						return;
					}

					// 如果响应是字符串，尝试解析
					let responseData = res.data;
					if (typeof res.data === 'string') {
						try {
							responseData = JSON.parse(res.data);
						} catch (e) {
							reject(new Error(`API返回数据格式错误: 无法解析JSON字符串 - ${res.data.substring(0, 100)}`));
							return;
						}
					}

					const qwenResponse = responseData as QwenResponse;
					
					if (!qwenResponse || !qwenResponse.output || !qwenResponse.output.choices || qwenResponse.output.choices.length === 0) {
						reject(new Error('API返回数据格式错误：缺少output.choices'));
						return;
					}

					const content = qwenResponse.output.choices[0].message.content;
					console.log('API返回内容类型:', typeof content);
					console.log('API返回内容:', content);

					// 6. 处理返回内容（支持多种格式）
					try {
						let result: PalmistryAnalysisResult;
						let jsonString: string = '';
						
						if (typeof content === 'string') {
							// 如果是字符串，先检查是否是数组格式
							console.log('content 是字符串类型，检查格式...');
							
							// 尝试解析为数组（API可能返回数组格式）
							try {
								const contentArray = JSON.parse(content);
								if (Array.isArray(contentArray) && contentArray.length > 0) {
									// 如果是数组，取第一个元素的 text 字段
									if (contentArray[0].text) {
										console.log('检测到数组格式，提取 text 字段...');
										jsonString = contentArray[0].text;
									} else {
										// 如果数组元素直接是对象，尝试使用
										if (contentArray[0].lines && Array.isArray(contentArray[0].lines)) {
											result = contentArray[0] as PalmistryAnalysisResult;
											console.log('数组元素格式正确，直接使用');
											resolve(result);
											return;
										} else {
											jsonString = content;
										}
									}
								} else {
									// 不是数组，直接使用字符串
									jsonString = content;
								}
							} catch (e) {
								// 解析失败，说明不是JSON数组，直接使用原字符串
								console.log('不是JSON数组格式，直接使用字符串...');
								jsonString = content;
							}
							
							// 解析提取的字符串
							result = parseQwenResponse(jsonString);
						} else if (typeof content === 'object' && content !== null) {
							// 如果已经是对象，检查格式并直接使用
							console.log('content 是对象类型，检查格式...');
							
							// 检查是否是数组
							if (Array.isArray(content) && content.length > 0) {
								// 如果是数组，取第一个元素
								const firstItem = content[0];
								if (firstItem.text) {
									// 有 text 字段，提取并解析
									console.log('检测到数组格式，提取 text 字段...');
									result = parseQwenResponse(firstItem.text);
								} else if (firstItem.lines && Array.isArray(firstItem.lines)) {
									// 直接是正确格式
									result = firstItem as PalmistryAnalysisResult;
									console.log('数组元素格式正确，直接使用');
								} else {
									// 转换为字符串后解析
									jsonString = JSON.stringify(content);
									result = parseQwenResponse(jsonString);
								}
							} else if (content.lines && Array.isArray(content.lines)) {
								// 已经是正确的格式，直接使用
								result = content as PalmistryAnalysisResult;
								console.log('对象格式正确，直接使用');
							} else {
								// 尝试转换为字符串再解析
								console.log('对象格式不符合预期，转换为字符串后解析...');
								jsonString = JSON.stringify(content);
								result = parseQwenResponse(jsonString);
							}
						} else {
							throw new Error(`content 类型不正确: ${typeof content}`);
						}
						
						console.log('解析后的结果:', result);
						resolve(result);
					} catch (error: any) {
						console.error('解析JSON失败:', error);
						console.error('错误堆栈:', error.stack);
						reject(new Error(`解析返回结果失败: ${error.message || 'JSON格式错误'}`));
					}
				},
				fail: (error: any) => {
					console.error('API调用失败', error);
					const errorMsg = error.errMsg || '网络错误';
					// 检查是否是超时错误
					if (errorMsg.includes('timeout') || errorMsg.includes('超时')) {
						reject(new Error(`API调用超时：分析时间过长，请检查网络连接或稍后重试`));
					} else {
						reject(new Error(`API调用失败: ${errorMsg}`));
					}
				}
			});
		});

	} catch (error) {
		console.error('手相识别失败:', error);
		throw error;
	}
}

/**
 * 追问模块深度解读
 */
function extractQwenErrorMessage(res: any): string {
	if (res.data == null) {
		return res.errMsg || '未知错误';
	}
	if (typeof res.data === 'string') {
		return res.data;
	}
	if (res.data.message) {
		return String(res.data.message);
	}
	if (res.data.error) {
		return typeof res.data.error === 'string' ? res.data.error : JSON.stringify(res.data.error);
	}
	return JSON.stringify(res.data);
}

export async function analyzeFollowUpReading(
	request: FollowUpAnalyzeRequest
): Promise<FollowUpReadingResult[]> {
	try {
		const imageData =
			request.imagePath != null && isApiReadyImage(request.imagePath) ? request.imagePath : null;
		const handSideText = request.handSide === 'left' ? '左手' : '右手';
		const genderText = request.gender === 'male' ? '男性' : '女性';
		const locale: AppLocale = request.locale != null ? request.locale : 'en';
		const prompt = buildFollowUpPrompt(
			handSideText,
			genderText,
			locale,
			request.reportSummaryText,
			request.moduleIds,
			request.moduleDetails != null ? request.moduleDetails : []
		);

		const messageContent: Array<{
			type: 'text' | 'image';
			text?: string;
			image?: string;
		}> = [{ type: 'text', text: prompt }];
		if (imageData != null) {
			messageContent.push({ type: 'image', image: imageData });
		}

		const apiRequest: QwenRequest = {
			model: QWEN_CONFIG.model,
			input: {
				messages: [
					{
						role: 'user',
						content: messageContent
					}
				]
			},
			parameters: {
				temperature: 0.25,
				max_tokens: 8000,
				top_p: 0.85
			}
		};

		return new Promise<FollowUpReadingResult[]>((resolve, reject) => {
			uni.request({
				url: QWEN_CONFIG.endpoint,
				method: 'POST',
				header: buildQwenRequestHeaders(),
				data: apiRequest,
				timeout: QWEN_CONFIG.timeout,
				success: (res: any) => {
					if (res.statusCode !== 200) {
						const detail = extractProxyErrorMessage(res);
						console.error('追问 API 错误响应:', res.statusCode, detail);
						reject(new Error(`API调用失败: HTTP ${res.statusCode}, ${detail}`));
						return;
					}

					if (res.data != null && res.data.success === false) {
						reject(new Error(extractProxyErrorMessage(res)));
						return;
					}

					let responseData = res.data;
					if (typeof responseData === 'string') {
						try {
							responseData = JSON.parse(responseData);
						} catch (error) {
							reject(new Error('追问接口响应不是合法JSON'));
							return;
						}
					}

					const qwenResponse = responseData as QwenResponse;
					if (
						qwenResponse == null ||
						qwenResponse.output == null ||
						qwenResponse.output.choices == null ||
						qwenResponse.output.choices.length === 0 ||
						qwenResponse.output.choices[0] == null ||
						qwenResponse.output.choices[0].message == null
					) {
						reject(new Error('追问接口返回内容为空'));
						return;
					}
					const content = qwenResponse.output.choices[0].message.content;
					const answers = parseFollowUpAnswers(content, request.moduleIds);
					if (answers.length === 0) {
						console.error('追问接口返回无法解析:', content);
						reject(new Error('追问接口返回结构不正确'));
						return;
					}

					resolve(answers);
				},
				fail: (error: any) => {
					const errorMsg = error.errMsg || '网络错误';
					reject(new Error(`追问接口调用失败: ${errorMsg}`));
				}
			});
		});
	} catch (error) {
		console.error('追问解读失败:', error);
		throw error;
	}
}

function normalizeQwenMessageContent(content: string | any): string {
	if (typeof content === 'string') {
		try {
			const parsed = JSON.parse(content);
			if (Array.isArray(parsed) && parsed.length > 0 && parsed[0].text != null) {
				return String(parsed[0].text);
			}
		} catch (error) {
			// 普通字符串直接返回
		}
		return content;
	}
	if (Array.isArray(content) && content.length > 0 && content[0].text != null) {
		return String(content[0].text);
	}
	if (typeof content === 'object' && content !== null) {
		return JSON.stringify(content);
	}
	return String(content);
}

function extractFollowUpJson(content: string | any): string {
	let jsonString = normalizeQwenMessageContent(content);
	jsonString = jsonString.trim();
	jsonString = jsonString.replace(/```json\s*/g, '');
	jsonString = jsonString.replace(/```\s*/g, '');
	jsonString = jsonString.trim();
	const startIndex = jsonString.indexOf('{');
	const endIndex = jsonString.lastIndexOf('}');
	if (startIndex >= 0 && endIndex > startIndex) {
		jsonString = jsonString.substring(startIndex, endIndex + 1);
	}
	return jsonString;
}

function parseFollowUpAnswers(content: string | any, moduleIds: string[]): FollowUpReadingResult[] {
	let parsed: any = null;
	try {
		parsed = JSON.parse(extractFollowUpJson(content));
	} catch (error) {
		console.error('追问 JSON 解析失败', error);
		return [];
	}

	let rawAnswers: any[] = [];
	if (parsed != null && Array.isArray(parsed.answers)) {
		rawAnswers = parsed.answers;
	} else if (Array.isArray(parsed)) {
		rawAnswers = parsed;
	} else if (parsed != null && parsed.answer != null) {
		rawAnswers = [parsed];
	}

	const answers: FollowUpReadingResult[] = [];
	for (let i = 0; i < rawAnswers.length; i += 1) {
		const item = rawAnswers[i];
		if (item == null) {
			continue;
		}
		const moduleId = String(item.moduleId || item.id || moduleIds[i] || '');
		const answer = item.answer != null ? item.answer : (item.content != null ? item.content : item.text);
		if (moduleId.length > 0 && answer != null && String(answer).length > 0) {
			const answerEn = item.answerEn != null ? String(item.answerEn) : '';
			answers.push({
				moduleId,
				moduleTitle: String(item.moduleTitle || item.title || moduleId),
				answer: String(answer),
				answerEn: answerEn.length > 0 ? answerEn : undefined
			});
		}
	}

	if (answers.length === 0 && moduleIds.length > 0) {
		const fallbackText = normalizeQwenMessageContent(content).trim();
		if (fallbackText.length > 120) {
			for (let i = 0; i < moduleIds.length; i += 1) {
				answers.push({
					moduleId: moduleIds[i],
					moduleTitle: moduleIds[i],
					answer: fallbackText
				});
			}
		}
	}

	return answers;
}

/**
 * 解析Qwen API返回的JSON内容
 * 支持字符串和对象两种格式
 */
function parseQwenResponse(content: string | any): PalmistryAnalysisResult {
	try {
		// 确保 content 是字符串
		let jsonString: string;
		
		if (typeof content === 'string') {
			jsonString = content;
		} else if (typeof content === 'object' && content !== null) {
			// 如果是对象，先转换为字符串
			jsonString = JSON.stringify(content);
		} else {
			throw new Error(`content 类型不正确: ${typeof content}`);
		}
		
		// 尝试提取JSON部分（可能包含markdown代码块）
		console.log('parseQwenResponse: 原始 jsonString:', jsonString.substring(0, 100) + '...');
		jsonString = jsonString.trim();
		
		// 移除可能的markdown代码块标记
		jsonString = jsonString.replace(/```json\s*/g, '');
		jsonString = jsonString.replace(/```\s*/g, '');
		jsonString = jsonString.trim();
		console.log('parseQwenResponse: 移除markdown标记后:', jsonString.substring(0, 100) + '...');
		
		// 如果内容以{开头，{结尾，尝试直接解析
		const startIndex = jsonString.indexOf('{');
		const endIndex = jsonString.lastIndexOf('}');
		
		if (startIndex >= 0 && endIndex > startIndex) {
			jsonString = jsonString.substring(startIndex, endIndex + 1);
			console.log('parseQwenResponse: 提取JSON部分后:', jsonString.substring(0, 100) + '...');
		}
		
		const result = JSON.parse(jsonString) as PalmistryAnalysisResult;
		console.log('parseQwenResponse: 解析后的对象:', {
			hasSummary: !!result.summary,
			hasDimensions: !!result.dimensions,
			hasLineDetails: !!result.lineDetails,
			hasPalmFeatures: !!result.palmFeatures,
			hasSuggestions: !!result.suggestions
		});
		
		// 验证结果格式
		if (!result.summary || !result.dimensions || !result.lineDetails || !result.palmFeatures || !result.suggestions || !result.harshWarning || !result.overallAnalysis) {
			console.error('parseQwenResponse: 结果格式验证失败，result:', result);
			throw new Error('返回结果格式不正确：缺少必要字段');
		}
		
		// 验证 summary 字段
		if (!result.summary.lifeLine || !result.summary.wisdomLine || !result.summary.emotionLine || !result.summary.fateLine) {
			console.error('parseQwenResponse: summary字段不完整');
			throw new Error('返回结果格式不正确：summary字段不完整');
		}
		
		return result;
		
	} catch (error) {
		console.error('JSON解析失败:', error);
		console.error('原始内容类型:', typeof content);
		console.error('原始内容:', content);
		
		// 如果解析失败，返回默认结果
		return {
			summary: {
				lifeLine: {
					dimension: '健康维度',
					score: 0,
					brief: '识别失败，请重试或检查图片质量'
				},
				wisdomLine: {
					dimension: '思维维度',
					score: 0,
					brief: '识别失败，请重试或检查图片质量'
				},
				emotionLine: {
					dimension: '情感维度',
					score: 0,
					brief: '识别失败，请重试或检查图片质量'
				},
				fateLine: {
					dimension: '命运维度',
					score: 0,
					brief: '识别失败，请重试或检查图片质量'
				}
			},
			dimensions: {
				handType: {
					title: '五行命格',
					content: '识别失败，请重试或检查图片质量'
				},
				palmMounds: {
					title: '星丘压制',
					content: '识别失败，请重试或检查图片质量'
				},
				specialMarks: {
					title: '凶吉征兆',
					content: '识别失败，请重试或检查图片质量'
				},
				career: {
					title: '事业维度',
					content: '识别失败，请重试或检查图片质量'
				},
				love: {
					title: '爱情维度',
