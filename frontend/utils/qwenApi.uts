function createFailedFaceMatchResult(message: string, messageEn: string): FaceMatchResult {
	return {
		isInvalid: true,
		errorMsg: message,
		errorMsgEn: messageEn,
		compatibilityScore: 0,
		compatibilityLevel: '-',
		compatibilityLevelEn: '-',
		previewSummary: message,
		previewSummaryEn: messageEn,
		complementarity: message,
		complementarityEn: messageEn,
		domesticLeader: '-',
		domesticLeaderEn: '-',
		careerLeader: '-',
		careerLeaderEn: '-',
		shortTermTrend: message,
		shortTermTrendEn: messageEn,
		midTermTrend: message,
		midTermTrendEn: messageEn,
		conflictPoints: [message],
		conflictPointsEn: [messageEn],
		advice: [message],
		adviceEn: [messageEn],
		shareTeaser: message,
		shareTeaserEn: messageEn,
		disclaimer: message,
		disclaimerEn: messageEn
	};
}

function createFailedFaceImprovementResult(message: string, messageEn: string): FaceImprovementResult {
	return {
		hairstyle: message,
		hairstyleEn: messageEn,
		eyebrow: message,
		eyebrowEn: messageEn,
		accessories: message,
		accessoriesEn: messageEn,
		makeupAndColor: message,
		makeupAndColorEn: messageEn,
		deskDirection: message,
		deskDirectionEn: messageEn,
		bedroomDirection: message,
		bedroomDirectionEn: messageEn,
		avoidItems: [message],
		avoidItemsEn: [messageEn],
		premiumSummary: message,
		premiumSummaryEn: messageEn,
		disclaimer: message,
		disclaimerEn: messageEn
	};
}

function parseFaceMatchResponse(content: string | any): FaceMatchResult {
	try {
		let jsonString = normalizeQwenMessageContent(content);
		jsonString = jsonString.trim();
		jsonString = jsonString.replace(/```json\s*/g, '');
		jsonString = jsonString.replace(/```\s*/g, '');
		jsonString = jsonString.trim();
		const startIndex = jsonString.indexOf('{');
		const endIndex = jsonString.lastIndexOf('}');
		if (startIndex >= 0 && endIndex > startIndex) {
			jsonString = jsonString.substring(startIndex, endIndex + 1);
		}
		const result = JSON.parse(jsonString) as FaceMatchResult;
		if (result.compatibilityScore == null || result.previewSummary == null) {
			throw new Error('返回结果格式不正确');
		}
		if (result.conflictPoints == null) {
			result.conflictPoints = [];
		}
		if (result.advice == null) {
			result.advice = [];
		}
		return result;
	} catch (error) {
		console.error('合婚 JSON 解析失败:', error);
		return createFailedFaceMatchResult('合婚分析失败，请重试', 'Match analysis failed, please retry');
	}
}

function parseFaceImprovementResponse(content: string | any): FaceImprovementResult {
	try {
		let jsonString = normalizeQwenMessageContent(content);
		jsonString = jsonString.trim();
		jsonString = jsonString.replace(/```json\s*/g, '');
		jsonString = jsonString.replace(/```\s*/g, '');
		jsonString = jsonString.trim();
		const startIndex = jsonString.indexOf('{');
		const endIndex = jsonString.lastIndexOf('}');
		if (startIndex >= 0 && endIndex > startIndex) {
			jsonString = jsonString.substring(startIndex, endIndex + 1);
		}
		const result = JSON.parse(jsonString) as FaceImprovementResult;
		if (result.premiumSummary == null || result.hairstyle == null) {
			throw new Error('返回结果格式不正确');
		}
		if (result.avoidItems == null) {
			result.avoidItems = [];
		}
		return result;
	} catch (error) {
		console.error('开运 JSON 解析失败:', error);
		return createFailedFaceImprovementResult('开运方案生成失败，请重试', 'Improvement plan failed, please retry');
	}
}

async function callQwenTextOrVision<T>(
	apiRequest: UTSJSONObject,
	parseFn: (content: string | any) => T
): Promise<T> {
	return new Promise<T>((resolve, reject) => {
		uni.request({
			url: QWEN_CONFIG.endpoint,
			method: 'POST',
			header: buildQwenRequestHeaders(),
			data: apiRequest,
			timeout: QWEN_CONFIG.timeout,
			success: (res: any) => {
				if (res.statusCode !== 200) {
					reject(new Error(`API调用失败: HTTP ${res.statusCode}, ${extractProxyErrorMessage(res)}`));
					return;
				}
				if (res.data != null && res.data.success === false) {
					reject(new Error(extractProxyErrorMessage(res)));
					return;
				}
				if (!res.data) {
					reject(new Error('API返回数据为空'));
					return;
				}
				let responseData = res.data;
				if (typeof res.data === 'string') {
					try {
						responseData = JSON.parse(res.data);
					} catch (error) {
						reject(new Error('API返回数据格式错误'));
						return;
					}
				}
				const qwenResponse = responseData as QwenResponse;
				if (
					!qwenResponse ||
					!qwenResponse.output ||
					!qwenResponse.output.choices ||
					qwenResponse.output.choices.length === 0
				) {
					reject(new Error('API返回数据格式错误：缺少output.choices'));
					return;
				}
				const content = qwenResponse.output.choices[0].message.content;
				try {
					resolve(parseFn(content));
				} catch (error: any) {
					reject(new Error(`解析返回结果失败: ${error.message || 'JSON格式错误'}`));
				}
			},
			fail: (error: any) => {
				reject(new Error(`API调用失败: ${error.errMsg || '网络错误'}`));
			}
		});
	});
}

/**
 * 情侣合婚（双图，或报告+单图）
 */
export async function analyzeFaceMatch(request: FaceMatchAnalyzeRequest): Promise<FaceMatchResult> {
	const locale: AppLocale = request.locale != null ? request.locale : 'zh';
	const hasReport = request.personAReportJson != null && request.personAReportJson.length > 0;

	if (hasReport) {
		const prompt = buildFaceMatchWithReportPrompt(locale, request.personAReportJson!);
		const apiRequest: UTSJSONObject = {
			model: QWEN_CONFIG.model,
			analysis_type: request.analysis_type != null ? request.analysis_type : 'face_match_report',
			input: {
				messages: [
					{
						role: 'user',
						content: [
							{ type: 'text', text: prompt },
							{ type: 'image', image: request.personBImage }
						]
					}
				]
			},
			parameters: {
				temperature: 0.15,
				max_tokens: 8000,
				top_p: 0.85
			}
		};
		return callQwenTextOrVision(apiRequest, parseFaceMatchResponse);
	}

	const prompt = buildFaceMatchPrompt(locale);
	const apiRequest: UTSJSONObject = {
		model: QWEN_CONFIG.model,
		analysis_type: request.analysis_type != null ? request.analysis_type : 'face_match',
		input: {
			messages: [
				{
					role: 'user',
					content: [
						{ type: 'text', text: prompt },
						{ type: 'image', image: request.personAImage != null ? request.personAImage : '' },
						{ type: 'image', image: request.personBImage }
					]
				}
			]
		},
		parameters: {
			temperature: 0.15,
			max_tokens: 8000,
			top_p: 0.85
		}
	};
	return callQwenTextOrVision(apiRequest, parseFaceMatchResponse);
}

/**
 * 形象开运深度方案（基于已有报告 JSON，纯文本二次请求）
 */
export async function analyzeFaceImprovement(request: FaceImprovementAnalyzeRequest): Promise<FaceImprovementResult> {
	const locale: AppLocale = request.locale != null ? request.locale : 'zh';
	const prompt = buildFaceImprovementPrompt(locale, request.reportJson);
	const apiRequest: UTSJSONObject = {
		model: QWEN_CONFIG.model,
		analysis_type: request.analysis_type != null ? request.analysis_type : 'face_improvement',
		input: {
			messages: [
				{
					role: 'user',
					content: [{ type: 'text', text: prompt }]
				}
			]
		},
		parameters: {
			temperature: 0.2,
			max_tokens: 6000,
			top_p: 0.85
		}
	};
	return callQwenTextOrVision(apiRequest, parseFaceImprovementResponse);
}
