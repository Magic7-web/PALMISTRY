	}
}

/**
 * 调用千问 VL 模型分析面相
 */
export async function analyzeFace(request: FaceAnalyzeRequest): Promise<FaceAnalysisResult> {
	try {
		const imageData = request.imagePath;
		const locale: AppLocale = request.locale != null ? request.locale : 'zh';
		const prompt = buildFacePrompt(locale);

		const apiRequest: UTSJSONObject = {
			model: QWEN_CONFIG.model,
			analysis_type: request.analysis_type != null ? request.analysis_type : 'face',
			input: {
				messages: [
					{
						role: 'user',
						content: [
							{ type: 'text', text: prompt },
							{ type: 'image', image: imageData }
						]
					}
				]
			},
			parameters: {
				temperature: 0.1,
				max_tokens: 10000,
				top_p: 0.8
			}
		};

		return new Promise<FaceAnalysisResult>((resolve, reject) => {
			uni.request({
				url: QWEN_CONFIG.endpoint,
				method: 'POST',
				header: buildQwenRequestHeaders(),
				data: apiRequest,
				timeout: QWEN_CONFIG.timeout,
				success: (res: any) => {
					if (res.statusCode !== 200) {
						reject(new Error(`API调用失败: HTTP ${res.statusCode}, ${extractProxyErrorMessage(res)}`));
						return;
					}
					if (res.data != null && res.data.success === false) {
						reject(new Error(extractProxyErrorMessage(res)));
						return;
					}
					if (!res.data) {
						reject(new Error('API返回数据为空'));
						return;
					}

					let responseData = res.data;
					if (typeof res.data === 'string') {
						try {
							responseData = JSON.parse(res.data);
						} catch (error) {
							reject(new Error('API返回数据格式错误'));
							return;
						}
					}

					const qwenResponse = responseData as QwenResponse;
					if (
						!qwenResponse ||
						!qwenResponse.output ||
						!qwenResponse.output.choices ||
						qwenResponse.output.choices.length === 0
					) {
						reject(new Error('API返回数据格式错误：缺少output.choices'));
						return;
					}

					const content = qwenResponse.output.choices[0].message.content;
					try {
						const result = parseFaceResponse(content);
						resolve(result);
					} catch (error: any) {
						reject(new Error(`解析返回结果失败: ${error.message || 'JSON格式错误'}`));
					}
				},
				fail: (error: any) => {
					const errorMsg = error.errMsg || '网络错误';
					reject(new Error(`API调用失败: ${errorMsg}`));
				}
			});
		});
	} catch (error) {
		console.error('面相识别失败:', error);
		throw error;
	}
}

/**
 * 解析面相 API 返回的 JSON 内容
 */
function parseFaceResponse(content: string | any): FaceAnalysisResult {
	try {
		let jsonString = normalizeQwenMessageContent(content);
		jsonString = jsonString.trim();
		jsonString = jsonString.replace(/```json\s*/g, '');
		jsonString = jsonString.replace(/```\s*/g, '');
		jsonString = jsonString.trim();
		const startIndex = jsonString.indexOf('{');
		const endIndex = jsonString.lastIndexOf('}');
		if (startIndex >= 0 && endIndex > startIndex) {
			jsonString = jsonString.substring(startIndex, endIndex + 1);
		}

		const result = JSON.parse(jsonString) as FaceAnalysisResult;
		if (
			!result.archive ||
			!result.threeSections ||
			!result.fiveOfficials ||
			!result.keyPalaces ||
			!result.coreFortunes ||
			!result.improvement
		) {
			throw new Error('返回结果格式不正确：缺少必要字段');
		}
		if (result.fiveOfficials == null) {
			result.fiveOfficials = [];
		}
		if (result.keyPalaces == null) {
			result.keyPalaces = [];
		}
		return result;
	} catch (error) {
		console.error('面相 JSON 解析失败:', error);
		console.error('原始 content:', content);
		return createFailedFaceResult('识别失败，请重试或检查图片质量', 'Analysis failed, please retry');
	}
}

