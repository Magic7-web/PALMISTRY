  },
  "dimensions": {
    "handType": { "title": "五行命格", "titleEn": "Five Elements / Hand Type", "content": "四段式80-140字", "contentEn": "Four-part English analysis" },
    "palmMounds": { "title": "星丘压制", "titleEn": "Mounts", "content": "四段式长文", "contentEn": "Four-part English analysis" },
    "specialMarks": { "title": "凶吉征兆", "titleEn": "Signs", "content": "四段式长文", "contentEn": "Four-part English analysis" },
    "personality": { "title": "性格底色", "titleEn": "Personality Core", "content": "四段式长文", "contentEn": "Four-part English analysis" },
    "career": { "title": "财官利禄", "titleEn": "Career & Wealth", "content": "四段式长文", "contentEn": "Four-part English analysis" },
    "love": { "title": "红尘情孽", "titleEn": "Love & Relationships", "content": "四段式长文", "contentEn": "Four-part English analysis" },
    "health": { "title": "命元警示", "titleEn": "Health", "content": "四段式长文", "contentEn": "Four-part English analysis" },
    "recentLuck": { "title": "近期提醒", "titleEn": "Recent Outlook", "content": "四段式长文", "contentEn": "Four-part English analysis" }
  },
  "harshWarning": "【致命命理警示】120-180字，犀利具体。",
  "harshWarningEn": "English warning, same depth.",
  "overallAnalysis": "综合命定结论：120-180字，整合全局。",
  "overallAnalysisEn": "Overall conclusion in English, same depth.",
  "lineDetails": [
    {
      "type": "wisdom",
      "typeName": "智慧线",
      "typeNameEn": "Head Line",
      "description": "50-80字线条描述",
