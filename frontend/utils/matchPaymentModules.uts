/**
 * 合婚深度解读模块定价
 */

export type MatchPaymentModule = {
	id: string;
	priceCny: string;
	priceUsd: string;
};

/** 合婚付费模块（与报告字段一一对应） */
export const MATCH_PAYMENT_MODULES: MatchPaymentModule[] = [
	{ id: 'complementarity', priceCny: '4.90', priceUsd: '1.99' },
	{ id: 'domestic', priceCny: '0.50', priceUsd: '0.19' },
	{ id: 'career', priceCny: '0.50', priceUsd: '0.19' },
	{ id: 'shortTrend', priceCny: '1.00', priceUsd: '0.39' },
	{ id: 'midTrend', priceCny: '1.00', priceUsd: '0.39' },
	{ id: 'conflict', priceCny: '4.90', priceUsd: '1.99' },
	{ id: 'advice', priceCny: '4.90', priceUsd: '1.99' }
];

export const MATCH_PAYMENT_BUNDLE = {
	id: 'all',
	title: '全部解锁',
	titleEn: 'Unlock all',
	priceCny: '13.90',
	priceUsd: '5.99',
	moduleIds: MATCH_PAYMENT_MODULES.map((item) => item.id)
};

export function getMatchPaymentModuleById(moduleId: string): MatchPaymentModule | null {
	for (let i = 0; i < MATCH_PAYMENT_MODULES.length; i += 1) {
		if (MATCH_PAYMENT_MODULES[i].id === moduleId) {
			return MATCH_PAYMENT_MODULES[i];
		}
	}
	return null;
}

export function formatMatchPriceLabel(locale: string, priceCny: string, priceUsd: string): string {
	if (locale === 'en') {
		return `$${priceUsd}`;
	}
	const num = parseFloat(priceCny);
	if (num < 1) {
		const cents = Math.round(num * 10);
		return `¥${(cents / 10).toFixed(1)}`;
	}
	if (priceCny.endsWith('0')) {
		return `¥${parseFloat(priceCny).toFixed(1)}`;
	}
	return `¥${priceCny}`;
}
