import type { FaceMatchReport, FaceMatchResult } from '@/types/index';

/** 合婚会话（支持单人先测 + 邀请对方补全 + 从面相报告带入） */
export interface FaceMatchSessionSnapshot {
	matchId: string;
	personAImage: string | null;
	personBImage: string | null;
	reportData: FaceMatchReport | null;
	isPartnerFlow: boolean;
	/** 从面相报告页进入，A 方已有完整报告 */
	fromFaceReport: boolean;
	personAReportJson: string | null;
	/** 是否已通过微信解锁完整合婚报告（本地记忆，刷新后保留，旧版兼容） */
	matchUnlocked: boolean;
	/** 已付费解锁的合婚模块 ID（可选，旧会话无此字段） */
	unlockedModuleIds?: string[] | null;
	/** 是否已生成合婚报告（报告正文单独存储，避免大图撑爆 localStorage） */
	hasGeneratedReport?: boolean;
	/** 分析进行中离开页面时为 true，返回后可继续分析 */
	analysisPending?: boolean;
	createdAt: number;
}

/** 持久化的合婚报告（不含大图，体积可控） */
interface FaceMatchReportPersisted {
	id: string;
	matchId: string;
	analyzeTime: string;
	fullData: FaceMatchResult;
}

const MATCH_SESSION_PREFIX = 'face_match_session_';
const MATCH_REPORT_PREFIX = 'face_match_report_';

function getMatchKey(matchId: string): string {
	return `${MATCH_SESSION_PREFIX}${matchId}`;
}

function getReportKey(matchId: string): string {
	return `${MATCH_REPORT_PREFIX}${matchId}`;
}

function safeRead<T>(key: string, fallback: T): T {
	try {
		const value = uni.getStorageSync(key);
		if (value != null) {
			return value as T;
		}
	} catch (error) {
		console.error(`读取本地存储失败: ${key}`, error);
	}
	return fallback;
}

function isPersistedReport(value: any): boolean {
	return value != null
		&& typeof value.matchId === 'string'
		&& typeof value.analyzeTime === 'string'
		&& value.fullData != null;
}

function toPersistedReport(report: FaceMatchReport): FaceMatchReportPersisted {
	return {
		id: report.id,
		matchId: report.matchId,
		analyzeTime: report.analyzeTime,
		fullData: report.fullData
	};
}

function toFaceMatchReport(
	persisted: FaceMatchReportPersisted,
	personAImage: string | null,
	personBImage: string | null
): FaceMatchReport {
	return {
		id: persisted.id,
		matchId: persisted.matchId,
		analyzeTime: persisted.analyzeTime,
		fullData: persisted.fullData,
		personAImage: personAImage != null ? personAImage : '',
		personBImage: personBImage != null ? personBImage : ''
	};
}

/** 单独保存合婚报告正文（不含 base64 照片），刷新后必须能恢复 */
export function saveFaceMatchReport(matchId: string, report: FaceMatchReport): boolean {
	if (!matchId || report == null || report.fullData == null) {
		return false;
	}
	try {
		uni.setStorageSync(getReportKey(matchId), toPersistedReport(report));
		return true;
	} catch (error) {
		console.error('保存合婚报告失败', error);
		return false;
	}
}

export function loadFaceMatchReport(
	matchId: string,
	personAImage: string | null,
	personBImage: string | null
): FaceMatchReport | null {
	if (!matchId) {
		return null;
	}
	const persisted = safeRead<FaceMatchReportPersisted | null>(getReportKey(matchId), null);
	if (!isPersistedReport(persisted)) {
		return null;
	}
	return toFaceMatchReport(persisted as FaceMatchReportPersisted, personAImage, personBImage);
}

export function clearFaceMatchReport(matchId: string): void {
	try {
		uni.removeStorageSync(getReportKey(matchId));
	} catch (error) {
		console.error('清除合婚报告失败', error);
	}
}

export function createMatchId(): string {
	return `match_${Date.now()}`;
}

/** 列出本地所有合婚相关 storage 的 matchId */
function listMatchStorageIds(): { sessionIds: string[]; reportOnlyIds: string[] } {
	const sessionIds: string[] = [];
	const reportOnlyIds: string[] = [];
	const reportIdSet: Record<string, boolean> = {};
	try {
		const info = uni.getStorageInfoSync();
		const keys = info.keys != null ? info.keys : [];
		for (let i = 0; i < keys.length; i += 1) {
			const key = keys[i];
			if (key.startsWith(MATCH_SESSION_PREFIX)) {
				sessionIds.push(key.substring(MATCH_SESSION_PREFIX.length));
			} else if (key.startsWith(MATCH_REPORT_PREFIX)) {
				const id = key.substring(MATCH_REPORT_PREFIX.length);
				reportIdSet[id] = true;
			}
		}
		for (const id in reportIdSet) {
			let hasSession = false;
			for (let i = 0; i < sessionIds.length; i += 1) {
				if (sessionIds[i] === id) {
					hasSession = true;
					break;
				}
			}
			if (!hasSession) {
				reportOnlyIds.push(id);
			}
		}
	} catch (error) {
		console.warn('枚举合婚 storage 失败', error);
	}
	return { sessionIds, reportOnlyIds };
}

/**
 * 清理过期且无报告的合婚会话（不删除已有报告，避免误删用户历史合婚）
 */
export function pruneMatchSessionsIfNeeded(keepMatchId: string): void {
	if (keepMatchId == null || keepMatchId.length === 0) {
		return;
	}
	const MAX_SESSIONS = 12;
	const MAX_AGE_MS = 30 * 24 * 60 * 60 * 1000;
	const now = Date.now();
	const { sessionIds } = listMatchStorageIds();

	type SessionEntry = {
		id: string;
		createdAt: number;
		hasReport: boolean;
	};

	const entries: SessionEntry[] = [];
	for (let i = 0; i < sessionIds.length; i += 1) {
		const id = sessionIds[i];
		const snapshot = safeRead<FaceMatchSessionSnapshot | null>(getMatchKey(id), null);
		if (snapshot == null) {
			continue;
		}
		const hasReport = snapshot.hasGeneratedReport === true
			|| snapshot.reportData != null
			|| safeRead<FaceMatchReportPersisted | null>(getReportKey(id), null) != null;
		entries.push({
			id,
			createdAt: snapshot.createdAt > 0 ? snapshot.createdAt : 0,
			hasReport
		});
	}

	const removeSession = (id: string): void => {
		if (id === keepMatchId) {
			return;
		}
		try {
			uni.removeStorageSync(getMatchKey(id));
		} catch (error) {
			console.warn('清理旧合婚会话失败', id, error);
		}
		clearFaceMatchReport(id);
	};

	for (let i = 0; i < entries.length; i += 1) {
		const entry = entries[i];
		if (entry.id === keepMatchId || entry.hasReport) {
			continue;
		}
		if (entry.createdAt > 0 && now - entry.createdAt > MAX_AGE_MS) {
			removeSession(entry.id);
		}
	}

	if (entries.length <= MAX_SESSIONS) {
		return;
	}

	const removable = entries
		.filter((entry) => entry.id !== keepMatchId && !entry.hasReport)
		.sort((a, b) => a.createdAt - b.createdAt);

	let remaining = entries.length;
	for (let i = 0; i < removable.length && remaining > MAX_SESSIONS; i += 1) {
		removeSession(removable[i].id);
		remaining -= 1;
	}
}

/** @deprecated 使用 pruneMatchSessionsIfNeeded */
export function pruneStaleMatchSessions(keepMatchId: string): void {
	pruneMatchSessionsIfNeeded(keepMatchId);
}

/** @returns 是否至少保存了会话元数据；报告单独 key 保存成功时 hasGeneratedReport 为 true */
export function saveFaceMatchSession(snapshot: FaceMatchSessionSnapshot): boolean {
	const hasReport = snapshot.reportData != null && snapshot.reportData.fullData != null;
	let reportSaved = true;
	if (hasReport) {
		reportSaved = saveFaceMatchReport(snapshot.matchId, snapshot.reportData as FaceMatchReport);
	}

	const existing = safeRead<FaceMatchSessionSnapshot | null>(getMatchKey(snapshot.matchId), null);
	const keepHasReport = existing != null && existing.hasGeneratedReport === true;

	const sessionPayload: FaceMatchSessionSnapshot = {
		matchId: snapshot.matchId,
		personAImage: snapshot.personAImage,
		personBImage: snapshot.personBImage,
		reportData: null,
		isPartnerFlow: snapshot.isPartnerFlow,
		fromFaceReport: snapshot.fromFaceReport,
		personAReportJson: snapshot.personAReportJson,
		matchUnlocked: snapshot.matchUnlocked,
		unlockedModuleIds: snapshot.unlockedModuleIds,
		hasGeneratedReport: hasReport || snapshot.hasGeneratedReport === true || keepHasReport,
		analysisPending: snapshot.analysisPending === true,
		createdAt: snapshot.createdAt
	};

	try {
		uni.setStorageSync(getMatchKey(snapshot.matchId), sessionPayload);
		uni.setStorageSync('face_match_active_id', snapshot.matchId);
		pruneMatchSessionsIfNeeded(snapshot.matchId);
		return reportSaved;
	} catch (error) {
		console.error('保存合婚会话失败（含图片），尝试精简保存', error);
	}

	try {
		const slimPayload: FaceMatchSessionSnapshot = {
			...sessionPayload,
			personAImage: null,
			personBImage: null
		};
		uni.setStorageSync(getMatchKey(snapshot.matchId), slimPayload);
		uni.setStorageSync('face_match_active_id', snapshot.matchId);
		pruneMatchSessionsIfNeeded(snapshot.matchId);
		return reportSaved;
	} catch (error) {
		console.error('保存合婚会话失败', error);
		return false;
	}
}

function hydrateReportForSession(snapshot: FaceMatchSessionSnapshot): FaceMatchSessionSnapshot {
	if (snapshot.reportData != null && snapshot.reportData.fullData != null) {
		snapshot.hasGeneratedReport = true;
		return snapshot;
	}

	const loadedReport = loadFaceMatchReport(
		snapshot.matchId,
		snapshot.personAImage,
		snapshot.personBImage
	);
	if (loadedReport != null) {
		snapshot.reportData = loadedReport;
		snapshot.hasGeneratedReport = true;
		return snapshot;
	}

	if (snapshot.hasGeneratedReport === true) {
		console.warn('合婚报告标记存在但正文读取失败', snapshot.matchId);
	}

	return snapshot;
}

export function loadFaceMatchSession(matchId: string): FaceMatchSessionSnapshot | null {
	if (!matchId) {
		return null;
	}
	const raw = safeRead<FaceMatchSessionSnapshot | null>(getMatchKey(matchId), null);
	if (raw == null) {
		return null;
	}

	// 兼容旧版：报告嵌在 session 里，迁移到独立 key
	if (raw.reportData != null && raw.reportData.fullData != null) {
		saveFaceMatchReport(matchId, raw.reportData);
		raw.hasGeneratedReport = true;
		return raw;
	}

	return hydrateReportForSession(raw);
}

/** 查找最近一份已生成合婚报告的会话 */
export function findLatestSessionWithReport(): FaceMatchSessionSnapshot | null {
	const { sessionIds } = listMatchStorageIds();
	let best: FaceMatchSessionSnapshot | null = null;
	let bestAt = 0;
	for (let i = 0; i < sessionIds.length; i += 1) {
		const id = sessionIds[i];
		const session = loadFaceMatchSession(id);
		if (session == null) {
			continue;
		}
		const hasReport = session.reportData != null || session.hasGeneratedReport === true;
		if (!hasReport) {
			continue;
		}
		const createdAt = session.createdAt > 0 ? session.createdAt : 0;
		if (session.reportData != null || createdAt >= bestAt) {
			best = session;
			bestAt = createdAt;
		}
	}
	return best;
}

export function loadActiveFaceMatchSession(): FaceMatchSessionSnapshot | null {
	const activeId = safeRead<string>('face_match_active_id', '');
	if (activeId.length === 0) {
		return findLatestSessionWithReport();
	}
	const active = loadFaceMatchSession(activeId);
	if (active == null) {
		return findLatestSessionWithReport();
	}
	const hasReport = active.reportData != null || active.hasGeneratedReport === true;
	if (hasReport) {
		return active;
	}
	const inProgress = active.analysisPending === true
		|| (active.personBImage != null && active.personBImage.length > 0);
	if (inProgress) {
		return active;
	}
	const latestWithReport = findLatestSessionWithReport();
	if (latestWithReport != null && latestWithReport.matchId !== activeId) {
		return latestWithReport;
	}
	return active;
}

/**
 * 当前会话无报告且未进行中时，返回最近一份已完成报告的会话（供页面恢复展示）
 */
export function recoverCompletedMatchSession(currentMatchId: string): FaceMatchSessionSnapshot | null {
	if (currentMatchId.length === 0) {
		return findLatestSessionWithReport();
	}
	const current = loadFaceMatchSession(currentMatchId);
	if (current != null) {
		const inProgress = current.analysisPending === true
			|| (current.personBImage != null && current.personBImage.length > 0);
		if (inProgress) {
			return null;
		}
		if (current.reportData != null || current.hasGeneratedReport === true) {
			return null;
		}
	}
	const latest = findLatestSessionWithReport();
	if (latest == null || latest.matchId === currentMatchId) {
		return null;
	}
	return latest;
}

export function clearFaceMatchSession(matchId: string): void {
	try {
		uni.removeStorageSync(getMatchKey(matchId));
		clearFaceMatchReport(matchId);
		const activeId = safeRead<string>('face_match_active_id', '');
		if (activeId === matchId) {
			uni.removeStorageSync('face_match_active_id');
		}
	} catch (error) {
		console.error('清除合婚会话失败', error);
	}
}
