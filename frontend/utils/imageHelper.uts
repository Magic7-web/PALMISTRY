/**
 * 图片处理工具函数
 */

/**
 * 是否已是可直接传给 Qwen 的图片数据
 */
/** blob URL 刷新后会失效，不应写入本地快照 */
export function isEphemeralImagePath(imagePath: string): boolean {
	return imagePath != null && imagePath.startsWith('blob:');
}

export function isApiReadyImage(imagePath: string): boolean {
	if (imagePath == null || imagePath.length === 0) {
		return false;
	}
	return (
		imagePath.startsWith('data:image/') ||
		imagePath.startsWith('http://') ||
		imagePath.startsWith('https://')
	);
}

/**
 * 解析可用于 API 的图片：优先 base64，依次尝试主路径与备用路径
 */
export async function resolveImageForApi(
	primaryPath: string,
	fallbackPath?: string | null
): Promise<string> {
	const candidates: string[] = [];
	if (primaryPath != null && primaryPath.length > 0) {
		candidates.push(primaryPath);
	}
	if (fallbackPath != null && fallbackPath.length > 0 && fallbackPath !== primaryPath) {
		candidates.push(fallbackPath);
	}

	for (let i = 0; i < candidates.length; i += 1) {
		const path = candidates[i];
		// blob URL 在 H5 可即时转 base64，不应直接跳过
		if (isEphemeralImagePath(path)) {
			try {
				const converted = await convertImageToBase64ForApi(path);
				if (isApiReadyImage(converted)) {
					return converted;
				}
			} catch (error) {
				console.warn('resolveImageForApi blob 转换失败:', path, error);
			}
			continue;
		}
		if (isApiReadyImage(path)) {
			return path;
		}
		try {
			const converted = await convertImageToBase64ForApi(path);
			if (isApiReadyImage(converted)) {
				return converted;
			}
		} catch (error) {
			console.warn('resolveImageForApi 转换失败:', path, error);
		}
	}

	throw new Error('无法获取有效图片，请重新拍照后再试');
}

/** H5 本地快照用的缩略图（约 200KB 内） */
const STORAGE_IMAGE_MAX_LENGTH = 220 * 1024;

/**
 * 压缩图片用于 localStorage 持久化（不影响 API 请求用的原图）
 */
export function compressImageForStorage(dataUrl: string): Promise<string> {
	if (!dataUrl.startsWith('data:image/')) {
		return Promise.resolve(dataUrl);
	}
	if (dataUrl.length <= STORAGE_IMAGE_MAX_LENGTH) {
		return Promise.resolve(dataUrl);
	}
	return new Promise((resolve) => {
		// #ifdef H5
		const img = new Image();
		img.onload = () => {
			try {
				const canvas = document.createElement('canvas');
				let width = img.width;
				let height = img.height;
				const maxDim = 480;
				if (width > maxDim || height > maxDim) {
					if (width >= height) {
						height = Math.round((height * maxDim) / width);
						width = maxDim;
					} else {
						width = Math.round((width * maxDim) / height);
						height = maxDim;
					}
				}
				canvas.width = width;
				canvas.height = height;
				const ctx = canvas.getContext('2d');
				if (ctx == null) {
					resolve(dataUrl);
					return;
				}
				ctx.drawImage(img, 0, 0, width, height);
				let quality = 0.72;
				let result = canvas.toDataURL('image/jpeg', quality);
				while (result.length > STORAGE_IMAGE_MAX_LENGTH && quality > 0.35) {
					quality -= 0.08;
					result = canvas.toDataURL('image/jpeg', quality);
				}
				resolve(result);
			} catch (error) {
				console.warn('本地快照压缩失败，跳过图片', error);
				resolve('');
			}
		};
		img.onerror = () => resolve('');
		img.src = dataUrl;
		// #endif
		// #ifndef H5
		resolve(dataUrl);
		// #endif
	});
}

/**
 * API 请求允许的 base64 字符串最大长度（约 3MB 图片）
 */
const API_IMAGE_MAX_LENGTH = 3 * 1024 * 1024;

/**
 * H5 端用 canvas 压缩过大的 data URL
 */
function compressDataUrlOnH5(dataUrl: string): Promise<string> {
	return new Promise((resolve, reject) => {
		// #ifdef H5
		const img = new Image();
		img.onload = () => {
			try {
				const canvas = document.createElement('canvas');
				let width = img.width;
				let height = img.height;
				const maxDim = 1280;
				if (width > maxDim || height > maxDim) {
					if (width >= height) {
						height = Math.round((height * maxDim) / width);
						width = maxDim;
					} else {
						width = Math.round((width * maxDim) / height);
						height = maxDim;
					}
				}
				canvas.width = width;
				canvas.height = height;
				const ctx = canvas.getContext('2d');
				if (ctx == null) {
					resolve(dataUrl);
					return;
				}
				ctx.drawImage(img, 0, 0, width, height);
				let quality = 0.82;
				let result = canvas.toDataURL('image/jpeg', quality);
				while (result.length > API_IMAGE_MAX_LENGTH && quality > 0.45) {
					quality -= 0.08;
					result = canvas.toDataURL('image/jpeg', quality);
				}
				console.log(
					'图片压缩完成，原长度:',
					dataUrl.length,
					'压缩后:',
					result.length,
					'quality:',
					quality
				);
				resolve(result);
			} catch (error) {
				console.warn('图片压缩失败，使用原图', error);
				resolve(dataUrl);
			}
		};
		img.onerror = () => {
			reject(new Error('图片压缩加载失败'));
		};
		img.src = dataUrl;
		// #endif
		// #ifndef H5
		resolve(dataUrl);
		// #endif
	});
}

/**
 * 若 base64 过大则压缩，避免 POST 413
 */
export function compressImageForApi(dataUrl: string): Promise<string> {
	if (!dataUrl.startsWith('data:image/')) {
		return Promise.resolve(dataUrl);
	}
	if (dataUrl.length <= API_IMAGE_MAX_LENGTH) {
		return Promise.resolve(dataUrl);
	}
	console.log('图片过大，开始压缩，当前长度:', dataUrl.length);
	return compressDataUrlOnH5(dataUrl);
}

/**
 * 转为 base64 并压缩，供 API 调用使用
 */
export async function convertImageToBase64ForApi(imagePath: string): Promise<string> {
	const raw = await convertImageToBase64(imagePath);
	if (raw.startsWith('data:image/')) {
		return await compressImageForApi(raw);
	}
	return raw;
}

/**
 * 将图片路径转为base64
 * 注意：uni-app x中需要先获取图片信息，然后读取文件
 * 支持blob URL、网络URL和本地路径
 */
export function convertImageToBase64(imagePath: string): Promise<string> {
	return new Promise((resolve, reject) => {
		console.log('开始转换图片为base64，图片路径:', imagePath.substring(0, 80));

		if (imagePath.startsWith('data:image/')) {
			resolve(imagePath);
			return;
		}
		
		// #ifdef H5
		// H5平台处理blob URL
		if (imagePath.startsWith('blob:')) {
			console.log('检测到blob URL，开始转换为base64...');
			try {
				if (typeof fetch !== 'undefined') {
					// 使用fetch获取blob
					fetch(imagePath)
						.then(response => response.blob())
						.then(blob => {
							const reader = new FileReader();
							reader.onloadend = () => {
								const base64 = reader.result as string;
								console.log('blob转base64成功，长度:', base64.length);
								resolve(base64);
							};
							reader.onerror = (error) => {
								console.error('FileReader读取失败:', error);
								reject(new Error('blob转base64失败'));
							};
							reader.readAsDataURL(blob);
						})
						.catch((error) => {
							console.error('fetch blob失败:', error);
							reject(error);
						});
				} else {
					// 如果没有fetch，尝试直接使用路径
					console.warn('H5平台不支持fetch，直接使用blob URL');
					resolve(imagePath);
				}
			} catch (error) {
				console.error('处理blob URL失败:', error);
				reject(error);
			}
			return;
		}
		// #endif
		
		// 网络图片
		if (imagePath.startsWith('http://') || imagePath.startsWith('https://')) {
			console.log('检测到网络URL，直接使用');
			resolve(imagePath);
			return;
		}
		
		// 本地图片，尝试读取文件
		console.log('检测到本地路径，使用文件系统API读取...');
		try {
			const fs = uni.getFileSystemManager();
			if (fs) {
				fs.readFile({
					filePath: imagePath,
					encoding: 'base64',
					success: (res) => {
						const base64 = res.data as string;
						// 添加data URI前缀
						const dataUri = `data:image/jpeg;base64,${base64}`;
						console.log('本地文件转base64成功，长度:', dataUri.length);
						resolve(dataUri);
					},
					fail: (error) => {
						console.error('图片转base64失败', error);
						// 如果读取失败，尝试直接使用路径（让API自己处理）
						console.warn('文件读取失败，直接使用路径');
						resolve(imagePath);
					}
				});
			} else {
				// 如果没有文件系统API，直接返回路径
				console.warn('文件系统API不可用，直接使用路径');
				resolve(imagePath);
			}
		} catch (error) {
			console.error('读取图片文件失败', error);
			// 如果出错，直接返回路径
			resolve(imagePath);
		}
	});
}

/**
 * 获取图片信息
 */
export function getImageInfo(imagePath: string): Promise<{width: number, height: number}> {
	return new Promise((resolve, reject) => {
		uni.getImageInfo({
			src: imagePath,
			success: (res) => {
				resolve({
					width: res.width,
					height: res.height
				});
			},
			fail: (error) => {
				console.error('获取图片信息失败', error);
				reject(error);
			}
		});
	});
}
