/**
 * 应用界面语言：持久化与文案
 */

export type AppLocale = 'zh' | 'en';

const STORAGE_KEY = 'app_locale';

/**
 * 读取已保存语言，无记录时默认英文
 */
export function getAppLocale(): AppLocale {
	try {
		const v = uni.getStorageSync(STORAGE_KEY) as string;
		if (v === 'en' || v === 'zh') {
			return v as AppLocale;
		}
	} catch (e) {
		console.error('getAppLocale', e);
	}
	return 'en';
}

/**
 * 保存语言并写入本地存储
 */
export function setAppLocale(locale: AppLocale): void {
	try {
		uni.setStorageSync(STORAGE_KEY, locale);
	} catch (e) {
		console.error('setAppLocale', e);
	}
}

/**
 * 按当前语言选取中文或英文（英文缺省时回退中文）
 */
export function pickLocaleText(locale: AppLocale, zhText: string, enText?: string | null): string {
	if (locale === 'en' && enText != null && enText.length > 0 && enText !== '-') {
		return enText;
	}
	return zhText;
}

