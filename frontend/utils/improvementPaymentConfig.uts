/**
 * 形象开运深度方案定价
 */

export const IMPROVEMENT_PAYMENT = {
	moduleId: 'face_improvement',
	priceCny: '6.90',
	priceUsd: '2.79',
	titleZh: '形象开运完整方案',
	titleEn: 'Full Image Enhancement Plan'
};

export function formatImprovementPriceLabel(locale: string): string {
	if (locale === 'en') {
		return `$${IMPROVEMENT_PAYMENT.priceUsd}`;
	}
	const num = parseFloat(IMPROVEMENT_PAYMENT.priceCny);
	if (num < 10 && IMPROVEMENT_PAYMENT.priceCny.endsWith('0')) {
		return `¥${num.toFixed(1)}`;
	}
	return `¥${IMPROVEMENT_PAYMENT.priceCny}`;
}
