/**
 * 修复 AI 返回的非标准 JSON，提高 parse 成功率。
 */

/** 从 markdown 或混杂文本中提取 JSON 对象片段 */
export function extractJsonObject(raw: string): string {
	let text = raw.trim();
	text = text.replace(/```json\s*/gi, '');
	text = text.replace(/```\s*/g, '');
	text = text.trim();

	const start = text.indexOf('{');
	const end = text.lastIndexOf('}');
	if (start >= 0 && end > start) {
		text = text.substring(start, end + 1);
	}
	return text;
}

/** 去除尾逗号、智能引号，并尝试补齐截断括号 */
export function repairJsonString(jsonString: string): string {
	let text = jsonString;
	text = text.replace(/[\u201c\u201d]/g, '"');
	text = text.replace(/[\u2018\u2019]/g, "'");
	text = text.replace(/,\s*([}\]])/g, '$1');
	text = text.replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f]/g, '');
	text = balanceJsonBrackets(text);
	return text;
}

function balanceJsonBrackets(text: string): string {
	let inString = false;
	let escaped = false;
	let openCurly = 0;
	let openSquare = 0;

	for (let i = 0; i < text.length; i += 1) {
		const ch = text.charAt(i);
		if (escaped) {
			escaped = false;
			continue;
		}
		if (ch === '\\' && inString) {
			escaped = true;
			continue;
		}
		if (ch === '"') {
			inString = !inString;
			continue;
		}
		if (inString) {
			continue;
		}
		if (ch === '{') {
			openCurly += 1;
		} else if (ch === '}') {
			openCurly -= 1;
		} else if (ch === '[') {
			openSquare += 1;
		} else if (ch === ']') {
			openSquare -= 1;
		}
	}

	let suffix = '';
	for (let i = 0; i < openSquare; i += 1) {
		suffix += ']';
	}
	for (let i = 0; i < openCurly; i += 1) {
		suffix += '}';
	}
	return text + suffix;
}

/**
 * 先直接 parse，失败则修复后再 parse。
 * @returns 解析成功返回对象，失败返回 null
 */
export function safeParseJson(raw: string | any): any | null {
	if (raw == null) {
		return null;
	}
	if (typeof raw === 'object') {
		return raw;
	}

	const text = extractJsonObject(String(raw));
	try {
		return JSON.parse(text);
	} catch (firstError) {
		try {
			return JSON.parse(repairJsonString(text));
		} catch (secondError) {
			console.warn('safeParseJson: 修复后仍无法解析', secondError);
			return null;
		}
	}
}
