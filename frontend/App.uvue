	}

	/* #ifdef H5 */
	/* 强制 H5 端导航栏颜色与主题对齐 */
	uni-page-head {
		background-color: #fdf7ee !important;
	}
	uni-page-head .uni-page-head {
		background-color: #fdf7ee !important;
