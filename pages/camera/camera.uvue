		padding: 10rpx 30rpx;
		border-radius: 30rpx;
		font-size: 24rpx;
		letter-spacing: 2rpx;
		animation: termFade 1.5s infinite;
	}

	@keyframes termFade {
		0% { opacity: 0.5; transform: translateY(10rpx); }
		50% { opacity: 1; transform: translateY(0); }
		100% { opacity: 0.5; transform: translateY(-10rpx); }
