	.action-btn {
		flex: 1;
		margin: 0 10rpx;
		padding: 20rpx;
		border-radius: 10rpx;
		font-size: 28rpx;
		border: none;
	}

	.btn-cancel {
		background-color: #f0f0f0;
		color: #666;
	}

	.btn-confirm {
		background-color: #007aff;
		color: #fff;
	}

	.guide-area {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		min-height: 0;
	}

	.guide-box {
		width: 500rpx;
		height: 100%;
		max-height: 600rpx;
		border: 4rpx dashed #ddd;
		border-radius: 20rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		position: relative;
		background-color: #fafafa;
		box-sizing: border-box;
	}

	.hand-outline {
		width: 100%;
		height: 85%;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 30rpx;
		box-sizing: border-box;
	}

	.hand-image {
		width: 100%;
		height: 100%;
		max-width: 380rpx;
		max-height: 480rpx;
		opacity: 0.7;
		transition: transform 0.3s ease;
	}

	.hand-image.mirror {
		transform: scaleX(-1);
	}

	.guide-text {
		font-size: 24rpx;
		color: #666;
		text-align: center;
		padding: 20rpx;
		margin-top: 20rpx;
		line-height: 1.5;
	}

	.camera-footer {
		display: flex;
