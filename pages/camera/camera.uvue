	}

	.scale-icon {
		font-size: 40rpx;
		color: #fff;
		font-weight: bold;
		line-height: 1;
		pointer-events: none;
		user-select: none;
		-webkit-user-select: none;
	}

	.reset-btn .scale-icon {
		font-size: 36rpx;
	}

	/* PC端鼠标样式 */
	@media (pointer: fine) {
		.preview-container {
			cursor: move;
		}

		.scale-btn:hover {
			background-color: rgba(0, 122, 255, 0.8);
			transform: scale(1.05);
			border-color: rgba(255, 255, 255, 0.8);
		}
	}

	.preview-actions {
		display: flex;
		flex-direction: row;
		justify-content: space-around;
		margin-top: 30rpx;
