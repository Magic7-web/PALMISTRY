<template>
	<view class="report-container">
		<!-- 背景暗纹 -->
		<view class="bg-decoration">
			<view class="bg-bagua"></view>
		</view>

		<view class="report-content-wrapper">
			<view class="report-header">
				<view class="header-top-row">
					<view class="header-main-left">
						<text class="header-title">{{ ui.headerTitle }}</text>
						<image class="header-stamp" src="/static/favicon.png" mode="aspectFit"></image>
					</view>
					<view class="header-lang-inline">
						<button
							class="lang-btn lang-btn-inline"
							:class="{ active: locale === 'zh' }"
							@click="setLocale('zh')"
						>
							中文
						</button>
						<button
							class="lang-btn lang-btn-inline"
							:class="{ active: locale === 'en' }"
							@click="setLocale('en')"
						>
							EN
						</button>
					</view>
				</view>
				<view class="header-deco"></view>
				<text class="header-time" v-if="reportData">{{ reportData.analyzeTime }}</text>
			</view>

			<!-- 占位内容（分析中） -->
			<view class="analyzing-area" v-if="isAnalyzing">
				<view class="analyzing-content">
					<text class="analyzing-text">{{ ui.analyzing }}</text>
				</view>
			</view>

			<!-- 报告内容 -->
			<view class="report-content" v-if="reportData">
				<!-- 综合评价区 -->
				<view class="summary-section">
					<view class="section-header">
						<text class="section-title">{{ ui.chapter1 }}</text>
					</view>
					
					<!-- 致命命理警示 -->
					<view class="harsh-warning-card" v-if="reportData.fullData && reportData.fullData.harshWarning">
						<view class="warning-header">
							<image class="warning-stamp" src="/static/favicon.png" mode="aspectFit"></image>
							<text class="warning-title">{{ ui.warningTitle }}</text>
						</view>
						<view class="warning-content">
							<text class="warning-text">{{ pickTxt(reportData.fullData.harshWarning, reportData.fullData.harshWarningEn) }}</text>
						</view>
					</view>

					<view class="summary-grid" v-if="reportData.fullData">
						<view class="summary-item" v-for="(item, key) in reportData.fullData.summary" :key="key">
							<view class="summary-score-circle" :class="key + '-border'">
								<text class="summary-score">{{ item.score }}</text>
								<text class="summary-score-unit">{{ ui.scoreUnit }}</text>
							</view>
							<text class="summary-dim-name">{{ pickTxt(item.dimension, item.dimensionEn) }}</text>
						</view>
					</view>
				</view>

				<!-- 交互式手相图解 -->
				<view class="interactive-section">
					<view class="section-header">
						<text class="section-title">{{ ui.chapter2 }}</text>
						<text class="section-tips">{{ ui.chapter2Tip }}</text>
					</view>
					
					<view class="hand-visual-container">
						<view class="hand-visual-wrapper">
							<!-- 用户图片 (底层) -->
							<image 
								class="user-hand-image" 
								:src="reportData.imagePath" 
								mode="aspectFit"
							></image>
							
							<!-- 卡通手底图 (仅在未选中线条时显示，用于定位和参考) -->
							<image 
								v-if="!activeLineType"
								class="hand-base-image" 
								:class="{ 'mirror': handSide === 'right' }"
								src="/static/hand.png" 
								mode="aspectFit"
							></image>

							<!-- 动态线条层 -->
							<view class="hand-lines-glow-layer">
								<image 
									v-if="activeLineType === '生命线'" 
									class="line-glow-img" 
									:class="{ 'mirror': handSide === 'right' }"
									src="@/static/hand-life.png" 
									mode="aspectFit"
								></image>
								<image 
									v-if="activeLineType === '智慧线'" 
									class="line-glow-img" 
									:class="{ 'mirror': handSide === 'right' }"
									src="@/static/Cause-hand.png" 
									mode="aspectFit"
								></image>
								<image 
									v-if="activeLineType === '感情线'" 
									class="line-glow-img" 
									:class="{ 'mirror': handSide === 'right' }"
									src="@/static/feeling-hand.png" 
									mode="aspectFit"
								></image>
								<image 
									v-if="activeLineType === '命运线'" 
									class="line-glow-img" 
									:class="{ 'mirror': handSide === 'right' }"
									src="@/static/fate-hand.png" 
									mode="aspectFit"
								></image>
							</view>
						</view>
						
						<!-- 纹路简要说明 -->
						<view class="line-brief-info" v-if="activeLineType && activeLineData">
							<text class="brief-title">{{ pickTxt(activeLineData.type, activeLineData.typeEn) }} - {{ pickTxt(activeLineData.title, activeLineData.titleEn) }}</text>
							<text class="brief-desc">{{ pickTxt(activeLineData.description, activeLineData.descriptionEn) }}</text>
						</view>
					</view>
					
					<!-- 纹路选择器 -->
					<view class="line-selector">
						<view 
							v-for="(item, index) in reportData.results" 
							:key="index"
							:class="['selector-item', activeLineType === item.type ? 'active' : '']"
							@click="setActiveLine(item.type)"
						>
							<text class="selector-text">{{ pickTxt(item.type, item.typeEn) }}</text>
						</view>
					</view>
				</view>

				<!-- 详细维度分析 -->
				<view class="dimensions-section" v-if="reportData.fullData">
					<view class="section-header">
						<text class="section-title">{{ ui.chapter3 }}</text>
					</view>
					<view class="dimension-card" v-for="key in getOrderedDimensionKeys(reportData.fullData.dimensions)" :key="key">
						<view class="dimension-header">
							<view class="dim-icon-box" :class="key + '-icon'">
								<image class="dim-custom-icon" :src="getDimensionIcon(key)" mode="aspectFit"></image>
							</view>
							<text class="dimension-title">{{ dimTitle(reportData.fullData.dimensions[key]) }}</text>
						</view>
						<text class="dimension-content">{{ dimContent(reportData.fullData.dimensions[key]) }}</text>
					</view>
				</view>

				<!-- 掌部特征 -->
				<view class="features-section" v-if="reportData.fullData && reportData.fullData.palmFeatures">
					<view class="section-header">
						<text class="section-title">{{ ui.chapter4 }}</text>
					</view>
					<view class="features-card">
						<view class="feature-item">
							<text class="feature-label">{{ ui.palmShape }}</text>
							<text class="feature-value">{{ pickTxt(reportData.fullData.palmFeatures.palmShape, reportData.fullData.palmFeatures.palmShapeEn) }}</text>
						</view>
						<view class="feature-item">
							<text class="feature-label">{{ ui.fingerRatio }}</text>
							<text class="feature-value">{{ pickTxt(reportData.fullData.palmFeatures.fingerRatio, reportData.fullData.palmFeatures.fingerRatioEn) }}</text>
						</view>
						<view class="feature-item">
							<text class="feature-label">{{ ui.palmMound }}</text>
							<text class="feature-value">{{ pickTxt(reportData.fullData.palmFeatures.palmMound, reportData.fullData.palmFeatures.palmMoundEn) }}</text>
						</view>
					</view>
				</view>

				<!-- 专家建议 -->
				<view class="suggestions-section" v-if="reportData.fullData && reportData.fullData.suggestions">
					<view class="section-header">
						<text class="section-title">{{ ui.chapter5 }}</text>
					</view>
				<view class="suggestions-card">
					<view class="suggestion-group">
						<view class="suggestion-header">
							<text class="suggestion-dot career-dot"></text>
							<text class="suggestion-type">{{ ui.careerSuggest }}</text>
						</view>
						<text class="suggestion-text">{{ pickTxt(reportData.fullData.suggestions.career, reportData.fullData.suggestions.careerEn) }}</text>
					</view>
					<view class="suggestion-group">
						<view class="suggestion-header">
							<text class="suggestion-dot life-dot"></text>
							<text class="suggestion-type">{{ ui.lifeSuggest }}</text>
						</view>
						<text class="suggestion-text">{{ pickTxt(reportData.fullData.suggestions.life, reportData.fullData.suggestions.lifeEn) }}</text>
					</view>
					<view class="suggestion-footer">
						<text class="tip-icon">💡</text>
						<text class="tip-text">{{ pickTxt(reportData.fullData.suggestions.tip, reportData.fullData.suggestions.tipEn) }}</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 空状态（无数据且不在分析中） -->
		<view class="report-content" v-if="!isAnalyzing && !reportData">
			<view class="analyzing-placeholder">
				<text class="analyzing-text">{{ ui.empty }}</text>
			</view>
		</view>

		<view class="report-footer">
			<button class="footer-btn btn-primary" @click="handleShowWechat">
				<text class="btn-text">{{ ui.download }}</text>
			</button>
			<button class="footer-btn btn-secondary" @click="handleBack">
				<text class="btn-text">{{ ui.backCamera }}</text>
			</button>
		</view>

		<!-- 微信引流弹窗：玄学大师版文案 -->
		<view class="wechat-mask" v-if="showWechatDialog">
			<view class="wechat-dialog">
				<text class="wechat-title">{{ ui.wechatTitle }}</text>
				<image class="wechat-qrcode" src="/static/wechact.jpg" mode="widthFix" />
				<text class="wechat-desc">{{ ui.wechatDesc }}</text>
				<button class="wechat-close-btn" @click="showWechatDialog = false">
					<text class="btn-text">{{ ui.wechatOk }}</text>
				</button>
			</view>
		</view>
		</view>
	</view>
</template>

<script lang="uts">
	import type { PalmistryReport, ReportResult, DimensionDetail, PalmistryAnalysisResult } from '@/types/index';
	import { analyzePalmistry, type DetectedLine } from '@/utils/qwenApi';
	import {
		getAppLocale,
		setAppLocale,
		getReportUi,
		pickLocaleText,
		type AppLocale
	} from '@/utils/locale';
	import { getOrderedDimensionKeys as orderDimensionKeys } from '@/utils/dimensionHelper';

	type Gender = 'male' | 'female';
	type HandSide = 'left' | 'right';

	interface ReportPageData {
		locale: AppLocale;
		imagePath: string | null;
		gender: Gender | null;
		handSide: HandSide | null;
		reportData: PalmistryReport | null;
		isAnalyzing: boolean;
		activeLineType: string | null;
		showWechatDialog: boolean;
	}

	export default {
		name: 'ReportPage',
		data(): ReportPageData {
			return {
				locale: 'en',
				imagePath: null,
				gender: null,
				handSide: null,
				reportData: null,
				isAnalyzing: false,
				activeLineType: null,
				showWechatDialog: false
			};
		},
		computed: {
			ui(): Record<string, string> {
				return getReportUi(this.locale);
			},
			/**
			 * 获取当前选中的纹路数据
			 */
			activeLineData(): ReportResult | null {
				if (!this.activeLineType || !this.reportData) return null;
				return this.reportData.results.find((item: ReportResult): boolean => item.type === this.activeLineType) || null;
			}
		},
		onLoad(options: Record<string, any>) {
			console.log('=== onLoad 被调用 ===');
			console.log('onLoad参数:', options);
			this.locale = getAppLocale();
			this.applyNavTitle();
			this.initPage(options);
		},
		onShow() {
			console.log('=== onShow 被调用 ===');
			// H5平台可能在onLoad时没有参数，在onShow时从URL解析
			// #ifdef H5
			if (!this.imagePath) {
				console.log('onShow: 检测到imagePath为空，尝试从URL解析...');
				this.initPageFromURL();
			}
			// #endif
		},
		mounted() {
			console.log('=== mounted 被调用 ===');
			// H5平台在mounted时也尝试解析参数
			// #ifdef H5
			if (!this.imagePath) {
				console.log('mounted: 检测到imagePath为空，尝试从URL解析...');
				setTimeout(() => {
					this.initPageFromURL();
				}, 100);
			}
			// #endif
		},
		methods: {
			applyNavTitle(): void {
				uni.setNavigationBarTitle({ title: getReportUi(this.locale).headerTitle });
			},
			setLocale(next: AppLocale): void {
				if (this.locale === next) {
					return;
				}
				this.locale = next;
				setAppLocale(next);
				this.applyNavTitle();
			},
			pickTxt(zhText: string, enText?: string | null): string {
				return pickLocaleText(this.locale, zhText, enText);
			},
			dimTitle(dim: DimensionDetail): string {
				return pickLocaleText(this.locale, dim.title, dim.titleEn);
			},
			dimContent(dim: DimensionDetail): string {
				return pickLocaleText(this.locale, dim.content, dim.contentEn);
			},
			/**
			 * 获取维度图标路径
			 */
			getDimensionIcon(key: string): string {
				const icons: Record<string, string> = {
					'handType': '/static/命格.png',
					'palmMounds': '/static/命格.png',
					'specialMarks': '/static/命格.png',
					'career': '/static/事业.png',
					'love': '/static/感情.png',
					'health': '/static/健康.png',
					'wealth': '/static/财富.png',
					'personality': '/static/命格.png',
					'recentLuck': '/static/命格.png'
				};
				return icons[key] || '/static/命格.png';
			},

			getOrderedDimensionKeys(dimensions: Record<string, DimensionDetail> | null | undefined): string[] {
				return orderDimensionKeys(dimensions);
			},

			/**
			 * 从URL解析参数并初始化页面
			 */
			initPageFromURL(): void {
				try {
					if (typeof window !== 'undefined' && window.location) {
						const hash = window.location.hash;
						console.log('当前hash:', hash);
						
						if (hash && hash.includes('?')) {
							const queryString = hash.split('?')[1];
							console.log('查询字符串:', queryString);
							
							const params: Record<string, string> = {};
							queryString.split('&').forEach((pair: string) => {
								const [key, value] = pair.split('=');
								if (key && value) {
									params[decodeURIComponent(key)] = decodeURIComponent(value);
								}
							});
							
							console.log('从URL解析出的参数:', params);
							
							if (params.imagePath) {
								// 直接设置参数并启动分析，避免递归调用
								this.imagePath = decodeURIComponent(params.imagePath);
								this.gender = (params.gender as Gender) || 'male';
								this.handSide = (params.handSide as HandSide) || (this.gender === 'male' ? 'left' : 'right');
								console.log('从URL解析后的参数:', {
									imagePath: this.imagePath ? this.imagePath.substring(0, 50) + '...' : 'null',
									gender: this.gender,
									handSide: this.handSide
								});
								console.log('开始调用startAnalysis...');
								this.startAnalysis();
							} else {
								console.error('从URL中未找到imagePath参数');
							}
						} else {
							console.error('URL中没有查询参数');
						}
					} else {
						console.error('window对象不可用');
					}
				} catch (error) {
					console.error('从URL解析参数失败:', error);
				}
			},

			/**
			 * 初始化页面（统一处理参数解析和启动分析）
			 */
			initPage(options: Record<string, any>): void {
				console.log('=== 初始化页面 ===');
				console.log('initPage参数:', options);
				console.log('参数类型:', typeof options);
				console.log('所有参数键:', Object.keys(options || {}));
				
				// 如果已经有imagePath，说明已经初始化过，避免重复调用
				if (this.imagePath) {
					console.log('页面已经初始化过，跳过');
					return;
				}
				
				let imagePath: string | null = null;
				let gender: Gender = 'male';
				let handSide: HandSide = 'left';
				
				// 1. 优先从URL参数获取（用于兼容其他平台或手动输入URL的情况）
				if (options && options.imagePath) {
					imagePath = decodeURIComponent(options.imagePath);
					gender = (options.gender as Gender) || 'male';
					handSide = (options.handSide as HandSide) || (gender === 'male' ? 'left' : 'right');
					console.log('从URL参数获取成功');
				} 
				// 2. 从全局存储获取（主要方案）
				else {
					try {
						const storageData = uni.getStorageSync('cameraParams');
						console.log('从存储读取的数据:', storageData);
						
						if (storageData && storageData.imagePath) {
							imagePath = storageData.imagePath;
							gender = storageData.gender || 'male';
							handSide = storageData.handSide || (gender === 'male' ? 'left' : 'right');
							console.log('从全局存储获取成功');
							
							// 清除存储，避免重复使用
							uni.removeStorageSync('cameraParams');
							console.log('已清除全局存储');
						}
					} catch (error) {
						console.error('从全局存储读取失败:', error);
					}
				}
				
				if (imagePath) {
					this.imagePath = imagePath;
					this.gender = gender;
					this.handSide = handSide;
					console.log('解析后的参数:', {
						imagePath: this.imagePath.substring(0, 50) + '...',
						gender: this.gender,
						handSide: this.handSide
					});
					console.log('开始调用startAnalysis...');
					this.startAnalysis();
				} else {
					console.error('缺少图片参数');
					uni.showToast({
						title: getReportUi(this.locale).toastNeedImage,
						icon: 'none'
					});
				}
			},

			/**
			 * 开始分析手相
			 */
			async startAnalysis(): Promise<void> {
				if (!this.imagePath || !this.gender) {
					console.error('缺少必要参数:', {
						imagePath: this.imagePath,
						gender: this.gender
					});
					uni.showToast({
						title: getReportUi(this.locale).toastMissingParams,
						icon: 'none'
					});
					return;
				}

				this.isAnalyzing = true;
				console.log('开始手相分析，参数:', {
					imagePath: this.imagePath.substring(0, 50) + '...',
					gender: this.gender
				});

				try {
					console.log('=== 开始调用Qwen API进行手相识别 ===');
					
					uni.showLoading({
						title: getReportUi(this.locale).loadingAnalyzing,
						mask: true
					});
					
					// 调用真实API
					const result = await analyzePalmistry({
						imagePath: this.imagePath,
						gender: this.gender!,
						handSide: this.handSide!,
						locale: this.locale
					});

					console.log('=== API返回结果 ===', result);

					// 将识别结果转换为报告格式
					this.generateReportFromAPI(result);

					uni.hideLoading();
					uni.showToast({
						title: getReportUi(this.locale).toastSuccess,
						icon: 'success'
					});

				} catch (error: any) {
					console.error('=== 手相识别失败 ===', error);
					console.error('错误类型:', typeof error);
					console.error('错误信息:', error.message || error.errMsg || error);
					console.error('错误堆栈:', error.stack);
					
					uni.hideLoading();
					
					let errorMessage = '识别失败，请重试';
					if (error.message) {
						if (error.message.includes('timeout') || error.message.includes('超时')) {
							errorMessage = '识别超时，请检查网络';
						} else if (error.message.includes('API调用失败')) {
							errorMessage = 'API调用失败，请检查网络连接和API配置';
						} else if (error.message.includes('解析')) {
							errorMessage = '解析结果失败，请重试';
						} else {
							errorMessage = error.message;
						}
					} else if (error.errMsg) {
						if (error.errMsg.includes('timeout')) {
							errorMessage = '识别超时，请检查网络';
						} else if (error.errMsg.includes('fail')) {
							errorMessage = '识别失败，请重试';
						}
					}

					console.log('显示错误提示:', errorMessage);
					uni.showToast({
						title: errorMessage,
						icon: 'none',
						duration: 3000
					});

					// 如果API调用失败，使用模拟数据作为fallback
					console.log('API调用失败，使用模拟数据作为fallback');
					this.generateMockReport();

				} finally {
					this.isAnalyzing = false;
					console.log('分析流程结束');
				}
			},

			/**
			 * 从API结果生成报告（支持 summary 新格式与 lines 旧格式）
			 */
			generateReportFromAPI(apiResult: PalmistryAnalysisResult | any): void {
				const now = new Date();
				const year = now.getFullYear();
				const month = this.formatNumber(now.getMonth() + 1);
				const day = this.formatNumber(now.getDate());
				const hours = this.formatNumber(now.getHours());
				const minutes = this.formatNumber(now.getMinutes());
				const timeString = `${year}-${month}-${day} ${hours}:${minutes}`;

				// 新格式：与拍照页一致的 summary（通义千问当前返回）
				if (apiResult.summary != null && apiResult.summary.lifeLine != null) {
					const s = apiResult.summary;
					const results: ReportResult[] = [
						{
							type: '生命线',
							typeEn: 'Life Line',
							title: s.lifeLine.dimension,
							titleEn: s.lifeLine.dimensionEn,
							description: s.lifeLine.brief,
							descriptionEn: s.lifeLine.briefEn,
							score: s.lifeLine.score
						},
						{
							type: '智慧线',
							typeEn: 'Head Line',
							title: s.wisdomLine.dimension,
							titleEn: s.wisdomLine.dimensionEn,
							description: s.wisdomLine.brief,
							descriptionEn: s.wisdomLine.briefEn,
							score: s.wisdomLine.score
						},
						{
							type: '感情线',
							typeEn: 'Heart Line',
							title: s.emotionLine.dimension,
							titleEn: s.emotionLine.dimensionEn,
							description: s.emotionLine.brief,
							descriptionEn: s.emotionLine.briefEn,
							score: s.emotionLine.score
						},
						{
							type: '命运线',
							typeEn: 'Fate Line',
							title: s.fateLine.dimension,
							titleEn: s.fateLine.dimensionEn,
							description: s.fateLine.brief,
							descriptionEn: s.fateLine.briefEn,
							score: s.fateLine.score
						}
					];
					this.reportData = {
						id: `report_${Date.now()}`,
						imagePath: this.imagePath!,
						analyzeTime: timeString,
						results: results,
						fullData: apiResult as PalmistryAnalysisResult
					};
					if (results.length > 0) {
						this.activeLineType = (results[0] as ReportResult).type;
					}
					console.log('报告生成完成', this.reportData);
					return;
				}

				// 旧格式：lines 数组
				if (apiResult.lines != null && Array.isArray(apiResult.lines) && apiResult.lines.length > 0) {
					const results: ReportResult[] = apiResult.lines.map((line: DetectedLine) => {
						let title = '';
						switch (line.type) {
							case 'life':
								title = '健康运势';
								break;
							case 'wisdom':
								title = '智力与思考';
								break;
							case 'emotion':
								title = '情感与关系';
								break;
							default:
								title = '运势分析';
						}
						return {
							type: line.typeName,
							typeEn: line.typeNameEn,
							title: title,
							description: line.description || `${line.typeName}分析结果`,
							descriptionEn: line.descriptionEn,
							score: line.clarity || Math.floor((line.length || 0) / 2),
							points: line.points,
							clarity: line.clarity
						};
					});

					if (apiResult.overall) {
						const overall = apiResult.overall;
						const existingTypes = results.map((r) => r.type);
						if (!existingTypes.includes('生命线') && overall.healthScore) {
							results.unshift({
								type: '生命线',
								typeEn: 'Life Line',
								title: '健康运势',
								description: overall.summary || '生命线分析',
								score: overall.healthScore
							});
						}
						if (!existingTypes.includes('智慧线') && overall.wisdomScore) {
							const wisdomIndex = existingTypes.indexOf('智慧线') === -1 ? 1 : existingTypes.indexOf('智慧线');
							results.splice(wisdomIndex, 0, {
								type: '智慧线',
								typeEn: 'Head Line',
								title: '智力与思考',
								description: overall.summary || '智慧线分析',
								score: overall.wisdomScore
							});
						}
						if (!existingTypes.includes('感情线') && overall.emotionScore) {
							results.push({
								type: '感情线',
								typeEn: 'Heart Line',
								title: '情感与关系',
								description: overall.summary || '感情线分析',
								score: overall.emotionScore
							});
						}
					}

					this.reportData = {
						id: `report_${Date.now()}`,
						imagePath: this.imagePath!,
						analyzeTime: timeString,
						results: results,
						fullData: apiResult
					};
					if (results.length > 0) {
						this.activeLineType = (results[0] as ReportResult).type;
					}
					console.log('报告生成完成', this.reportData);
					return;
				}

				console.warn('API未返回有效结果，使用模拟数据');
				this.generateMockReport();
			},

			/**
			 * 设置当前激活的纹路
			 */
			setActiveLine(type: string): void {
				this.activeLineType = type;
			},

			/**
			 * 格式化数字为两位字符串
			 */
			formatNumber(num: number): string {
				return num < 10 ? `0${num}` : `${num}`;
			},

			/**
			 * 生成模拟报告数据（待替换为真实 API 调用）
			 */
			generateMockReport(): void {
				const now = new Date();
				const year = now.getFullYear();
				const month = this.formatNumber(now.getMonth() + 1);
				const day = this.formatNumber(now.getDate());
				const hours = this.formatNumber(now.getHours());
				const minutes = this.formatNumber(now.getMinutes());
				const timeString = `${year}-${month}-${day} ${hours}:${minutes}`;

				const mockResults: ReportResult[] = [
					{
						type: '生命线',
						typeEn: 'Life Line',
						title: '健康运势',
						titleEn: 'Health',
						description: '生命线较长且清晰，表明身体健康状况良好，有较强的生命力和抵抗力。建议保持良好的作息习惯，适度运动。',
						descriptionEn: 'A long, clear life line suggests vitality and steady habits.',
						score: 85
					},
					{
						type: '智慧线',
						typeEn: 'Head Line',
						title: '智力与思考',
						titleEn: 'Intellect',
						description: '智慧线清晰深邃，显示思维敏捷，学习能力强。在工作和生活中能够灵活应对各种挑战。',
						descriptionEn: 'A deep head line indicates quick thinking and adaptability.',
						score: 90
					},
					{
						type: '感情线',
						typeEn: 'Heart Line',
						title: '情感与关系',
						titleEn: 'Relationships',
						description: '感情线平滑延伸，预示着情感生活相对稳定。在人际关系中表现良好，容易获得他人的信任和好感。',
						descriptionEn: 'A smooth heart line suggests stable emotions and trust from others.',
						score: 80
					}
				];

				this.reportData = {
					id: `report_${Date.now()}`,
					imagePath: this.imagePath!,
					analyzeTime: timeString,
					results: mockResults
				};
				
				// 默认选中生命线
				this.activeLineType = '生命线';

				console.log('报告生成完成', this.reportData);
			},

			/**
			 * 重新分析
			 */
			handleAnalyze(): void {
				if (!this.imagePath) {
					uni.showToast({
						title: '缺少图片',
						icon: 'none'
					});
					return;
				}
				this.startAnalysis();
			},

			/**
			 * 显示微信引流弹窗（下载报告）
			 */
			handleShowWechat(): void {
				this.showWechatDialog = true;
			},

			/**
			 * 返回拍照页
			 */
			handleBack(): void {
				uni.navigateBack({
					success: () => {
						console.log('返回成功');
					},
					fail: (error) => {
						console.error('返回失败', error);
						// 如果返回失败，直接跳转到拍照页
						uni.reLaunch({
							url: '/pages/camera/camera'
						});
					}
				});
			}
		}
	};
</script>

<style>
