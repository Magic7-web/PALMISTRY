	}

	.career-icon { color: #b7a04a; }
	.love-icon { color: #b76e4a; }
	.health-icon { color: #6b8e23; }
	.personality-icon { color: #4a7ab7; }

	.dimension-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #5a3e2b;
	}

	.dimension-content {
		font-size: 28rpx;
		color: #636366;
		line-height: 1.75;
		white-space: pre-line;
	}

	/* 掌部特征样式 */
	.features-section {
		margin-bottom: 30rpx;
	}

	.features-card {
		background-color: #fff;
		background-image: linear-gradient(rgba(232, 224, 204, 0.05) 1rpx, transparent 1rpx);
		background-size: 100% 40rpx;
		border-radius: 12rpx;
