/**
 * 应用类型定义
 */

/**
 * 拍照选项
 */
export interface CameraOptions {
	sourceType?: ('camera' | 'album')[]
	count?: number
	sizeType?: ('original' | 'compressed')[]
}

/**
 * 图片信息
 */
export interface ImageInfo {
	path: string
	width?: number
	height?: number
	size?: number
}

/**
 * 手相分析报告数据
 */
export interface PalmistryReport {
	id: string
	imagePath: string
	analyzeTime: string
	results: ReportResult[]
	/** 当前报告会话 ID，用于本地持久化追问结果 */
	sessionId?: string
	fullData?: PalmistryAnalysisResult // 保存完整的API返回数据，包含详细分析内容
}

/**
 * 线条评分摘要
 */
export interface LineSummary {
	dimension: string;
	score: number;
	brief: string;
	/** 英文：维度名称 */
	dimensionEn?: string;
	/** 英文：简短描述 */
	briefEn?: string;
}

/**
 * 维度详细分析
 */
export interface DimensionDetail {
	title: string;
	content: string;
	/** 英文：标题 */
	titleEn?: string;
	/** 英文：正文 */
	contentEn?: string;
}

/**
 * 线条详细解读
 */
export interface LineDetail {
	type: string;
	typeName: string;
	description: string;
	typeNameEn?: string;
	descriptionEn?: string;
	interpretation: {
		thinking?: string;
		learning?: string;
		decision?: string;
		[key: string]: string | undefined;
	};
}

/**
 * 掌部特征
 */
export interface PalmFeatures {
	palmShape: string;
	fingerRatio: string;
	palmMound: string;
	palmShapeEn?: string;
	fingerRatioEn?: string;
	palmMoundEn?: string;
}

/**
 * 建议内容
 */
export interface Suggestions {
	career: string;
	life: string;
	tip: string;
	careerEn?: string;
	lifeEn?: string;
	tipEn?: string;
}

/**
 * 手相识别结果（新格式）
 */
export interface PalmistryAnalysisResult {
	isInvalid?: boolean;
	errorMsg?: string;
	/** 英文：无效图片时的提示 */
	errorMsgEn?: string;
	summary: {
		lifeLine: LineSummary;
		wisdomLine: LineSummary;
		emotionLine: LineSummary;
		fateLine: LineSummary;
	};
	dimensions: {
		handType: DimensionDetail;
		palmMounds: DimensionDetail;
		specialMarks: DimensionDetail;
		career: DimensionDetail;
		love: DimensionDetail;
		health: DimensionDetail;
		/** 部分模型可能返回财富维度 */
		wealth?: DimensionDetail;
	};
	harshWarning: string;
	overallAnalysis: string;
	/** 英文：致命警示全文 */
	harshWarningEn?: string;
	/** 英文：综合结论 */
	overallAnalysisEn?: string;
	lineDetails: LineDetail[];
	palmFeatures: PalmFeatures;
	suggestions: Suggestions;
}

/**
 * 报告结果项
 */
export interface ReportResult {
	type: string
	title: string
	description: string
	score?: number
	/** 英文线条名，如 Life Line */
	typeEn?: string
	titleEn?: string
	descriptionEn?: string
	points?: Array<{x: number, y: number}> // 线条坐标点（可选）
	clarity?: number // 清晰度 0-100（可选）
}

/**
 * 追问模块
 */
export interface FollowUpModule {
	id: string
	title: string
	titleEn?: string
	description: string
	descriptionEn?: string
	previewText: string
	previewTextEn?: string
	priceUsd: string
	priceCny: string
	prompt: string
	promptEn?: string
}

/**
 * 追问模块分组
 */
export interface FollowUpPack {
	id: string
	title: string
	titleEn?: string
	description: string
	descriptionEn?: string
	priceUsd: string
	priceCny: string
	moduleIds: string[]
}

/**
 * 追问答案
 */
export interface FollowUpAnswerRecord {
	sessionId: string
	moduleId: string
	moduleTitle: string
	question: string
	answer: string
	paymentProvider: string
	orderRef: string
	paidAt: string
}

/**
 * 追问AI返回项
 */
export interface FollowUpReadingResult {
	moduleId: string
	moduleTitle: string
	answer: string
}

/**
 * 当前报告快照
 */
export interface ActiveReportSnapshot {
	sessionId: string
	capturedImage: string
	gender: 'male' | 'female'
	handSide: 'left' | 'right'
	locale: 'zh' | 'en'
	reportData?: PalmistryReport | null
	createdAt: string
}
