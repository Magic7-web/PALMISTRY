DASHSCOPE_API_KEY=your_dashscope_api_key_here
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173,https://your-domain.com

# 支付闭环（诊断版）
PAYMENT_NOTIFY_SECRET=dev-payment-secret
PAYMENT_TEST_MODE=false
# Android 心跳超过此毫秒数视为离线（默认 60000 = 1 分钟，应略大于 App 心跳间隔）
PAYMENT_LISTENER_HEARTBEAT_TTL_MS=60000
# 支付探测：心跳在此毫秒数内视为实时在线（默认 15000，约为 App 10s 心跳的 1.5 倍）
PAYMENT_LISTENER_LIVE_HEARTBEAT_MS=15000
ALIPAY_QR_SINGLE_URL=/static/alipay-qr.png
ALIPAY_QR_BUNDLE_URL=/static/alipay-qr.png
